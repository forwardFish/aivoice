.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  pointer-events: none;
  background: #ffffff;
  border-top: 1rpx solid rgba(17, 23, 45, 0.08);
  box-shadow: 0 -8rpx 24rpx rgba(51, 58, 94, 0.05);
}

.tabbar {
  pointer-events: auto;
  min-height: 116rpx;
  padding: 12rpx 24rpx 8rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.tab-icon-wrap {
  width: 80rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-wrap-voices {
  width: 84rpx;
  height: 62rpx;
}

.tab-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.74;
}

.tab-icon.selected {
  width: 62rpx;
  height: 62rpx;
  opacity: 1;
}

.tab-icon-voices {
  width: 65rpx;
  height: 48rpx;
}

.tab-icon.selected.tab-icon-voices {
  width: 72rpx;
  height: 54rpx;
}

.tab-label {
  color: #8b91a6;
  font-size: 22rpx;
  line-height: 1.15;
}

.tab-label.active {
  color: #6552f5;
  font-weight: 650;
}
