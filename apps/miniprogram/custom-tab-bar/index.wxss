.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 0 34rpx;
  pointer-events: none;
}

.tabbar {
  pointer-events: auto;
  min-height: 112rpx;
  padding: 16rpx 18rpx 10rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 36rpx;
  box-shadow:
    0 18rpx 54rpx rgba(65, 72, 112, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(24rpx);
}

.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-wrap.active {
  background: rgba(101, 82, 245, 0.08);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.74;
}

.tab-icon.selected {
  width: 48rpx;
  height: 48rpx;
  opacity: 1;
}

.tab-label {
  color: #8b91a6;
  font-size: 22rpx;
  line-height: 1.35;
}

.tab-label.active {
  color: #6552f5;
  font-weight: 650;
}
