<view class="tabbar-shell">
  <view class="tabbar safe-bottom">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{item.iconRole === 'voices' ? 'tab-item-voices' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap {{item.iconRole === 'voices' ? 'tab-icon-wrap-voices' : ''}}">
        <image class="tab-icon {{selected === index ? 'selected' : ''}} {{item.iconRole === 'voices' ? 'tab-icon-voices' : ''}}" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit"></image>
      </view>
      <text class="tab-label {{selected === index ? 'active' : ''}}">{{item.text}}</text>
    </view>
  </view>
</view>
