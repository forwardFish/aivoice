.workbench { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }
.mode-entry { background: radial-gradient(circle at 78% 25%, rgba(201,190,255,.28), transparent 31%), radial-gradient(circle at 9% 73%, rgba(255,226,213,.22), transparent 30%); }
.workbench-state { min-height: 78vh; }

.mode-chooser { min-height: calc(100vh - 120rpx); padding: 128rpx 92rpx calc(160rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; }
.mode-heading { text-align: center; }
.mode-title { display: block; color: #11172d; font-size: 44rpx; line-height: 1.35; font-weight: 750; letter-spacing: .8rpx; }
.mode-subtitle { display: block; margin-top: 16rpx; color: #7b8299; font-size: 26rpx; }
.mode-cards { margin-top: 92rpx; display: flex; flex-direction: column; gap: 52rpx; }
.mode-card { min-height: 332rpx; padding: 56rpx 40rpx 52rpx 58rpx; border-radius: 38rpx; position: relative; overflow: hidden; }
.mode-card::after { content: ''; width: 280rpx; height: 280rpx; position: absolute; right: -58rpx; top: -40rpx; border-radius: 50%; background: radial-gradient(circle, rgba(164,139,255,.24), rgba(164,139,255,0)); }
.mode-exact { background: radial-gradient(circle at 15% 90%, rgba(255,221,203,.30), transparent 44%), radial-gradient(circle at 87% 12%, rgba(197,188,255,.32), transparent 44%), rgba(255,255,255,.86); }
.mode-copy { width: 58%; position: relative; z-index: 3; }
.mode-card-title { display: block; color: #6552f5; font-size: 43rpx; font-weight: 750; }
.mode-card-title.exact-title { color: #ff6846; }
.mode-card-line { display: block; margin-top: 22rpx; color: #6d748b; font-size: 28rpx; line-height: 1.35; }
.mode-card-line + .mode-card-line { margin-top: 14rpx; }
.mode-card-icon { width: 182rpx; height: 182rpx; position: absolute; z-index: 2; right: 56rpx; top: 75rpx; opacity: 1; }
.mode-exact .mode-card-icon { width: 176rpx; height: 176rpx; right: 58rpx; top: 78rpx; }
.mode-card-image { display: block; }

.mode-footer-note { margin-top: auto; padding-top: 28rpx; display: flex; align-items: center; justify-content: center; gap: 11rpx; color: #8a90a6; font-size: 23rpx; text-align: center; }
.note-spark { width: 9rpx; height: 9rpx; border-radius: 50%; background: linear-gradient(135deg,#7a67f5,#ef8b70); box-shadow: 0 0 13rpx rgba(114,93,244,.42); }

.workbench-body { min-height: calc(100vh - 120rpx); padding: 6rpx 30rpx 0; display: flex; flex-direction: column; }
.workbench-summary { padding-top: 2rpx; }
.workbench-balance { display:block; margin:0 0 18rpx; color:#8a90a4; font-size:24rpx; text-align:center; }
.voice-banner { min-height: 116rpx; padding: 17rpx 20rpx; border-radius: 31rpx; display: flex; align-items: center; gap: 16rpx; }
.voice-avatar { flex: 0 0 auto; width: 76rpx; height: 76rpx; border-radius: 50%; border: 3rpx solid rgba(255,255,255,.92); box-shadow: 0 9rpx 23rpx rgba(60,64,98,.12); background: #eceaff; }
.voice-avatar.fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg,#ece9ff,#dcd8f9); }
.avatar-wave { display: flex; align-items: center; gap: 4rpx; }
.avatar-wave text { width: 5rpx; border-radius: 999rpx; background: #6d5ce7; }
.avatar-wave text:nth-child(1), .avatar-wave text:nth-child(3) { height: 20rpx; }
.avatar-wave text:nth-child(2) { height: 36rpx; }
.voice-banner-copy { flex: 1; min-width: 0; }
.voice-name { display: block; overflow: hidden; color: #121830; font-size: 28rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.voice-status-row { margin-top: 8rpx; display: flex; align-items: center; gap: 8rpx; color: #7c849a; font-size: 20rpx; }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #61c689; box-shadow: 0 0 10rpx rgba(97,198,137,.50); }
.point-pill { flex: 0 0 auto; min-width: 99rpx; height: 68rpx; padding: 0 14rpx; border-radius: 21rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(145deg,#efedff,#fff); border: 1rpx solid rgba(221,216,255,.90); }
.point-number { color: #6552f5; font-size: 27rpx; line-height: 1; font-weight: 760; }
.point-unit { margin-top: 5rpx; color: #8a8fa4; font-size: 15rpx; }

.mode-tabs { height: 70rpx; margin-top: 15rpx; padding: 6rpx; border-radius: 23rpx; display: flex; }
.mode-tab { flex: 1; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #7e859b; font-size: 22rpx; font-weight: 620; }
.mode-tab.active { color: #6452f5; background: linear-gradient(145deg,#f0edff,#fff); box-shadow: 0 7rpx 19rpx rgba(101,82,245,.12); }
.mode-tab.exact-active { color: #eb6c50; background: linear-gradient(145deg,#fff0eb,#fff); }
.change-mode { align-self: flex-end; height: 42rpx; margin: 4rpx 2rpx 0; padding: 0 7rpx; color: #9297a9; background: transparent; font-size: 17rpx; }
.message-list { flex: 1; height: calc(100vh - 318rpx); margin-top: 6rpx; }
.chat-intro { margin: 17rpx 16rpx; padding: 27rpx 25rpx; border-radius: 28rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.intro-mode-image { width:104rpx; height:104rpx; }
.intro-title { margin-top: 14rpx; color: #171d35; font-size: 26rpx; font-weight: 680; }
.intro-copy { max-width: 520rpx; margin-top: 11rpx; color: #858ba1; font-size: 20rpx; line-height: 1.6; }
.quick-prompts { width: 100%; margin-top: 18rpx; display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; }
.quick-prompts button { height: 55rpx; padding: 0 16rpx; border-radius: 18rpx; color: #6658df; background: #efedff; font-size: 18rpx; }

.message-row { margin-bottom: 26rpx; display: flex; align-items: flex-start; gap: 16rpx; }
.message-row.is-user { justify-content: flex-end; }
.message-avatar { flex: 0 0 auto; width: 76rpx; height: 76rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#8b79f5,#5f7bd9); font-size: 26rpx; font-weight: 700; border: 3rpx solid rgba(255,255,255,.92); box-shadow: 0 12rpx 28rpx rgba(71,72,115,.16); }
.message-bubble { max-width: 80%; padding: 24rpx 26rpx 22rpx; border-radius: 26rpx; }
.bubble-user { color: #6552f5; background: linear-gradient(145deg,#f2edff,#ebe8ff); border: 1rpx solid rgba(223,217,255,.96); border-bottom-right-radius: 10rpx; box-shadow: 0 16rpx 36rpx rgba(101,82,245,.14); }
.bubble-assistant { color: #22283e; background: rgba(255,255,255,.96); border: 1rpx solid rgba(239,239,247,.96); border-bottom-left-radius: 10rpx; box-shadow: 0 14rpx 34rpx rgba(58,63,92,.09); }
.ai-tag-row { margin-bottom: 10rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.ai-tag { padding: 5rpx 10rpx; border-radius: 999rpx; color: #6757e8; background: #efedff; font-size: 17rpx; font-weight: 650; }
.message-status { color: #9a9fb0; font-size: 17rpx; }
.message-text { display: block; font-size: 26rpx; line-height: 1.72; font-weight: 520; word-break: break-all; }
.message-error,
.inline-error { display: block; margin-top: 10rpx; color: #d95d66; font-size: 19rpx; line-height: 1.5; }
.pending-bubble { display: flex; align-items: center; gap: 12rpx; color: #7f869c; }
.typing { display: flex; gap: 5rpx; }
.typing text { width: 7rpx; height: 7rpx; border-radius: 50%; background: #7d6af0; animation: typing 1.1s ease-in-out infinite; }
.typing text:nth-child(2) { animation-delay: .16s; }
.typing text:nth-child(3) { animation-delay: .32s; }
.scroll-spacer { height: 24rpx; }

.chat-inline-error { margin: 0 10rpx 6rpx; }
.chat-dock { margin: 12rpx 0 0; padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius: 48rpx 48rpx 0 0; display: flex; align-items: center; gap: 18rpx; box-shadow: 0 -18rpx 48rpx rgba(65,70,110,.12), 0 26rpx 64rpx rgba(65,70,110,.10), inset 0 1rpx 0 rgba(255,255,255,.96); }
.dock-side-button { flex: 0 0 auto; width: 86rpx; height: 86rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #2c3142; background: rgba(255,255,255,.96); border: 1rpx solid rgba(233,233,243,.95); box-shadow: 0 10rpx 26rpx rgba(66,71,105,.10); font-size: 36rpx; }
.dock-side-button::after { border: none; }
.dock-emoji-button { font-size: 32rpx; }
.chat-input-pill { flex: 1; min-width: 0; min-height: 88rpx; padding: 0 26rpx; border-radius: 999rpx; display: flex; align-items: center; background: linear-gradient(145deg,#efecff,#f6f5ff); border: 1rpx solid rgba(233,228,255,.92); }
.chat-input { width: 100%; min-height: 44rpx; max-height: 132rpx; padding: 21rpx 0 17rpx; color: #171d33; background: transparent; font-size: 26rpx; line-height: 1.45; }
.dock-send-button { background: linear-gradient(135deg,#ffffff,#fbfaff); }
.dock-send-glyph { color: #1f2331; font-size: 33rpx; line-height: 1; }
.dock-send-image { width: 52rpx; height: 52rpx; }
.dock-send-button[disabled] { opacity: .48; box-shadow: none; }

.exact-workspace { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.exact-prompt-label { display: block; margin: 10rpx 2rpx 16rpx; color: #80889f; font-size: 21rpx; }
.exact-primary-card { position: relative; padding: 0; border-radius: 31rpx; overflow: hidden; }
.exact-textarea { width: 100%; min-height: 360rpx; padding: 30rpx 26rpx 70rpx; color: #171d33; background: linear-gradient(145deg,rgba(255,255,255,.94),rgba(248,246,255,.88)); font-size: 29rpx; line-height: 1.62; }
.exact-count { position: absolute; right: 22rpx; bottom: 22rpx; color: #969bad; font-size: 21rpx; }
.exact-inline-error { margin: 0 18rpx 16rpx; padding: 11rpx 14rpx; border-radius: 16rpx; background: #fff0f1; }
.exact-generate { width:100%; min-height: 100rpx; margin-top: 28rpx; border-radius: 33rpx; font-size:32rpx; }

.result-heading { margin: 24rpx 5rpx 12rpx; display: flex; align-items: center; justify-content: space-between; }
.result-heading .section-title { font-size: 27rpx; }
.exact-history-scroll { flex: 1; min-height: 150rpx; height: calc(100vh - 630rpx); }
.pending-result { min-height: 76rpx; padding: 17rpx 21rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 14rpx; color: #7e859b; font-size: 20rpx; }
.exact-empty { padding: 25rpx; border-radius: 27rpx; display: flex; flex-direction: column; align-items: center; text-align: center; color: #8d92a5; font-size: 19rpx; }
.exact-empty .inline-wave { width: 125rpx; height: 57rpx; opacity: .43; }
.empty-result-title { margin: 9rpx 0 6rpx; color: #232a41; font-size: 22rpx; font-weight: 680; }
.result-list { display: flex; flex-direction: column; gap: 12rpx; }
.result-card { padding: 18rpx 18rpx 16rpx; border-radius: 24rpx; }
.result-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.result-text { flex: 1; color: #22283e; font-size: 22rpx; line-height: 1.5; }
.exact-history-spacer { height: 30rpx; }
.exact-footer-note { margin: 18rpx 0 calc(10rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; gap: 11rpx; color: #9a9fb2; font-size: 18rpx; text-align: center; }

@media (max-height: 740px) {
  .mode-chooser { padding: 30rpx 60rpx calc(64rpx + env(safe-area-inset-bottom)); }
  .mode-title { font-size: 40rpx; }
  .mode-subtitle { font-size: 24rpx; }
  .mode-cards { margin-top: 30rpx; gap: 20rpx; }
  .mode-card { min-height: 252rpx; padding: 32rpx 30rpx 28rpx 40rpx; }
  .mode-card-title { font-size: 36rpx; }
  .mode-card-line { font-size: 23rpx; margin-top: 14rpx; }
  .mode-card-icon { width: 158rpx; height: 158rpx; right: 36rpx; top: 47rpx; }
  .mode-exact .mode-card-icon { width: 152rpx; height: 152rpx; top: 50rpx; }
  .mode-footer-note { padding-top: 18rpx; }

  .workbench-body { padding-top: 5rpx; }
  .workbench-balance { margin-bottom:12rpx; font-size:22rpx; }
  .voice-banner { min-height: 96rpx; padding: 12rpx 16rpx; }
  .voice-avatar { width: 63rpx; height: 63rpx; }
  .mode-tabs { margin-top: 10rpx; }
  .change-mode { height: 34rpx; }
  .exact-prompt-label { margin-top: 4rpx; margin-bottom: 10rpx; }
  .exact-textarea { min-height: 250rpx; padding-bottom: 56rpx; }
  .exact-generate { min-height: 74rpx; margin-top: 10rpx; }
  .result-heading { margin-top: 12rpx; }
  .exact-history-scroll { height: calc(100vh - 530rpx); }
}

@keyframes typing { 0%,100% { transform: translateY(0); opacity: .45; } 50% { transform: translateY(-5rpx); opacity: 1; } }
