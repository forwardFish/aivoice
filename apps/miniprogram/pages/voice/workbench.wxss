.workbench-screen {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 4%, rgba(162, 194, 255, 0.22), transparent 32%),
    radial-gradient(circle at 88% 8%, rgba(210, 191, 255, 0.2), transparent 28%),
    radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0) 38%),
    linear-gradient(180deg, #f5f7ff 0%, #f8f8ff 38%, #fbfbfe 100%);
}

.workbench-state {
  margin: 30rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.workbench-content {
  min-height: calc(100vh - 140rpx);
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.mode-chooser {
  padding: 48rpx 38rpx calc(60rpx + env(safe-area-inset-bottom));
}

.chooser-title {
  display: block;
  font-size: 45rpx;
  line-height: 1.3;
  font-weight: 750;
  color: #11172d;
  text-align: center;
}

.chooser-subtitle {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #737b94;
}

.mode-card {
  min-height: 260rpx;
  margin-top: 42rpx;
  padding: 38rpx 32rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 22rpx 56rpx rgba(47, 53, 88, 0.10);
}

.chat-mode {
  background: linear-gradient(135deg, #ffffff, #edeaff);
}

.exact-mode {
  background: linear-gradient(135deg, #fff8f4, #f0eeff);
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title {
  display: block;
  font-size: 39rpx;
  font-weight: 750;
  color: #6552f5;
}

.mode-title.warm {
  color: #ef694e;
}

.mode-description {
  display: block;
  max-width: 390rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #616980;
}

.chat-visual {
  flex: 0 0 auto;
  width: 154rpx;
  height: 120rpx;
  border-radius: 58rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #9f8aff, #6552f5);
  box-shadow: 0 20rpx 42rpx rgba(101, 82, 245, 0.24);
}

.chat-visual::after {
  content: '';
  position: absolute;
  right: 22rpx;
  bottom: -18rpx;
  width: 34rpx;
  height: 34rpx;
  background: #6552f5;
  transform: rotate(45deg);
  border-radius: 6rpx;
}

.chat-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffffff;
}

.mic-visual {
  flex: 0 0 auto;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 25%, #ffffff, #e4dfff 60%, #8b78f6);
  box-shadow: 0 20rpx 46rpx rgba(101, 82, 245, 0.20);
}

.mic-core {
  width: 40rpx;
  height: 70rpx;
  border-radius: 24rpx;
  background: #ffffff;
  position: relative;
}

.mic-core::after {
  content: '';
  position: absolute;
  left: -14rpx;
  bottom: -15rpx;
  width: 58rpx;
  height: 35rpx;
  border: 6rpx solid #ffffff;
  border-top: 0;
  border-radius: 0 0 36rpx 36rpx;
}

.chooser-note {
  display: block;
  margin-top: 38rpx;
  text-align: center;
  color: #858ca2;
  font-size: 22rpx;
}

.segment-control {
  width: 540rpx;
  max-width: calc(100% - 104rpx);
  margin: 16rpx auto 0;
  padding: 7rpx;
  border-radius: 23rpx;
  display: flex;
  background: linear-gradient(135deg, rgba(236, 238, 249, 0.94), rgba(231, 232, 243, 0.84));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.segment-item {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #737b94;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.segment-item.active {
  color: #6552f5;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(47, 53, 88, 0.09);
}

.segment-item.active.warm {
  color: #ed6a4f;
}

.ai-notice {
  margin: 30rpx 42rpx 0;
  padding: 0 22rpx;
  color: #8890a7;
  background: transparent;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.58;
}

.messages-scroll {
  height: calc(100vh - 694rpx - env(safe-area-inset-bottom));
  padding: 24rpx 30rpx 0;
  box-sizing: border-box;
}

.chat-empty {
  min-height: calc(100vh - 760rpx);
  padding: 34rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  justify-content: flex-start;
}

.assistant-avatar-shell {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assistant-avatar,
.message-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 650;
  background: linear-gradient(135deg, #8b7bf6, #657edb);
}

.assistant-avatar {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  font-size: 66rpx;
  box-shadow:
    0 24rpx 56rpx rgba(101, 82, 245, 0.22),
    inset 0 4rpx 14rpx rgba(255, 255, 255, 0.34);
}

.assistant-avatar::before,
.assistant-avatar::after {
  content: '';
  position: absolute;
  inset: -16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(135, 113, 245, 0.1);
}

.assistant-avatar::after {
  inset: -30rpx;
  border-color: rgba(135, 113, 245, 0.06);
}

.empty-title {
  margin-top: 44rpx;
  font-size: 62rpx;
  line-height: 1.12;
  font-weight: 760;
  color: #11172d;
  letter-spacing: -1.4rpx;
}

.empty-copy {
  max-width: 600rpx;
  margin-top: 20rpx;
  font-size: 29rpx;
  line-height: 1.62;
  color: #737b94;
}

.quick-prompts {
  width: 100%;
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.quick-prompt-button {
  width: 432rpx;
  max-width: 100%;
  min-height: 82rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: #6552f5;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(225, 219, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(80, 84, 126, 0.06);
  font-size: 28rpx;
  font-weight: 650;
}

.quick-prompt-button::after { border: none; }

.message-row {
  width: 100%;
  margin: 20rpx 0 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.user-row {
  justify-content: flex-end;
}

.message-stack {
  max-width: 78%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.assistant-stack {
  align-items: flex-start;
  max-width: 55%;
}

.user-stack {
  align-items: flex-end;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(52, 58, 92, 0.10);
}

.assistant-message-avatar {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(145deg, #7d73fb, #5f8cf5);
}

.user-message-avatar {
  background: rgba(242, 243, 252, 0.92);
}

.message-bubble {
  width: fit-content;
  max-width: 100%;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(48, 54, 88, 0.07);
}

.user-bubble {
  color: #ffffff;
  background: linear-gradient(135deg, #7264f9 0%, #644df4 100%);
  border-color: rgba(121, 102, 249, 0.26);
  border-bottom-right-radius: 10rpx;
  box-shadow: 0 14rpx 28rpx rgba(101, 82, 245, 0.20);
}

.assistant-bubble {
  color: #20263a;
  background: rgba(255, 255, 255, 0.92);
  border-bottom-left-radius: 10rpx;
}

.message-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.58;
  word-break: break-all;
}

.message-audio {
  display: block;
  width: 210rpx;
  min-width: 210rpx;
  max-width: 220rpx;
  margin-top: 14rpx;
}

.message-tag {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8a90a5;
}

.message-time {
  margin-top: 8rpx;
  padding-right: 6rpx;
  color: #8a90a5;
  font-size: 16rpx;
  line-height: 1.2;
  text-align: right;
}

.pending-user-row { margin-bottom:12rpx; }

.typing-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.typing-wave-bar {
  width: 7rpx;
  border-radius: 999rpx;
  background: #6552f5;
  animation: typing-wave 0.8s ease-in-out infinite alternate;
}
.wave-one { height: 18rpx; animation-delay: -0.3s; }
.wave-two { height: 34rpx; animation-delay: -0.2s; }
.wave-three { height: 26rpx; animation-delay: -0.1s; }
.wave-four { height: 42rpx; }

.scroll-spacer {
  height: 180rpx;
}

.chat-composer-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 29;
}

.chat-composer {
  position: relative;
  z-index: 30;
  min-height: 102rpx;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 40rpx rgba(47, 53, 88, 0.12);
}

.composer-leading {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6552f5;
  background: rgba(242, 239, 255, 0.98);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.composer-leading-icon {
  width: 30rpx;
  height: 30rpx;
}

.composer-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  padding: 18rpx 18rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(244, 245, 250, 0.92);
  color: #11172d;
  font-size: 26rpx;
  line-height: 36rpx;
}

.send-button {
  flex: 0 0 200rpx;
  width: 200rpx !important;
  min-width: 200rpx;
  min-height: 80rpx;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6552f5, #8d68f6);
  font-size: 28rpx;
  font-weight: 680;
}

.send-button.disabled { opacity: 0.58; }
.send-button::after { border: none; }

.exact-panel {
  padding: 12rpx 30rpx calc(58rpx + env(safe-area-inset-bottom));
}

.exact-label {
  display: block;
  margin: 24rpx 4rpx 16rpx;
  font-size: 33rpx;
  font-weight: 650;
  color: #11172d;
}

.exact-input-card {
  position: relative;
  padding: 10rpx;
}

.exact-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 26rpx 26rpx 62rpx;
  color: #11172d;
  font-size: 34rpx;
  line-height: 1.72;
}

.char-count {
  position: absolute;
  right: 26rpx;
  bottom: 20rpx;
  color: #858ca2;
  font-size: 28rpx;
}

.exact-helper {
  display: block;
  margin: 18rpx 6rpx 0;
  color: #8c93a8;
  font-size: 24rpx;
  line-height: 1.55;
}

.generate-button {
  margin-top: 20rpx;
  width: 100%;
  min-height: 94rpx;
}

.inline-error,
.chat-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 25rpx;
  line-height: 1.55;
}

.chat-error {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 35;
}

.results-heading {
  margin: 44rpx 4rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pending-result,
.exact-empty,
.result-card {
  padding: 24rpx;
}

.pending-result {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #6552f5;
  font-size: 26rpx;
}

.results-heading .section-caption { font-size: 25rpx; }

.exact-empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: center;
  color: #737b94;
  font-size: 25rpx;
}

.exact-empty-title {
  color: #11172d;
  font-size: 30rpx;
  font-weight: 650;
}

.exact-empty-copy {
  color: inherit;
  font-size: inherit;
  line-height: 1.55;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-text {
  display: block;
  margin-bottom: 18rpx;
  font-size: 31rpx;
  line-height: 1.64;
  color: #11172d;
}

@keyframes typing-wave {
  from { transform: scaleY(0.6); opacity: 0.55; }
  to { transform: scaleY(1.1); opacity: 1; }
}

@media (max-height: 740px) {
  .workbench-content {
    padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
  }

  .segment-control {
    margin-top: 8rpx;
  }

  .segment-item {
    height: 74rpx;
    font-size: 28rpx;
  }

  .ai-notice {
    margin-top: 24rpx;
    font-size: 25rpx;
  }

  .messages-scroll {
    height: calc(100vh - 630rpx - env(safe-area-inset-bottom));
    padding-top: 14rpx;
  }

  .chat-empty {
    min-height: calc(100vh - 710rpx);
    padding-top: 18rpx;
  }

  .assistant-avatar {
    width: 140rpx;
    height: 140rpx;
    font-size: 58rpx;
  }

  .empty-title {
    margin-top: 34rpx;
    font-size: 54rpx;
  }

  .empty-copy {
    margin-top: 16rpx;
    font-size: 27rpx;
  }

  .quick-prompts {
    margin-top: 30rpx;
    gap: 16rpx;
  }

  .quick-prompt-button {
    width: 404rpx;
    min-height: 76rpx;
  }
}
