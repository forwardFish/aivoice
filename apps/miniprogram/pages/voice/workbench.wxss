.workbench-screen {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 3%, rgba(130, 164, 255, 0.13), transparent 30%),
    radial-gradient(circle at 88% 8%, rgba(165, 127, 255, 0.14), transparent 32%),
    #f7f8ff;
}

.workbench-state {
  margin: 30rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.workbench-content {
  min-height: calc(100vh - 140rpx);
}

.mode-chooser {
  padding: 48rpx 38rpx calc(60rpx + env(safe-area-inset-bottom));
}

.chooser-title {
  display: block;
  font-size: 45rpx;
  line-height: 1.3;
  font-weight: 750;
  color: #11172d;
  text-align: center;
}

.chooser-subtitle {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #737b94;
}

.mode-card {
  min-height: 260rpx;
  margin-top: 42rpx;
  padding: 38rpx 32rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 22rpx 56rpx rgba(47, 53, 88, 0.10);
}

.chat-mode {
  background: linear-gradient(135deg, #ffffff, #edeaff);
}

.exact-mode {
  background: linear-gradient(135deg, #fff8f4, #f0eeff);
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title {
  display: block;
  font-size: 39rpx;
  font-weight: 750;
  color: #6552f5;
}

.mode-title.warm {
  color: #ef694e;
}

.mode-description {
  display: block;
  max-width: 390rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #616980;
}

.chat-visual {
  flex: 0 0 auto;
  width: 154rpx;
  height: 120rpx;
  border-radius: 58rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #9f8aff, #6552f5);
  box-shadow: 0 20rpx 42rpx rgba(101, 82, 245, 0.24);
}

.chat-visual::after {
  content: '';
  position: absolute;
  right: 22rpx;
  bottom: -18rpx;
  width: 34rpx;
  height: 34rpx;
  background: #6552f5;
  transform: rotate(45deg);
  border-radius: 6rpx;
}

.chat-visual text {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ffffff;
}

.mic-visual {
  flex: 0 0 auto;
  width: 142rpx;
  height: 142rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 25%, #ffffff, #e4dfff 60%, #8b78f6);
  box-shadow: 0 20rpx 46rpx rgba(101, 82, 245, 0.20);
}

.mic-core {
  width: 40rpx;
  height: 70rpx;
  border-radius: 24rpx;
  background: #ffffff;
  position: relative;
}

.mic-core::after {
  content: '';
  position: absolute;
  left: -14rpx;
  bottom: -15rpx;
  width: 58rpx;
  height: 35rpx;
  border: 6rpx solid #ffffff;
  border-top: 0;
  border-radius: 0 0 36rpx 36rpx;
}

.chooser-note {
  display: block;
  margin-top: 38rpx;
  text-align: center;
  color: #858ca2;
  font-size: 22rpx;
}

.workbench-header {
  padding: 16rpx 42rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-pill,
.change-mode {
  min-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.quota-pill {
  color: #6552f5;
  background: rgba(239, 237, 255, 0.82);
}

.change-mode {
  color: #6552f5;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(218, 214, 247, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(48, 54, 88, 0.05);
}

.change-mode::after { border: none; }

.segment-control {
  margin: 4rpx 42rpx 18rpx;
  padding: 7rpx;
  border-radius: 24rpx;
  display: flex;
  background: rgba(231, 231, 244, 0.76);
}

.segment-item {
  flex: 1;
  height: 64rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #737b94;
  font-size: 25rpx;
  font-weight: 600;
}

.segment-item.active {
  color: #6552f5;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(47, 53, 88, 0.07);
}

.segment-item.active.warm {
  color: #ed6a4f;
}

.ai-notice {
  margin: 0 42rpx 14rpx;
  padding: 4rpx 10rpx;
  color: #9298aa;
  background: transparent;
  text-align: center;
  font-size: 19rpx;
}

.messages-scroll {
  height: calc(100vh - 428rpx - env(safe-area-inset-bottom));
  padding: 6rpx 34rpx 0;
}

.chat-empty {
  padding: 78rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.assistant-avatar,
.message-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 650;
  background: linear-gradient(135deg, #8b7bf6, #657edb);
}

.assistant-avatar {
  width: 112rpx;
  height: 112rpx;
  font-size: 42rpx;
  box-shadow: 0 18rpx 40rpx rgba(101, 82, 245, 0.20);
}

.empty-title {
  margin-top: 24rpx;
  font-size: 33rpx;
  font-weight: 700;
  color: #11172d;
}

.empty-copy {
  max-width: 560rpx;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #737b94;
}

.quick-prompts {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.quick-prompts button {
  min-height: 66rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #6552f5;
  background: #ffffff;
  border: 1rpx solid #e2dfff;
  font-size: 23rpx;
}

.quick-prompts button::after { border: none; }

.message-row {
  width: 100%;
  margin: 30rpx 0 38rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.user-row {
  justify-content: flex-end;
}

.message-stack {
  max-width: 80%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.assistant-stack {
  align-items: flex-start;
}

.user-stack {
  align-items: flex-end;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(52, 58, 92, 0.10);
}

.message-bubble {
  width: fit-content;
  max-width: 100%;
  padding: 25rpx 27rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(48, 54, 88, 0.07);
}

.user-bubble {
  color: #4f45d5;
  background: linear-gradient(135deg, rgba(235, 232, 255, 0.94), rgba(246, 244, 255, 0.9));
  border-color: rgba(225, 220, 255, 0.9);
  border-bottom-right-radius: 10rpx;
}

.assistant-bubble {
  color: #20263a;
  background: rgba(255, 255, 255, 0.92);
  border-bottom-left-radius: 10rpx;
}

.message-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.62;
  word-break: break-all;
}

.message-audio {
  display: block;
  min-width: 430rpx;
  margin-top: 18rpx;
}

.message-tag {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #8a90a5;
}

.reply-feedback {
  height: 52rpx;
  margin-top: 8rpx;
  padding-left: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.reply-feedback-button {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.reply-feedback-button.selected {
  background: rgba(239, 237, 255, 0.94);
}

.reply-feedback-button:active {
  background: rgba(239, 237, 255, 0.72);
}

.reply-feedback-icon {
  width: 28rpx;
  height: 28rpx;
}

.pending-user-copy {
  display: block;
  margin-bottom: 14rpx;
  color: #737b94;
  font-size: 23rpx;
}

.typing-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.typing-wave text {
  width: 7rpx;
  border-radius: 999rpx;
  background: #6552f5;
  animation: typing-wave 0.8s ease-in-out infinite alternate;
}
.typing-wave text:nth-child(1) { height: 18rpx; animation-delay: -0.3s; }
.typing-wave text:nth-child(2) { height: 34rpx; animation-delay: -0.2s; }
.typing-wave text:nth-child(3) { height: 26rpx; animation-delay: -0.1s; }
.typing-wave text:nth-child(4) { height: 42rpx; }

.scroll-spacer {
  height: 210rpx;
}

.chat-composer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 30;
  padding: 14rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(47, 53, 88, 0.12);
}

.composer-input {
  flex: 1;
  min-height: 74rpx;
  max-height: 180rpx;
  padding: 17rpx 22rpx;
  border-radius: 25rpx;
  background: rgba(244, 245, 250, 0.92);
  color: #11172d;
  font-size: 26rpx;
  line-height: 1.5;
}

.send-button {
  flex: 0 0 auto;
  width: auto;
  min-width: 112rpx;
  min-height: 74rpx;
  height: 74rpx;
  padding: 0 22rpx;
  border-radius: 25rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6552f5, #8d68f6);
  font-size: 25rpx;
  font-weight: 650;
}

.send-button.disabled { opacity: 0.58; }
.send-button::after { border: none; }

.exact-panel {
  padding: 12rpx 30rpx calc(50rpx + env(safe-area-inset-bottom));
}

.exact-label {
  display: block;
  margin: 24rpx 4rpx 16rpx;
  font-size: 29rpx;
  font-weight: 650;
  color: #11172d;
}

.exact-input-card {
  position: relative;
  padding: 8rpx;
}

.exact-textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 24rpx 24rpx 58rpx;
  color: #11172d;
  font-size: 28rpx;
  line-height: 1.65;
}

.char-count {
  position: absolute;
  right: 26rpx;
  bottom: 20rpx;
  color: #858ca2;
  font-size: 23rpx;
}

.generate-button {
  margin-top: 24rpx;
}

.inline-error,
.chat-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 23rpx;
  line-height: 1.55;
}

.chat-error {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 35;
}

.results-heading {
  margin: 42rpx 2rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pending-result,
.exact-empty,
.result-card {
  padding: 24rpx;
}

.pending-result {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #6552f5;
  font-size: 24rpx;
}

.exact-empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: center;
  color: #737b94;
  font-size: 23rpx;
}

.exact-empty text:first-child {
  color: #11172d;
  font-size: 28rpx;
  font-weight: 650;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-text {
  display: block;
  margin-bottom: 18rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #11172d;
}

@keyframes typing-wave {
  from { transform: scaleY(0.6); opacity: 0.55; }
  to { transform: scaleY(1.1); opacity: 1; }
}
