.workbench-screen {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 4%, rgba(162, 194, 255, 0.22), transparent 32%),
    radial-gradient(circle at 88% 8%, rgba(210, 191, 255, 0.2), transparent 28%),
    radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0) 38%),
    linear-gradient(180deg, #f5f7ff 0%, #f8f8ff 38%, #fbfbfe 100%);
}

.workbench-state {
  margin: 30rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.workbench-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.chat-workbench-content,
.exact-workbench-content {
  overflow: hidden;
}

.segment-control-shell {
  flex: 0 0 auto;
  position: relative;
  z-index: 5;
}

.chat-panel {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.segment-control {
  width: 540rpx;
  max-width: calc(100% - 104rpx);
  margin: 16rpx auto 0;
  padding: 7rpx;
  border-radius: 23rpx;
  display: flex;
  background: linear-gradient(135deg, rgba(236, 238, 249, 0.94), rgba(231, 232, 243, 0.84));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.segment-item {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #737b94;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
}

.segment-item.active {
  color: #6552f5;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(47, 53, 88, 0.09);
}

.segment-item.active.warm {
  color: #ed6a4f;
}

.messages-scroll {
  width: 100%;
  min-height: 320rpx;
  margin-top: 12rpx;
  padding: 24rpx 30rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.chat-empty {
  min-height: calc(100vh - 760rpx);
  padding: 34rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  justify-content: flex-start;
}

.assistant-avatar-shell {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assistant-avatar,
.message-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 650;
  background: linear-gradient(135deg, #8b7bf6, #657edb);
}

.assistant-avatar {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  overflow: hidden;
  font-size: 66rpx;
  box-shadow:
    0 24rpx 56rpx rgba(101, 82, 245, 0.22),
    inset 0 4rpx 14rpx rgba(255, 255, 255, 0.34);
}

.assistant-avatar.has-image {
  background: rgba(239, 237, 255, 0.96);
}

.assistant-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

.assistant-avatar::before,
.assistant-avatar::after {
  content: '';
  position: absolute;
  inset: -16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(135, 113, 245, 0.1);
}

.assistant-avatar::after {
  inset: -30rpx;
  border-color: rgba(135, 113, 245, 0.06);
}

.empty-title {
  margin-top: 44rpx;
  font-size: 62rpx;
  line-height: 1.12;
  font-weight: 760;
  color: #11172d;
  letter-spacing: -1.4rpx;
}

.empty-copy {
  max-width: 600rpx;
  margin-top: 20rpx;
  font-size: 29rpx;
  line-height: 1.62;
  color: #737b94;
}

.quick-prompts {
  width: 100%;
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.quick-prompt-button {
  width: 432rpx;
  max-width: 100%;
  min-height: 82rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #6552f5;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(225, 219, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(80, 84, 126, 0.06);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.3;
  text-align: center;
}

.quick-prompt-button::after { border: none; }

.message-row {
  width: 100%;
  margin: 20rpx 0 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.user-row {
  justify-content: flex-end;
}

.message-stack {
  max-width: 82%;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.assistant-stack {
  align-items: flex-start;
  max-width: 82%;
}

.user-stack {
  align-items: flex-end;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(52, 58, 92, 0.10);
}

.assistant-message-avatar {
  overflow: hidden;
}

.assistant-message-avatar-fallback {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(145deg, #7d73fb, #5f8cf5);
}

.assistant-message-avatar-image {
  background: rgba(239, 237, 255, 0.96);
}

.user-message-avatar {
  background: rgba(242, 243, 252, 0.92);
}

.message-bubble {
  width: fit-content;
  max-width: 100%;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(48, 54, 88, 0.07);
}

.user-bubble {
  color: #ffffff;
  background: linear-gradient(135deg, #7264f9 0%, #644df4 100%);
  border-color: rgba(121, 102, 249, 0.26);
  border-bottom-right-radius: 10rpx;
  box-shadow: 0 14rpx 28rpx rgba(101, 82, 245, 0.20);
}

.assistant-bubble {
  color: #20263a;
  background: rgba(255, 255, 255, 0.92);
  border-bottom-left-radius: 10rpx;
}

.message-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.62;
  word-break: break-all;
}

.message-audio {
  display: block;
  width: 210rpx;
  min-width: 210rpx;
  max-width: 220rpx;
  margin-top: 14rpx;
}

.message-tag {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #8a90a5;
}

.message-time {
  margin-top: 10rpx;
  padding-right: 6rpx;
  color: #8a90a5;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: right;
}

.reply-feedback {
  display: inline-flex;
  align-items: stretch;
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(122, 107, 247, 0.16);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(55, 61, 94, 0.06);
  backdrop-filter: blur(12rpx);
}

.reply-feedback-action {
  min-width: 140rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  color: #7f879f;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  box-sizing: border-box;
}

.reply-feedback-action-hover {
  background: rgba(117, 101, 245, 0.08);
}

.reply-feedback-divider {
  align-self: center;
  width: 1rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: rgba(129, 135, 158, 0.18);
}

.reply-feedback-label {
  display: block;
  font-size: 24rpx;
  line-height: 1;
}

.reply-feedback-indicator {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(133, 141, 163, 0.7);
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.reply-feedback-indicator::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: transparent;
  transform: translate(-50%, -50%);
}

.reply-feedback-action.selected {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.55);
}

.reply-feedback-action.like-action.selected {
  color: #6150ee;
  background: rgba(110, 93, 246, 0.14);
}

.reply-feedback-action.like-action.selected .reply-feedback-indicator {
  border-color: rgba(99, 82, 242, 0.92);
  background: rgba(255, 255, 255, 0.98);
}

.reply-feedback-action.like-action.selected .reply-feedback-indicator::after {
  background: #6957f5;
  box-shadow: 0 0 12rpx rgba(105, 87, 245, 0.35);
}

.reply-feedback-action.dislike-action.selected {
  color: #5d6479;
  background: rgba(107, 115, 141, 0.13);
}

.reply-feedback-action.dislike-action.selected .reply-feedback-indicator {
  border-color: rgba(104, 112, 139, 0.9);
}

.reply-feedback-action.dislike-action.selected .reply-feedback-indicator::after {
  width: 7rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #6c738b;
}

.pending-user-row { margin-bottom:12rpx; }

.typing-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.typing-wave-bar {
  width: 7rpx;
  border-radius: 999rpx;
  background: #6552f5;
  animation: typing-wave 0.8s ease-in-out infinite alternate;
}
.wave-one { height: 18rpx; animation-delay: -0.3s; }
.wave-two { height: 34rpx; animation-delay: -0.2s; }
.wave-three { height: 26rpx; animation-delay: -0.1s; }
.wave-four { height: 42rpx; }

.scroll-spacer {
  height: 32rpx;
}

.scroll-bottom-anchor {
  width: 100%;
  height: 1rpx;
}

.chat-composer-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 29;
}

.chat-composer {
  position: relative;
  z-index: 30;
  min-height: 108rpx;
  padding: 12rpx 12rpx 12rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 40rpx rgba(47, 53, 88, 0.12);
}

.composer-input-shell {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #f2f3f7;
}

.composer-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  overflow: hidden;
  background: transparent;
  color: #11172d;
  font-size: 30rpx;
  line-height: 80rpx;
}

.composer-input-placeholder {
  color: #98a0b6;
  font-size: 30rpx;
  line-height: 80rpx;
}

.send-button {
  flex: 0 0 184rpx;
  width: 184rpx !important;
  min-width: 184rpx;
  min-height: 84rpx;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6552f5, #8d68f6);
  font-size: 30rpx;
  font-weight: 680;
}

.send-button.disabled { opacity: 0.58; }
.send-button::after { border: none; }

.exact-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.exact-panel {
  padding: 12rpx 30rpx calc(58rpx + env(safe-area-inset-bottom));
}

.exact-label {
  display: block;
  margin: 24rpx 4rpx 16rpx;
  font-size: 33rpx;
  font-weight: 650;
  color: #11172d;
}

.exact-input-card {
  position: relative;
  padding: 10rpx;
}

.exact-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 26rpx 26rpx 62rpx;
  color: #11172d;
  font-size: 34rpx;
  line-height: 1.72;
}

.char-count {
  position: absolute;
  right: 26rpx;
  bottom: 20rpx;
  color: #858ca2;
  font-size: 28rpx;
}

.exact-helper {
  display: block;
  margin: 18rpx 6rpx 0;
  color: #8c93a8;
  font-size: 24rpx;
  line-height: 1.55;
}

.generate-button {
  margin-top: 20rpx;
  width: 100%;
  min-height: 94rpx;
}

.inline-error,
.chat-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 25rpx;
  line-height: 1.55;
}

.chat-error {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 35;
}

.results-heading {
  margin: 44rpx 4rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pending-result,
.exact-empty,
.result-card {
  padding: 24rpx;
}

.pending-result {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #6552f5;
  font-size: 26rpx;
}

.results-heading .section-caption { font-size: 25rpx; }

.exact-empty {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  text-align: center;
  color: #737b94;
  font-size: 25rpx;
}

.exact-empty-title {
  color: #11172d;
  font-size: 30rpx;
  font-weight: 650;
}

.exact-empty-copy {
  color: inherit;
  font-size: inherit;
  line-height: 1.55;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-text {
  display: block;
  margin-bottom: 18rpx;
  font-size: 31rpx;
  line-height: 1.64;
  color: #11172d;
}

@keyframes typing-wave {
  from { transform: scaleY(0.6); opacity: 0.55; }
  to { transform: scaleY(1.1); opacity: 1; }
}

@media (max-height: 740px) {
  .segment-control {
    margin-top: 8rpx;
  }

  .segment-item {
    height: 74rpx;
    font-size: 28rpx;
  }

  .messages-scroll {
    min-height: 300rpx;
    margin-top: 10rpx;
    padding-top: 14rpx;
    padding-bottom: calc(172rpx + env(safe-area-inset-bottom));
  }

  .chat-empty {
    min-height: calc(100vh - 710rpx);
    padding-top: 18rpx;
  }

  .assistant-avatar {
    width: 140rpx;
    height: 140rpx;
    font-size: 58rpx;
  }

  .empty-title {
    margin-top: 34rpx;
    font-size: 54rpx;
  }

  .empty-copy {
    margin-top: 16rpx;
    font-size: 27rpx;
  }

  .quick-prompts {
    margin-top: 30rpx;
    gap: 16rpx;
  }

  .quick-prompt-button {
    width: 404rpx;
    min-height: 76rpx;
  }
}
