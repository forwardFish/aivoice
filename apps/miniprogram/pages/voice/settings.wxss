.settings-screen {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  padding: 0 32rpx calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 10%, rgba(213, 205, 255, 0.22), transparent 24%),
    radial-gradient(circle at 8% 44%, rgba(222, 216, 255, 0.18), transparent 28%),
    linear-gradient(180deg, rgba(249, 250, 255, 0.98) 0%, #f7f8ff 100%);
}

.settings-aurora { position: absolute; border-radius: 50%; pointer-events: none; }
.aurora-top { width: 360rpx; height: 300rpx; right: -140rpx; top: 42rpx; background: radial-gradient(circle, rgba(187, 174, 255, 0.18), transparent 68%); }
.aurora-middle { width: 390rpx; height: 330rpx; left: -190rpx; top: 620rpx; background: radial-gradient(circle, rgba(218, 212, 255, 0.2), transparent 68%); }
.settings-state { position: relative; z-index: 2; margin-top: 24rpx; }
.settings-content { position: relative; z-index: 2; padding-bottom: 24rpx; }

.settings-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  min-height: 174rpx;
  background:
    radial-gradient(circle at 74% 28%, rgba(255, 255, 255, 0.72), transparent 18%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(245, 243, 255, 0.92) 54%, rgba(239, 241, 255, 0.96) 100%);
}

.hero-wave-wrap {
  flex: 0 0 auto;
  width: 98rpx;
  height: 98rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(248, 246, 255, 0.95), rgba(234, 231, 255, 0.88));
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    0 16rpx 36rpx rgba(101, 82, 245, 0.14);
}

.hero-wave {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(245, 243, 255, 0.72);
}

.hero-wave-bar { width: 5rpx; border-radius: 999rpx; background: linear-gradient(180deg, #8a73ff, #6552f5); }
.hero-wave-outer { height: 22rpx; opacity: 0.82; }
.hero-wave-mid { height: 38rpx; }
.hero-wave-center { height: 56rpx; }
.hero-copy { position: relative; z-index: 2; margin-left: 24rpx; }
.hero-name { display: block; font-size: 38rpx; line-height: 1.18; font-weight: 760; color: #17203d; }
.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
}

.hero-badge-success { color: #4ba865; background: rgba(231, 248, 236, 0.95); }
.hero-badge-progress { color: #5f4fe1; background: rgba(239, 236, 255, 0.96); }
.hero-badge-warning { color: #be7a2d; background: rgba(255, 242, 222, 0.96); }
.hero-badge-danger { color: #d95a62; background: rgba(255, 236, 239, 0.96); }
.hero-badge-neutral { color: #68718b; background: rgba(239, 242, 250, 0.98); }

.hero-spark {
  position: absolute;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(162, 146, 255, 0.42), rgba(255, 255, 255, 0));
}

.hero-spark::before,
.hero-spark::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(90deg);
  border-radius: 999rpx;
  background: inherit;
}

.hero-spark-left {
  width: 8rpx;
  height: 56rpx;
  right: 96rpx;
  top: 44rpx;
  opacity: 0.4;
}

.hero-spark-right {
  width: 10rpx;
  height: 70rpx;
  right: 48rpx;
  top: 58rpx;
  opacity: 0.62;
}

.hero-spark::before { width: 56rpx; height: 8rpx; }
.hero-spark::after { width: 28rpx; height: 8rpx; opacity: 0.6; }

.section-heading { margin: 34rpx 8rpx 18rpx; }
.section-heading .section-title,
.section-heading .section-caption { display: block; }
.section-heading .section-title { color: #121a38; font-size: 38rpx; line-height: 1.18; font-weight: 760; }
.section-heading .section-caption { margin-top: 10rpx; color: #7f879e; font-size: 25rpx; line-height: 1.58; }
.focused-heading .section-title { color: #6552f5; }

.form-card,
.action-card { padding: 24rpx 28rpx; }

.field-surface {
  padding: 24rpx 22rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(250, 250, 255, 0.98), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(232, 233, 243, 0.96);
}

.field-label {
  margin-bottom: 18rpx;
  color: #1b2340;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
}

.name-row { display: flex; align-items: center; gap: 18rpx; }
.name-input {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e4e7f2;
  background: #ffffff;
  color: #11172d;
  font-size: 29rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.save-name {
  flex: none;
  width: 148rpx;
  min-height: 76rpx;
  border-radius: 22rpx;
  font-size: 29rpx;
  box-shadow: 0 14rpx 28rpx rgba(101, 82, 245, 0.22);
}

.info-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #11172d;
}

.info-row-first { margin-top: 18rpx; }
.relationship-toggle { border-top: 1rpx solid rgba(233, 235, 244, 0.9); }
.personality-entry { border-top: 1rpx solid rgba(233, 235, 244, 0.9); }
.relationship-toggle .arrow { transition: transform 160ms ease; }
.relationship-toggle .arrow.is-open { transform: rotate(90deg); }

.info-copy { min-width: 0; }
.info-title { color: #1d2440; font-size: 28rpx; font-weight: 620; }
.info-trailing { display: flex; align-items: center; gap: 10rpx; }
.info-value { color: #747d95; font-size: 26rpx; }
.arrow { color: #afb4c4; font-size: 36rpx; line-height: 1; }

.dialogue-profile-block {
  margin-top: 6rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eceef5;
}

.dialogue-profile-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dialogue-profile-title { color: #1b2340; font-size: 28rpx; font-weight: 650; }
.dialogue-profile-note { color: #98a0b6; font-size: 21rpx; line-height: 1.45; }

.settings-relationship-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.settings-relationship-chip {
  min-height: 68rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e0e3ee;
  background: #fbfbfe;
  color: #596078;
  font-size: 23rpx;
  font-weight: 560;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.settings-relationship-chip.selected {
  border-color: rgba(101, 82, 245, 0.44);
  color: #5f4fe1;
  font-weight: 700;
  background: linear-gradient(135deg, #f2efff, #fcfbff);
  box-shadow: 0 12rpx 24rpx rgba(101, 82, 245, 0.10);
}

.settings-profile-block { margin-top: 20rpx; }
.settings-profile-field + .settings-profile-field { margin-top: 24rpx; }
.settings-profile-label { display: block; color: #2a3045; font-size: 24rpx; font-weight: 650; }
.settings-profile-caption { display: block; margin-top: 8rpx; color: #98a0b6; font-size: 21rpx; line-height: 1.45; }
.settings-profile-input {
  width: 100%;
  height: 78rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(101, 82, 245, 0.18);
  background: #f9f8ff;
  color: #11172d;
  font-size: 25rpx;
}

.settings-profile-textarea-wrap {
  margin-top: 14rpx;
  padding: 2rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(245, 242, 255, 0.96));
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.65),
    0 8rpx 22rpx rgba(85, 94, 134, 0.05);
}

.settings-profile-textarea {
  width: 100%;
  min-height: 176rpx;
  padding: 22rpx 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid rgba(101, 82, 245, 0.18);
  background: #f9f8ff;
  color: #11172d;
  font-size: 25rpx;
  line-height: 1.68;
}

.settings-profile-textarea-placeholder {
  color: #a0a8bd;
  font-size: 24rpx;
  line-height: 1.68;
}

.action-card.focused-card { border-color: rgba(101, 82, 245, 0.35); box-shadow: 0 14rpx 40rpx rgba(101, 82, 245, 0.12); }
.action-row {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.action-leading {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.action-icon,
.danger-action-icon {
  flex: 0 0 auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f4f0ff, #ece8ff);
}

.chat-icon-body {
  width: 20rpx;
  height: 16rpx;
  border-radius: 8rpx;
  border: 3rpx solid #6e5bf3;
  position: relative;
}

.chat-icon-tail {
  position: absolute;
  bottom: 12rpx;
  left: 18rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #6e5bf3;
  border-bottom: 3rpx solid #6e5bf3;
  transform: skew(-18deg);
}

.action-copy { flex: 1; min-width: 0; }
.action-title { display: block; font-size: 29rpx; font-weight: 700; color: #18203f; }
.action-description { display: block; margin-top: 10rpx; font-size: 21rpx; line-height: 1.45; color: #97a0b6; }
.action-state { flex: none; color: #a6adbf; font-size: 34rpx; }

.success-message,
.error-message { display: block; margin-top: 22rpx; padding: 18rpx 22rpx; border-radius: 20rpx; font-size: 24rpx; line-height: 1.5; }
.success-message { color: #32875a; background: #eaf8ef; }
.error-message { color: #c6505a; background: #fff0f1; }

.danger-heading { margin-bottom: 14rpx; }
.danger-title { color: #d75663; }

.danger-action-card {
  width: 100%;
  min-height: 156rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: linear-gradient(180deg, rgba(255, 248, 249, 0.98), rgba(255, 246, 247, 0.98));
  border: 1rpx solid rgba(243, 217, 220, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(203, 94, 105, 0.08);
}

.danger-action-card.button-disabled {
  opacity: 1;
  color: inherit;
  background: linear-gradient(180deg, rgba(253, 245, 246, 0.98), rgba(251, 243, 244, 0.98));
  box-shadow: none;
}

.danger-action-leading {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.danger-action-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #ff7d85, #eb5965);
  box-shadow: 0 12rpx 26rpx rgba(219, 95, 104, 0.18);
}

.danger-bin {
  width: 18rpx;
  height: 16rpx;
  border: 3rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 5rpx 5rpx;
  position: relative;
  margin-top: 6rpx;
}

.danger-bin::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -7rpx;
  transform: translateX(-50%);
  width: 14rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.danger-lid {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  top: 19rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.danger-action-copy { flex: 1; min-width: 0; text-align: left; }
.danger-action-title { display: block; color: #df4d5a; font-size: 28rpx; font-weight: 700; line-height: 1.3; }
.danger-action-description { display: block; margin-top: 10rpx; color: #b9888e; font-size: 21rpx; line-height: 1.5; }
.danger-action-arrow { color: #dca0a6; font-size: 34rpx; line-height: 1; }

.save-name::after { border: none; }

@media (max-height: 740px) {
  .settings-screen { padding-bottom: calc(58rpx + env(safe-area-inset-bottom)); }
  .settings-hero { min-height: 160rpx; }
  .hero-name { font-size: 34rpx; }
  .section-heading .section-title { font-size: 34rpx; }
}
