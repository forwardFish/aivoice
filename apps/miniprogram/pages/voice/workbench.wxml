<view class="workbench screen-shell {{showModeChooser ? 'mode-entry' : ''}}">
  <app-nav title="{{showModeChooser ? '' : voiceName}}" back="{{true}}" rightText="{{showModeChooser ? '' : '设置'}}" transparent="{{true}}" bindrighttap="openSettings"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="workbench-state">
    <page-state mode="loading" title="正在打开声音工作台" description="正在同步对话、生成结果和服务端积分…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="workbench-state glass-card">
    <page-state mode="error" title="工作台暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadData"></page-state>
  </view>

  <block wx:else>
    <view wx:if="{{showModeChooser}}" class="mode-chooser fade-in">
      <view class="mode-heading">
        <text class="mode-title">想用 TA 的声音做什么？</text>
        <text class="mode-subtitle">选择一种模式开始体验</text>
      </view>

      <view class="mode-cards">
        <view class="mode-card luminous-card" data-mode="chat" bindtap="selectMode">
          <view class="mode-copy">
            <text class="mode-card-title">对话模式</text>
            <text class="mode-card-line">和 TA 自由聊天</text>
            <text class="mode-card-line">获取 TA 的回应</text>
          </view>
          <image class="mode-card-icon mode-card-image" src="/assets/ui/chat-mode.png" mode="aspectFit"></image>
        </view>

        <view class="mode-card mode-exact luminous-card" data-mode="exact" bindtap="selectMode">
          <view class="mode-copy">
            <text class="mode-card-title exact-title">说一句模式</text>
            <text class="mode-card-line">让 TA 说你想说的话</text>
            <text class="mode-card-line">生成一段 TA 的声音</text>
          </view>
          <image class="mode-card-icon mode-card-image" src="/assets/ui/mic-mode.png" mode="aspectFit"></image>
        </view>
      </view>

      <view class="mode-footer-note"><view class="note-spark"></view><text>两种模式共享账号积分，仅成功生成后扣减</text></view>
    </view>

    <view wx:else class="workbench-body fade-in {{mode === 'exact' ? 'is-exact-mode' : ''}}">
      <view class="voice-banner luminous-card">
        <view class="voice-avatar fallback"><view class="avatar-wave"><text></text><text></text><text></text></view></view>
        <view class="voice-banner-copy">
          <text class="voice-name">{{voiceName}}</text>
          <view class="voice-status-row"><view class="status-dot"></view><text>私有声音已就绪</text></view>
        </view>
        <view class="point-pill"><text class="point-number">{{points.availablePoints}}</text><text class="point-unit">账号积分</text></view>
      </view>

      <view class="mode-tabs glass-card">
        <view class="mode-tab {{mode === 'chat' ? 'active' : ''}}" data-mode="chat" bindtap="switchMode">对话模式</view>
        <view class="mode-tab {{mode === 'exact' ? 'active exact-active' : ''}}" data-mode="exact" bindtap="switchMode">说一句</view>
      </view>
      <button class="change-mode" bindtap="chooseAnotherMode">重新选择使用方式</button>

      <block wx:if="{{mode === 'chat'}}">
        <view class="ai-notice"><text class="notice-spark">✦</text><text>AI 生成内容不代表声音本人真实表达</text></view>
        <scroll-view class="message-list" scroll-y="{{true}}" scroll-into-view="{{scrollTarget}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view wx:if="{{chatMessages.length === 0 && !sending}}" class="chat-intro glass-card">
            <view class="intro-orb css-chat-icon small-chat-icon"><view class="chat-dots"><text></text><text></text><text></text></view></view>
            <text class="intro-title">从一句简单的话开始</text>
            <text class="intro-copy">这是使用“{{voiceName}}”声音输出的 AI 助手，不是真实声音本人。</text>
            <view class="quick-prompts">
              <button data-text="今天过得怎么样？" bindtap="useQuickPrompt">今天过得怎么样？</button>
              <button data-text="陪我聊几句吧。" bindtap="useQuickPrompt">陪我聊几句</button>
              <button data-text="给我一句温柔的鼓励。" bindtap="useQuickPrompt">给我一句鼓励</button>
            </view>
          </view>

          <view wx:for="{{chatMessages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.isUser ? 'is-user' : ''}}">
            <view wx:if="{{item.isAssistant}}" class="message-avatar">{{item.initial}}</view>
            <view class="message-bubble {{item.isUser ? 'bubble-user' : 'bubble-assistant'}}">
              <view wx:if="{{item.isAssistant}}" class="ai-tag-row"><text class="ai-tag">AI 回复</text><text class="message-status">{{item.status === 'PROCESSING' ? '生成中' : item.status === 'FAILED' ? '生成失败' : item.status === 'BLOCKED' ? '未通过审核' : '已完成'}}</text></view>
              <text class="message-text">{{item.text}}</text>
              <audio-player wx:if="{{item.showAudio}}" src="{{item.audioUrl}}" durationMs="{{item.durationMs || 0}}" tag="AI回复" compact="{{true}}"></audio-player>
              <text wx:elif="{{item.isAssistant && item.status === 'FAILED'}}" class="message-error">生成失败，本次未扣积分</text>
            </view>
          </view>

          <view wx:if="{{sending && pendingMode === 'chat'}}" class="message-row">
            <view class="message-avatar">{{voiceInitial}}</view>
            <view class="message-bubble bubble-assistant pending-bubble">
              <view class="typing"><text></text><text></text><text></text></view>
              <text>{{generationStatusText}}</text>
            </view>
          </view>
          <view class="scroll-spacer"></view>
        </scroll-view>

        <text wx:if="{{errorMessage}}" class="inline-error chat-inline-error">{{errorMessage}}</text>
        <view class="chat-composer glass-card">
          <textarea class="chat-input" value="{{chatText}}" placeholder="输入想对 TA 说的话…" maxlength="200" auto-height="{{true}}" bindinput="onChatInput" disabled="{{sending}}"></textarea>
          <button class="send-button" bindtap="sendChat" disabled="{{sending || !chatText}}"><text>{{sending ? '生成中' : '发送'}}</text><text class="send-arrow">›</text></button>
        </view>
      </block>

      <block wx:else>
        <view class="exact-workspace">
          <view class="exact-primary-card luminous-card">
            <view class="exact-card-heading">
              <view class="exact-title-wrap">
                <text class="exact-title">想让 TA 说什么？</text>
                <text class="exact-subtitle">输入准确文字，生成带 AI 标识的声音</text>
              </view>
              <text class="exact-count">{{exactCount}}/50</text>
            </view>

            <textarea class="exact-textarea" value="{{exactText}}" placeholder="例如：天气凉了，记得多穿一件衣服。" maxlength="50" bindinput="onExactInput" disabled="{{sending}}"></textarea>

            <view class="exact-helper">
              <view class="helper-dot"></view>
              <text>1–50 个字符；成功生成后才扣 1 个账号积分</text>
            </view>

            <text wx:if="{{errorMessage}}" class="inline-error exact-inline-error">{{errorMessage}}</text>

            <button class="primary-button exact-generate {{sending || !exactText ? 'button-disabled' : ''}}" disabled="{{sending || !exactText}}" bindtap="generateExact">
              {{sending ? '正在生成声音…' : '生成语音'}}
            </button>
          </view>

          <view class="result-heading"><text class="section-title">生成记录</text><text>最近 10 轮</text></view>

          <scroll-view class="exact-history-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view wx:if="{{sending && pendingMode === 'exact'}}" class="pending-result soft-card"><view class="typing"><text></text><text></text><text></text></view><text>{{generationStatusText}}</text></view>

            <view wx:if="{{exactResults.length === 0 && !sending}}" class="exact-empty soft-card">
              <view class="inline-wave ui-sprite sprite-waveform"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
              <text class="empty-result-title">还没有生成记录</text>
              <text>输入一句话，成功生成后会显示在这里。</text>
            </view>

            <view wx:else class="result-list">
              <view wx:for="{{exactResults}}" wx:key="id" class="result-card soft-card">
                <view class="result-top"><text class="result-text">{{item.text}}</text><text class="ai-tag">AI 生成</text></view>
                <audio-player wx:if="{{item.showAudio}}" src="{{item.audioUrl}}" durationMs="{{item.durationMs || 0}}" tag="AI生成" compact="{{true}}"></audio-player>
                <text wx:else class="message-error">{{item.status === 'FAILED' ? '生成失败，本次未扣积分' : '正在生成…'}}</text>
              </view>
            </view>
            <view class="exact-history-spacer"></view>
          </scroll-view>
        </view>
      </block>
    </view>
  </block>

  <quota-purchase-dialog visible="{{purchaseVisible}}" voiceName="{{voiceName}}" option="{{purchaseOption}}" paying="{{paying}}" pending="{{paymentPending}}" message="{{purchaseMessage}}" bindbuy="buyQuota" bindcancel="closePurchase"></quota-purchase-dialog>
</view>
