<view class="workbench-screen">
  <app-nav
    title="{{state === 'success' ? voiceName : ''}}"
    subtitle="{{state === 'success' ? pointsText : ''}}"
    rightText="{{state === 'success' ? '声音设置' : ''}}"
    bindrighttap="openSettings"
    back="{{true}}"
    transparent="{{true}}"
  ></app-nav>

  <view wx:if="{{state === 'loading'}}" class="workbench-state">
    <page-state mode="loading" title="正在打开声音工作台" description="正在同步对话、生成结果和服务端积分…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="workbench-state soft-card">
    <page-state mode="error" title="工作台暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadData"></page-state>
  </view>

  <view wx:else class="workbench-content">
    <view wx:if="{{showModeChooser}}" class="mode-chooser">
      <text class="chooser-title">想用 TA 的声音做什么？</text>
      <text class="chooser-subtitle">选择一种模式开始体验</text>

      <view class="mode-card chat-mode" data-mode="chat" bindtap="selectMode">
        <view class="mode-copy">
          <text class="mode-title">对话模式</text>
          <text class="mode-description">和 TA 自由聊天，获得 AI 生成的声音回复</text>
        </view>
        <view class="chat-visual"><text class="chat-dot"></text><text class="chat-dot"></text><text class="chat-dot"></text></view>
      </view>

      <view class="mode-card exact-mode" data-mode="exact" bindtap="selectMode">
        <view class="mode-copy">
          <text class="mode-title warm">说一句模式</text>
          <text class="mode-description">输入精确文字，让这个声音原样朗读</text>
        </view>
        <view class="mic-visual"><view class="mic-core"></view></view>
      </view>

      <text class="chooser-note">对话和“说一句”共用账户积分。</text>
    </view>

    <view wx:else>
      <view class="segment-control">
        <view class="segment-item {{mode === 'chat' ? 'active' : ''}}" data-mode="chat" bindtap="switchMode">对话</view>
        <view class="segment-item {{mode === 'exact' ? 'active warm' : ''}}" data-mode="exact" bindtap="switchMode">说一句</view>
      </view>

      <view wx:if="{{mode === 'chat'}}" class="chat-panel">
        <view class="ai-notice">AI 生成内容不代表声音本人真实表达</view>
        <scroll-view class="messages-scroll" scroll-y="{{true}}" scroll-into-view="{{scrollTarget}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view wx:if="{{chatMessages.length === 0 && !sending}}" class="chat-empty">
            <view class="assistant-avatar-shell">
              <view class="assistant-avatar {{voiceAvatar ? 'has-image' : ''}}">
                <image
                  wx:if="{{voiceAvatar}}"
                  class="assistant-avatar-image"
                  src="{{voiceAvatar}}"
                  mode="aspectFill"
                  binderror="onVoiceAvatarError"
                ></image>
                <text wx:else>{{voiceInitial}}</text>
              </view>
            </view>
            <text class="empty-title">从一句简单的话开始</text>
            <text class="empty-copy">这是使用“{{voiceName}}”声音输出的 AI 助手，不是真实声音本人。</text>
            <view class="quick-prompts">
              <button class="quick-prompt-button" data-text="今天过得怎么样？" bindtap="useQuickPrompt">今天过得怎么样？</button>
              <button class="quick-prompt-button" data-text="陪我聊几句吧。" bindtap="useQuickPrompt">陪我聊几句</button>
              <button class="quick-prompt-button" data-text="给我一句温柔的鼓励。" bindtap="useQuickPrompt">给我一句鼓励</button>
            </view>
          </view>

          <view wx:for="{{chatMessages}}" wx:key="id" id="message-{{item.id}}" class="message-row {{item.isUser ? 'user-row' : 'assistant-row'}}">
            <image
              wx:if="{{item.isAssistant && voiceAvatar}}"
              class="message-avatar assistant-message-avatar assistant-message-avatar-image"
              src="{{voiceAvatar}}"
              mode="aspectFill"
              binderror="onVoiceAvatarError"
            ></image>
            <view wx:elif="{{item.isAssistant}}" class="message-avatar assistant-message-avatar assistant-message-avatar-fallback">{{voiceInitial}}</view>
            <view class="message-stack {{item.isUser ? 'user-stack' : 'assistant-stack'}}">
              <view class="message-bubble {{item.isUser ? 'user-bubble' : 'assistant-bubble'}}">
                <text class="message-text">{{item.text}}</text>
                <audio-player wx:if="{{item.showAudio}}" class="message-audio" src="{{item.audioUrl}}" durationMs="{{item.durationMs || 0}}" compact="{{true}}" bubble="{{true}}" durationOnly="{{true}}"></audio-player>
                <text wx:elif="{{item.isAssistant}}" class="message-tag">{{item.status === 'PROCESSING' ? '声音生成中…' : item.status === 'BLOCKED' ? '内容未通过审核' : item.status === 'FAILED' && item.text ? '声音生成失败，文字已保留，未扣积分' : item.status === 'FAILED' ? '生成失败，未扣积分' : 'AI回复'}}</text>
              </view>
              <text wx:if="{{item.isUser && item.timeText}}" class="message-time">{{item.timeText}}</text>
            </view>
            <image wx:if="{{item.isUser}}" class="message-avatar user-message-avatar" src="{{userAvatar}}" mode="aspectFill"></image>
          </view>

          <block wx:if="{{sending && pendingMode === 'chat'}}">
            <view class="message-row user-row pending-user-row">
              <view class="message-stack user-stack">
                <view class="message-bubble user-bubble"><text class="message-text">{{pendingText}}</text></view>
              </view>
              <image class="message-avatar user-message-avatar" src="{{userAvatar}}" mode="aspectFill"></image>
            </view>
            <view id="pending-assistant" class="message-row assistant-row pending-row">
              <image
                wx:if="{{voiceAvatar}}"
                class="message-avatar assistant-message-avatar assistant-message-avatar-image"
                src="{{voiceAvatar}}"
                mode="aspectFill"
                binderror="onVoiceAvatarError"
              ></image>
              <view wx:else class="message-avatar assistant-message-avatar assistant-message-avatar-fallback">{{voiceInitial}}</view>
              <view class="message-stack assistant-stack">
                <view class="message-bubble assistant-bubble">
                  <text wx:if="{{pendingReplyText}}" class="message-text">{{pendingReplyText}}</text>
                  <view wx:else class="typing-wave"><text class="typing-wave-bar wave-one"></text><text class="typing-wave-bar wave-two"></text><text class="typing-wave-bar wave-three"></text><text class="typing-wave-bar wave-four"></text></view>
                  <text class="message-tag">{{generationStatusText}}</text>
                </view>
              </view>
            </view>
          </block>
          <view class="scroll-spacer"></view>
        </scroll-view>

        <view class="chat-composer-shell">
          <view class="chat-composer">
            <view class="composer-leading" aria-label="语音输入入口">
              <image class="composer-leading-icon" src="/assets/ui/mic-mode.png" mode="aspectFit"></image>
            </view>
            <view class="composer-input-shell">
              <input
                class="composer-input"
                type="text"
                value="{{chatText}}"
                placeholder="{{chatInputFocused ? '' : '输入想说的话…'}}"
                placeholder-class="composer-input-placeholder"
                maxlength="200"
                adjust-position="{{false}}"
                hold-keyboard="{{true}}"
                show-confirm-bar="{{false}}"
                confirm-type="send"
                bindfocus="onChatFocus"
                bindinput="onChatInput"
                bindblur="onChatBlur"
                bindconfirm="sendChat"
                disabled="{{sending}}"
              />
            </view>
            <button class="primary-button send-button {{sending ? 'disabled' : ''}}" bindtap="sendChat" disabled="{{sending}}">{{sending ? '…' : '发送'}}</button>
          </view>
        </view>
      </view>

      <view wx:else class="exact-panel">
        <text class="exact-label">输入你希望 TA 说的话</text>
        <view class="exact-input-card soft-card">
          <textarea class="exact-textarea" value="{{exactText}}" placeholder="例如：祝妈妈生日快乐，永远年轻漂亮！" maxlength="50" bindinput="onExactInput" disabled="{{sending}}"></textarea>
          <text class="char-count">{{exactCount}}/50</text>
        </view>
        <text class="exact-helper">最近一次成功结果会保留在下方，额度为 0 时也能继续播放。</text>
        <view role="button" aria-disabled="{{sending}}" class="primary-button generate-button {{sending ? 'button-disabled' : ''}}" bindtap="generateExact">
          <text>{{sending && pendingMode === 'exact' ? '正在生成 AI 语音…' : '生成语音'}}</text>
        </view>

        <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

        <view class="results-heading">
          <text class="section-title">生成记录</text>
          <text class="section-caption">最近一次成功会长期保留</text>
        </view>
        <view wx:if="{{sending && pendingMode === 'exact'}}" class="pending-result soft-card">
          <view class="typing-wave"><text class="typing-wave-bar wave-one"></text><text class="typing-wave-bar wave-two"></text><text class="typing-wave-bar wave-three"></text><text class="typing-wave-bar wave-four"></text></view>
          <text>{{generationStatusText}}</text>
        </view>
        <view wx:if="{{exactResults.length === 0 && !sending}}" class="exact-empty soft-card">
          <text class="exact-empty-title">还没有生成记录</text>
          <text class="exact-empty-copy">输入一句话，成功生成后会显示在这里。</text>
        </view>
        <view wx:else class="result-list">
          <view wx:for="{{exactResults}}" wx:key="id" class="result-card soft-card">
            <text class="result-text">{{item.text}}</text>
            <audio-player wx:if="{{item.showAudio}}" src="{{item.audioUrl}}" durationMs="{{item.durationMs || 0}}" tag="AI生成" compact="{{true}}"></audio-player>
            <text wx:else class="message-tag">{{item.status === 'FAILED' ? '生成失败，未扣积分' : item.status === 'BLOCKED' ? '内容未通过审核，未扣积分' : item.status === 'PROCESSING' ? '正在生成' : '生成未完成'}}</text>
          </view>
        </view>
      </view>

      <text wx:if="{{errorMessage && mode === 'chat'}}" class="chat-error">{{errorMessage}}</text>
    </view>
  </view>

  <quota-purchase-dialog
    visible="{{purchaseVisible}}"
    voiceName="{{voiceName}}"
    option="{{purchaseOption}}"
    paying="{{paying}}"
    pending="{{paymentPending}}"
    message="{{purchaseMessage}}"
    bindbuy="buyQuota"
    bindcancel="closePurchase"
  ></quota-purchase-dialog>
</view>
