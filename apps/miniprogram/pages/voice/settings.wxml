<view class="settings-screen screen-shell">
  <app-nav title="声音设置" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="settings-state">
    <page-state mode="loading" title="正在读取声音设置" description="正在同步声音资料与权限…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="settings-state glass-card">
    <page-state mode="error" title="设置暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadSettings"></page-state>
  </view>

  <view wx:elif="{{deleted}}" class="settings-state glass-card">
    <page-state mode="success" title="声音删除流程已提交" description="服务端将继续删除声音样本、模型和相关记录。" actionText="返回我的声音" bindaction="goVoices"></page-state>
  </view>

  <view wx:else class="settings-content fade-in">
    <view class="settings-hero glass-card">
      <view class="hero-icon-shell">
        <image class="hero-wave-icon" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
      </view>
      <view class="hero-copy">
        <text class="hero-name">{{voiceName}}</text>
        <text class="hero-status">{{statusText}}</text>
      </view>
      <image class="hero-decoration" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
    </view>

    <view class="section-heading">
      <text class="section-title">基本资料</text>
      <text class="section-caption">名称将对外展示，声音权限以创建时的授权记录为准。</text>
    </view>
    <view class="settings-card glass-card">
      <text class="field-label">声音名称</text>
      <view class="name-row">
        <input class="name-input" value="{{nameDraft}}" maxlength="20" bindinput="onNameInput" />
        <view class="save-button-wrap">
          <app-button size="medium" label="{{saving ? '保存中…' : '保存'}}" disabled="{{saving}}" loading="{{saving}}" bindaction="saveName"></app-button>
        </view>
      </view>
      <view class="card-divider"></view>
      <view class="permission-row" bindtap="showPermissionRules">
        <text class="permission-title">声音使用权限</text>
        <view class="permission-trailing">
          <text>{{permissionText}}</text>
          <app-chevron direction="right" size="19"></app-chevron>
        </view>
      </view>
    </view>

    <view class="section-heading {{focus === 'conversation' ? 'focused-heading' : ''}}">
      <text class="section-title">数据管理</text>
      <text class="section-caption">清空后，现有消息不会再参与后续对话上下文。</text>
    </view>
    <view class="settings-card menu-card glass-card {{focus === 'conversation' ? 'focused-card' : ''}}">
      <menu-row icon="/assets/ui/account-stat-voices.webp" title="清空当前对话" description="清空后不再用于最近 10 轮上下文" chevron="{{clearing ? '处理中…' : '›'}}" padded="{{false}}" large="{{true}}" bindaction="clearChat"></menu-row>
    </view>

    <text wx:if="{{successMessage}}" class="success-message">{{successMessage}}</text>
    <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>

    <view class="danger-zone">
      <text class="danger-title">危险操作</text>
      <view class="danger-row-shell">
        <menu-row title="删除整个声音" description="删除后，声音样本、模型、对话和生成记录均无法恢复。" chevron="{{deleting ? '处理中…' : '›'}}" tone="danger" padded="{{false}}" large="{{true}}" bindaction="removeVoice"></menu-row>
      </view>
    </view>
  </view>
</view>
