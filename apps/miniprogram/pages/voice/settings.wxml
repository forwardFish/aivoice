<view class="settings-screen">
  <app-nav title="声音设置" back="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="settings-state">
    <page-state mode="loading" title="正在读取声音设置" description="正在同步服务端声音资料与状态…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="settings-state soft-card">
    <page-state mode="error" title="设置暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadSettings"></page-state>
  </view>

  <view wx:elif="{{deleted}}" class="settings-state soft-card">
    <page-state mode="success" title="声音删除流程已提交" description="服务端将继续删除声音样本、模型和相关记录。" actionText="返回我的声音" bindaction="goVoices"></page-state>
  </view>

  <view wx:else class="settings-content fade-in">
    <view class="settings-hero glass-card">
      <view class="hero-wave"><text></text><text></text><text></text><text></text><text></text></view>
      <view class="hero-copy">
        <text class="hero-name">{{voiceName}}</text>
        <text class="hero-meta">{{statusText}}</text>
      </view>
    </view>

    <view class="section-heading">
      <text class="section-title">基本资料</text>
      <text class="section-caption">修改操作始终提交服务端，不在本地覆盖声音资料。</text>
    </view>
    <view class="form-card soft-card">
      <text class="field-label">声音名称</text>
      <view class="name-row">
        <input class="name-input" value="{{nameDraft}}" maxlength="20" bindinput="onNameInput" />
        <button class="primary-button save-name {{saving ? 'button-disabled' : ''}}" bindtap="saveName" disabled="{{saving}}">{{saving ? '保存中…' : '保存资料'}}</button>
      </view>

      <view class="info-row" bindtap="showPermissionRules">
        <text>声音使用权限</text>
        <view><text>{{permissionText}}</text><text class="arrow">›</text></view>
      </view>
      <view wx:if="{{relationshipOptions.length}}" class="dialogue-profile-block">
        <view class="dialogue-profile-heading">
          <text>TA 是你的谁</text>
          <text>用于调整 AI 对话</text>
        </view>
        <view class="settings-relationship-grid">
          <view wx:for="{{relationshipOptions}}" wx:key="key" class="settings-relationship-chip {{relationshipType === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectRelationship">{{item.title}}</view>
        </view>
        <input wx:if="{{relationshipType === 'OTHER'}}" class="settings-profile-input" value="{{relationshipOther}}" placeholder="请输入关系，如：表姐" maxlength="10" bindinput="onRelationshipOtherInput" />
        <text wx:if="{{relationshipType !== 'SELF'}}" class="settings-profile-label">TA 怎么称呼你（可选）</text>
        <input wx:if="{{relationshipType !== 'SELF'}}" class="settings-profile-input" value="{{userAddress}}" placeholder="如：小林、小名" maxlength="10" bindinput="onUserAddressInput" />
      </view>
    </view>

    <view class="section-heading {{focus === 'conversation' ? 'focused-heading' : ''}}">
      <text class="section-title">数据管理</text>
      <text class="section-caption">删除和清空操作由服务端执行并返回最终状态。</text>
    </view>
    <view class="action-card soft-card {{focus === 'conversation' ? 'focused-card' : ''}}">
      <view class="action-row" bindtap="clearChat">
        <view>
          <text class="action-title">清空当前对话</text>
          <text class="action-copy">清空后不再用于最近 8 轮上下文</text>
        </view>
        <text class="action-state">{{clearing ? '处理中…' : '›'}}</text>
      </view>
    </view>

    <text wx:if="{{successMessage}}" class="success-message">{{successMessage}}</text>
    <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>

    <view class="danger-zone">
      <text class="danger-title">危险操作</text>
      <button class="danger-button delete-voice-button {{deleting ? 'button-disabled' : ''}}" bindtap="removeVoice" disabled="{{deleting}}">{{deleting ? '正在提交删除…' : '删除整个声音'}}</button>
      <text class="danger-copy">删除后无法恢复，账号级免费体验资格不会因删除而恢复。</text>
    </view>
  </view>
</view>
