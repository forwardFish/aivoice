<view class="voices-screen">
  <text class="voices-page-title fade-in">我的声音</text>

  <view wx:if="{{state === 'loading'}}" class="voices-state">
    <page-state mode="loading" title="正在同步声音" description="正在获取已完成、处理中和草稿状态…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="voices-state soft-card">
    <page-state mode="error" title="声音列表暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="retryLoad"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="voices-empty-card soft-card fade-in">
    <view class="empty-icon-shell"><image class="empty-wave-icon" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image></view>
    <text class="voices-empty-title">还没有声音</text>
    <text class="voices-empty-copy">从相册选择一段视频，创建第一个私有 AI 声音。</text>
    <view class="voices-empty-action"><app-button label="创建新声音" bindaction="createVoice"></app-button></view>
  </view>

  <view wx:else class="voice-list fade-in">
    <view
      wx:for="{{voices}}"
      wx:key="id"
      class="voice-card soft-card {{item.isReady ? 'is-ready' : ''}} {{item.showProgress ? 'is-processing' : ''}} {{item.group === 'DRAFT' ? 'is-draft' : ''}} {{item.group === 'FAILED' ? 'is-failed' : ''}}"
      data-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="openPrimary"
    >
      <view class="card-top">
        <app-avatar size="{{item.avatarSize}}" src="{{item.displayAvatar}}" custom-class="voice-avatar"></app-avatar>

        <view class="voice-copy">
          <text class="voice-name">{{item.displayName}}</text>
          <text class="status-pill {{item.statusTone}}">{{item.statusLabel}}</text>
          <text class="voice-meta">{{item.metaText}}</text>
        </view>

        <button wx:if="{{item.status === 'READY'}}" class="settings-button" data-id="{{item.id}}" catchtap="openSettings" aria-label="声音设置">
          <image class="settings-button-icon" src="/assets/ui/more-circle.png" mode="aspectFit"></image>
        </button>
        <button wx:else class="settings-button" data-id="{{item.id}}" data-status="{{item.status}}" catchtap="openPrimary" aria-label="查看声音状态">
          <image class="settings-button-icon" src="/assets/ui/more-circle.png" mode="aspectFit"></image>
        </button>
      </view>

      <view wx:if="{{item.showProgress}}" class="progress-section">
        <text wx:if="{{item.progressStage}}" class="progress-stage">{{item.progressStage}}</text>
        <view class="progress-wrap">
          <view class="progress-track"><view class="progress-value" style="width: {{item.progress}}%;"></view></view>
          <text class="progress-percent">{{item.progress}}%</text>
        </view>
      </view>

      <view wx:if="{{item.isReady}}" class="ready-actions">
        <app-button class="ready-action-host" style="width:100%;min-width:0;display:block;" variant="primary" size="large" label="继续对话" data-id="{{item.id}}" data-status="{{item.status}}" bindaction="openPrimary" custom-class="conversation-action">
          <image slot="icon" class="action-icon" src="/assets/ui/chat-mode.png" mode="aspectFit"></image>
        </app-button>
        <app-button class="ready-action-host" style="width:100%;min-width:0;display:block;" variant="secondary" size="large" label="说一句" data-id="{{item.id}}" bindaction="openExact" custom-class="exact-action">
          <image slot="icon" class="action-icon" src="/assets/ui/mic-mode.png" mode="aspectFit"></image>
        </app-button>
      </view>

      <view wx:elif="{{item.group === 'DRAFT' || item.group === 'FAILED'}}" class="resume-action-wrap">
        <app-button class="resume-action-host" style="width:100%;min-width:0;display:block;" variant="secondary" size="large" label="{{item.primaryAction}}" data-id="{{item.id}}" data-status="{{item.status}}" bindaction="openPrimary" custom-class="resume-action"></app-button>
      </view>
    </view>
  </view>

  <view class="tabbar-safe-space"></view>
</view>
