<view class="voices-screen screen-shell">
  <text class="voices-page-title fade-in">我的声音</text>

  <view wx:if="{{state === 'loading'}}" class="voices-state">
    <page-state mode="loading" title="正在同步声音" description="正在获取已完成、处理中和草稿状态…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="voices-state soft-card">
    <page-state mode="error" title="声音列表暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="retryLoad"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="voices-empty-card soft-card fade-in">
    <view class="empty-icon-shell"><image class="empty-wave-icon" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image></view>
    <text class="voices-empty-title">还没有声音</text>
    <text class="voices-empty-copy">从相册选择一段视频，创建第一个私有 AI 声音。</text>
    <view class="voices-empty-action"><app-button label="创建新声音" bindaction="createVoice"></app-button></view>
  </view>

  <view wx:else class="voice-list fade-in">
    <view
      wx:for="{{voices}}"
      wx:key="id"
      class="voice-card soft-card {{item.isReady ? 'is-ready' : ''}} {{item.showProgress ? 'is-processing' : ''}} {{item.group === 'DRAFT' ? 'is-draft' : ''}} {{item.group === 'FAILED' ? 'is-failed' : ''}}"
      data-id="{{item.id}}"
      data-status="{{item.status}}"
      bindtap="openPrimary"
    >
      <view class="card-top">
        <app-avatar size="{{item.isReady ? 154 : 144}}" src="{{item.displayAvatarUrl}}" custom-class="voice-avatar"></app-avatar>

        <view class="voice-copy">
          <text class="voice-name">{{item.name}}</text>
          <text class="status-pill {{item.statusTone}}">{{item.statusLabel}}</text>
          <text class="voice-meta">{{item.metaText}}</text>
        </view>

        <button wx:if="{{item.status === 'READY'}}" class="settings-button" data-id="{{item.id}}" catchtap="openSettings" aria-label="声音设置">
          <image src="/assets/ui/icon-more-glass.png" mode="aspectFit"></image>
        </button>
        <button wx:else class="settings-button" data-id="{{item.id}}" data-status="{{item.status}}" catchtap="openPrimary" aria-label="查看声音状态">
          <image src="/assets/ui/icon-more-glass.png" mode="aspectFit"></image>
        </button>
      </view>

      <view wx:if="{{item.showProgress}}" class="progress-wrap">
        <view class="progress-track"><view class="progress-value" style="width: {{item.progress}}%;"></view></view>
        <text>{{item.progress}}%</text>
      </view>

      <view wx:if="{{item.isReady}}" class="ready-actions">
        <button class="conversation-action" data-id="{{item.id}}" data-status="{{item.status}}" catchtap="openPrimary">
          <image src="/assets/ui/chat-mode.png" mode="aspectFit"></image><text>继续对话</text>
        </button>
        <button class="exact-action" data-id="{{item.id}}" catchtap="openExact">
          <image src="/assets/ui/mic-mode.png" mode="aspectFit"></image><text>说一句</text>
        </button>
      </view>

      <button wx:elif="{{item.group === 'DRAFT' || item.group === 'FAILED'}}" class="resume-action {{item.group === 'FAILED' ? 'failed-action' : ''}}" data-id="{{item.id}}" data-status="{{item.status}}" catchtap="openPrimary">
        <text class="draft-pencil">✎</text><text>{{item.primaryAction}}</text>
      </button>
    </view>
  </view>

  <view class="tabbar-safe-space"></view>
</view>
