<view class="voices-screen">
  <app-nav title="我的声音"></app-nav>

  <scroll-view class="filter-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="key" class="filter-chip {{activeFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectFilter">{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="voices-state">
    <page-state mode="loading" title="正在同步声音" description="正在获取已完成、处理中和草稿状态…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="voices-state soft-card">
    <page-state mode="error" title="声音列表暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="retryLoad"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="voices-state soft-card">
    <page-state mode="empty" title="{{activeFilter === 'ALL' ? '还没有声音' : '当前分类没有声音'}}" description="{{activeFilter === 'ALL' ? '从相册选择一段视频，创建第一个私有 AI 声音。' : '可以切换到“全部”查看其他声音。'}}" actionText="{{activeFilter === 'ALL' ? '创建新声音' : '查看全部'}}" bindaction="handleEmptyAction"></page-state>
  </view>

  <view wx:else class="voice-list fade-in">
    <view wx:for="{{voices}}" wx:key="id" class="voice-card soft-card">
      <view class="card-top">
        <image wx:if="{{item.displayAvatarUrl}}" class="voice-avatar" src="{{item.displayAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="voice-avatar fallback">{{item.initial}}</view>
        <view class="voice-copy">
          <view class="name-row">
            <text class="voice-name">{{item.name}}</text>
            <text class="status-pill {{item.statusTone}}">{{item.statusLabel}}</text>
          </view>
          <text wx:if="{{item.stageLabel}}" class="stage-label">{{item.stageLabel}}</text>
          <text class="voice-meta">{{item.metaText}}</text>
        </view>
        <button wx:if="{{item.status === 'READY'}}" class="settings-button" data-id="{{item.id}}" catchtap="openSettings"><image src="/assets/ui/icon-more-vertical.png" mode="aspectFit"></image></button>
      </view>

      <view wx:if="{{item.showProgress}}" class="progress-wrap">
        <view class="progress-track"><view class="progress-value" style="width: {{item.progress}}%;"></view></view>
        <text>{{item.progress}}%</text>
      </view>

      <view wx:if="{{item.isReady}}" class="quota-row">
        <text>{{item.pointsText}}</text>
        <text>对话和“说一句”共用账户积分</text>
      </view>

      <view class="card-actions">
        <button class="primary-action {{item.isDisabled ? 'disabled' : ''}}" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="openPrimary" disabled="{{item.isDisabled}}">{{item.primaryAction}}</button>
        <button wx:if="{{item.isReady}}" class="secondary-action" data-id="{{item.id}}" bindtap="openExact">说一句</button>
      </view>
    </view>
  </view>
</view>
