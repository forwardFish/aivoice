.voices-screen {
  min-height: 100vh;
  padding: 96rpx 28rpx calc(206rpx + env(safe-area-inset-bottom));
}

.voices-page-title {
  display: block;
  margin: 0 0 38rpx;
  color: #13265a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  text-align: center;
}

.voices-state,
.voices-empty-card {
  overflow: hidden;
  border-radius: 34rpx;
}

.voices-empty-card {
  min-height: 560rpx;
  padding: 98rpx 46rpx 66rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-shell {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, rgba(244, 242, 255, 0.96), rgba(235, 231, 255, 0.9));
  box-shadow: 0 20rpx 42rpx rgba(101, 82, 245, 0.1);
}

.empty-wave-icon {
  width: 58rpx;
  height: 58rpx;
}

.voices-empty-title {
  margin-top: 34rpx;
  color: #121830;
  font-size: 34rpx;
  font-weight: 760;
}

.voices-empty-copy {
  max-width: 500rpx;
  margin-top: 16rpx;
  color: #7f879f;
  font-size: 24rpx;
  line-height: 1.65;
}

.voices-empty-action {
  width: 420rpx;
  margin-top: 44rpx;
}

.voice-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.voice-card {
  min-height: 232rpx;
  padding: 28rpx 28rpx 26rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  border: 1rpx solid rgba(248, 248, 255, 0.98);
  box-shadow: 0 18rpx 44rpx rgba(67, 71, 108, 0.07);
}

.voice-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 84% 0%, rgba(143, 104, 246, 0.07), rgba(143, 104, 246, 0) 30%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(250, 250, 255, 0.98));
  pointer-events: none;
}

.voice-card.is-ready {
  min-height: 300rpx;
}

.voice-card.is-processing {
  min-height: 216rpx;
}

.voice-card.is-draft,
.voice-card.is-failed {
  min-height: 250rpx;
}

.card-top,
.ready-actions,
.progress-section,
.resume-action-wrap {
  position: relative;
  z-index: 1;
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.voice-avatar {
  border-radius: 50%;
  box-shadow:
    inset 0 0 0 3rpx rgba(255, 255, 255, 0.92),
    0 12rpx 24rpx rgba(78, 83, 132, 0.08);
}

.voice-copy {
  flex: 1 1 auto;
  width: 0;
  min-width: 0;
  padding-top: 6rpx;
}

.voice-name {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #16275a;
  font-size: 34rpx;
  line-height: 1.22;
  font-weight: 740;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  display: inline-flex;
  min-height: 38rpx;
  margin-top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 620;
}

.status-pill.ready {
  color: #18a04b;
  background: #dff7e5;
}

.status-pill.processing {
  color: #6650f3;
  background: #efebff;
}

.status-pill.draft {
  color: #ff6b2c;
  background: #fff0e7;
}

.status-pill.failed {
  color: #d55b63;
  background: #fff0f1;
}

.status-pill.muted {
  color: #7e8498;
  background: #f0f1f5;
}

.voice-meta {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: #74809f;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-button {
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin-top: 2rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(79, 82, 120, 0.08);
}

.settings-button::after {
  border: none;
}

.settings-button-icon {
  width: 68rpx;
  height: 68rpx;
}

.progress-section {
  margin-top: 16rpx;
  margin-left: 144rpx;
}

.progress-stage {
  display: block;
  color: #74809f;
  font-size: 22rpx;
  line-height: 1.45;
}

.progress-wrap {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ebe8fb;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #8a6cf6, #6150f3);
  box-shadow: 0 0 14rpx rgba(101, 82, 245, 0.2);
}

.progress-percent {
  flex: 0 0 auto;
  color: #6150f3;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 650;
}

.ready-actions {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.conversation-action,
.exact-action,
.resume-action {
  width: 100%;
  min-width: 0;
}

.ready-action-host,
.resume-action-host {
  display: block;
  width: 100%;
  min-width: 0;
}

.conversation-action,
.exact-action {
  width: 100% !important;
  min-height: 88rpx !important;
  border-radius: 24rpx !important;
  font-size: 25rpx !important;
}

.conversation-action {
  box-shadow: 0 18rpx 38rpx rgba(101, 82, 245, 0.2) !important;
}

.exact-action {
  background: rgba(255, 255, 255, 0.98) !important;
  border-color: #ece9ff !important;
}

.resume-action-wrap {
  margin-top: 20rpx;
  width: 100%;
}

.resume-action {
  width: 100% !important;
  min-height: 86rpx !important;
  border-radius: 22rpx !important;
  font-size: 24rpx !important;
  background: rgba(255, 255, 255, 0.98) !important;
  border-color: #8f7cff !important;
  box-shadow: none !important;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
}

.tabbar-safe-space {
  height: 32rpx;
}

@media (max-height: 740px) {
  .voices-screen {
    padding-top: 82rpx;
    padding-bottom: calc(182rpx + env(safe-area-inset-bottom));
  }

  .voices-page-title {
    margin-bottom: 26rpx;
    font-size: 46rpx;
  }

  .voice-list {
    gap: 26rpx;
  }

  .voice-card {
    min-height: 220rpx;
    padding: 24rpx 24rpx 22rpx;
  }

  .voice-card.is-ready {
    min-height: 284rpx;
  }

  .voice-card.is-processing {
    min-height: 204rpx;
  }

  .voice-card.is-draft,
  .voice-card.is-failed {
    min-height: 236rpx;
  }

  .voice-name {
    font-size: 32rpx;
  }

  .voice-meta {
    margin-top: 14rpx;
    font-size: 21rpx;
  }

  .progress-section {
    margin-top: 14rpx;
    margin-left: 136rpx;
  }

  .ready-actions {
    margin-top: 18rpx;
  }
}
