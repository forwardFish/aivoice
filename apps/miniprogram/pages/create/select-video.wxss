.select-video-screen {
  padding-left: 34rpx;
  padding-right: 34rpx;
}

.page-body {
  padding-top: 34rpx;
}

.intro-block {
  padding: 0 4rpx;
}

.guide-card,
.preview-card {
  margin-top: 40rpx;
  padding: 30rpx;
}

.media-illustration {
  height: 250rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #f0eeff, #f9fbff);
}

.film-frame {
  width: 190rpx;
  height: 130rpx;
  border-radius: 26rpx;
  position: relative;
  background: linear-gradient(135deg, #8a78f6, #5d68e9);
  box-shadow: 0 22rpx 50rpx rgba(101, 82, 245, 0.24);
}

.film-frame::before,
.film-frame::after {
  content: '';
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  height: 12rpx;
  background: repeating-linear-gradient(90deg, #ffffff 0 15rpx, transparent 15rpx 28rpx);
  opacity: 0.85;
}

.film-frame::before { top: 13rpx; }
.film-frame::after { bottom: 13rpx; }

.film-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-42%, -50%);
  width: 0;
  height: 0;
  border-top: 24rpx solid transparent;
  border-bottom: 24rpx solid transparent;
  border-left: 38rpx solid #ffffff;
}

.guide-list {
  margin: 30rpx 4rpx 34rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: #4f566d;
  font-size: 26rpx;
  line-height: 1.55;
}

.guide-check {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #55b979;
  font-size: 21rpx;
}

.video-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #171a27;
}

.video-meta {
  margin: 24rpx 4rpx 30rpx;
  display: flex;
  gap: 22rpx;
}

.video-meta-card {
  flex: 1;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f7fc;
}

.meta-label,
.meta-value {
  display: block;
}

.meta-label {
  font-size: 22rpx;
  color: #858ca2;
}

.meta-value {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 650;
  color: #11172d;
}

.change-button {
  margin-top: 18rpx;
}

.inline-error {
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 24rpx;
  line-height: 1.55;
}

.privacy-note {
  margin: 28rpx 8rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #858ca2;
  font-size: 23rpx;
  line-height: 1.6;
}

.privacy-icon {
  flex: 0 0 auto;
  width: 24rpx;
  height: 20rpx;
  margin-top: 5rpx;
  border: 3rpx solid #6552f5;
  border-radius: 4rpx;
  position: relative;
}

.privacy-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: -17rpx;
  width: 10rpx;
  height: 14rpx;
  border: 3rpx solid #6552f5;
  border-bottom: 0;
  border-radius: 9rpx 9rpx 0 0;
}

.upload-state {
  min-height: 72vh;
  padding: 80rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.upload-orb {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 32% 28%, #ffffff, #e6e1ff 58%, #c8dcff);
  box-shadow: 0 28rpx 76rpx rgba(101, 82, 245, 0.22);
}

.upload-percent {
  position: absolute;
  bottom: -76rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #6552f5;
}

.upload-title {
  margin-top: 120rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #11172d;
}

.upload-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #737b94;
}

.progress-track {
  width: 520rpx;
  height: 12rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #e8e7f3;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #6552f5, #9d79f7);
  transition: width 180ms ease;
}

/* Approved media-browser layout restored from the completed UI branch. */
.select-video-screen { min-height: 100vh; padding-bottom: calc(178rpx + env(safe-area-inset-bottom)); }
.page-body { padding: 32rpx 78rpx 0; }
.media-tabs { height: 82rpx; margin: 4rpx 50rpx 43rpx; display: flex; align-items: flex-start; gap: 54rpx; border-bottom: 1rpx solid rgba(228, 228, 238, 0.72); }
.media-tab { flex: 0 0 auto; height: 70rpx; padding: 0 6rpx; position: relative; display: flex; align-items: center; justify-content: center; color: #858ba0; background: transparent; font-size: 30rpx; font-weight: 650; }
.media-tab.is-active { color: #151a37; font-weight: 720; }
.media-tab.is-active::after { content: ''; width: 38rpx; height: 6rpx; position: absolute; left: 50%; bottom: 0; border-radius: 999rpx; background: linear-gradient(90deg, #6552f5, #9570f5); transform: translateX(-50%); }
.media-browser { overflow: hidden; }
.media-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 206rpx); gap: 21rpx; }
.media-tile { position: relative; overflow: hidden; border-radius: 20rpx; background: #dfe0ec; border: 3rpx solid transparent; box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86); }
.media-tile.is-selected { border-color: rgba(101, 82, 245, 0.96); box-shadow: 0 0 0 4rpx rgba(101, 82, 245, 0.12); }
.selected-media { width: 100%; height: 100%; }
.media-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14, 17, 39, 0.02), rgba(14, 17, 39, 0.24)); }
.neutral-scene { width: 100%; height: 100%; position: relative; overflow: hidden; background: linear-gradient(150deg, #dce4f2, #aaa6ca 56%, #767797); }
.scene-sunset, .scene-lamp { background: linear-gradient(150deg, #ead8ee, #ccb7c7 52%, #8883ad); }
.scene-sea, .scene-cloud { background: linear-gradient(170deg, #d4e1f0 0 45%, #91a4d1 46% 68%, #686ca5 69%); }
.scene-garden, .scene-mountain { background: linear-gradient(150deg, #dce6d8, #aebda9 52%, #777f9c); }
.scene-table, .scene-night { background: linear-gradient(155deg, #aaa2c3, #4d5278); }
.scene-orb { width: 66rpx; height: 66rpx; position: absolute; right: 22rpx; top: 24rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.25); }
.scene-line { height: 7rpx; position: absolute; left: 18rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.48); }
.line-a { width: 70rpx; bottom: 39rpx; }
.line-b { width: 46rpx; bottom: 24rpx; opacity: 0.64; }
.selection-circle { width: 36rpx; height: 36rpx; position: absolute; right: 13rpx; top: 13rpx; border-radius: 50%; border: 3rpx solid rgba(255, 255, 255, 0.96); background: rgba(20, 23, 48, 0.13); }
.selection-circle.is-selected { display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, #6552f5, #9871f5); font-size: 18rpx; font-weight: 760; }
.duration-chip { position: absolute; right: 12rpx; bottom: 11rpx; padding: 3rpx 7rpx; color: #fff; font-size: 17rpx; font-weight: 650; }
.selected-summary { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.summary-copy { flex: 1; min-width: 0; }
.summary-title { display: block; overflow: hidden; color: #171d34; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.summary-meta { display: block; margin-top: 6rpx; overflow: hidden; color: #8c92a5; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.summary-remove-button {
  flex: 0 0 auto;
  min-width: 146rpx;
  min-height: 82rpx;
  padding: 0 24rpx 0 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(247, 245, 255, 0.98), rgba(239, 236, 252, 0.98));
  border: 1rpx solid rgba(133, 112, 238, 0.26);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 8rpx 18rpx rgba(104, 97, 146, 0.08);
}

.summary-remove-icon {
  width: 30rpx;
  height: 30rpx;
  position: relative;
  border-radius: 50%;
  background: rgba(108, 92, 226, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.summary-remove-stroke {
  width: 16rpx;
  height: 3rpx;
  position: absolute;
  left: 50%;
  top: 50%;
  margin-left: -8rpx;
  margin-top: -1.5rpx;
  border-radius: 999rpx;
  background: #7262d9;
}

.stroke-a { transform: rotate(45deg); }
.stroke-b { transform: rotate(-45deg); }

.summary-remove-label {
  color: #5b538d;
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 0.2rpx;
}

.selection-footer { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; width: 750rpx; max-width: 100vw; min-height: 154rpx; padding: 16rpx 34rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; box-sizing: border-box; background: rgba(250,250,255,.97); border-top: 1rpx solid rgba(226,226,237,.92); box-shadow: 0 -16rpx 38rpx rgba(58,61,94,.08); backdrop-filter: blur(20rpx); }
.selection-footer-action { flex: 0 0 190rpx; width: 190rpx; margin-left: 18rpx; }
.selection-action-button { width:190rpx; min-width:190rpx; min-height:82rpx; margin:0; padding:0 18rpx; display:flex; align-items:center; justify-content:center; border-radius:27rpx; font-size:28rpx; font-weight:680; box-sizing:border-box; }

@media (max-height: 740px) {
  .media-tabs { height: 60rpx; margin-bottom: 15rpx; }
  .media-tab { height: 54rpx; }
  .media-grid { grid-template-rows: repeat(3, 164rpx); gap: 10rpx; }
  .selection-footer { padding-top: 11rpx; padding-bottom: calc(11rpx + env(safe-area-inset-bottom)); }
}
