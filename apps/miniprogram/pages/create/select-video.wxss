.select-video-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 34rpx calc(56rpx + env(safe-area-inset-bottom));
}

.page-body {
  padding-top: 26rpx;
}

.page-body-with-footer {
  padding-bottom: 190rpx;
}

.speaker-failure-dialog-overlay {
  position: fixed;
  inset: 0;
  z-index: 90;
  padding: 38rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(24, 23, 43, 0.46);
  backdrop-filter: blur(12rpx);
}

.speaker-failure-dialog {
  width: 100%;
  max-width: 598rpx;
  padding: 34rpx 32rpx 32rpx;
  border-radius: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.985), rgba(248, 246, 255, 0.97)),
    radial-gradient(circle at top, rgba(138, 118, 245, 0.1), rgba(255, 255, 255, 0));
  box-shadow:
    0 30rpx 84rpx rgba(36, 31, 78, 0.2),
    0 10rpx 24rpx rgba(101, 82, 245, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
}

.speaker-failure-dialog-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 780;
  line-height: 1;
  background: linear-gradient(160deg, #8d77f7, #6552f5);
  box-shadow:
    0 18rpx 34rpx rgba(101, 82, 245, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.34);
}

.speaker-failure-dialog-title,
.speaker-failure-dialog-message {
  display: block;
}

.speaker-failure-dialog-title {
  max-width: 100%;
  margin-top: 22rpx;
  color: #17203a;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: 780;
  letter-spacing: 0.2rpx;
}

.speaker-failure-dialog-message {
  width: 100%;
  max-width: 454rpx;
  margin-top: 14rpx;
  color: #69718a;
  font-size: 25rpx;
  line-height: 1.68;
}

.speaker-failure-dialog-action {
  width: 100%;
  margin-top: 28rpx;
}

.speaker-failure-dialog-button-host {
  width: 100%;
  display: block;
}

.speaker-failure-dialog-button {
  width: 100% !important;
  min-height: 88rpx !important;
  border-radius: 24rpx !important;
  font-size: 29rpx !important;
  font-weight: 700 !important;
}

.hero-panel,
.preview-card {
  margin-top: 22rpx;
}

.hero-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}

.hero-memory-image {
  width: 100%;
  border-radius: 40rpx;
  box-shadow: 0 28rpx 68rpx rgba(92, 86, 148, 0.12);
}

.hero-copy-block,
.preview-copy-block {
  padding: 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-title,
.preview-title {
  color: #151b34;
  font-size: 40rpx;
  line-height: 1.16;
  font-weight: 760;
}

.hero-copy,
.preview-copy {
  max-width: 594rpx;
  margin-top: 16rpx;
  color: #747c95;
  font-size: 25rpx;
  line-height: 1.68;
}

.hero-select-button {
  width: 100%;
  min-height: 94rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-footnotes {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.hero-footnote {
  color: #8990a7;
  font-size: 22rpx;
  line-height: 1.5;
}

.preview-card {
  padding: 32rpx 28rpx 30rpx;
}

.preview-shell {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  border-radius: 32rpx;
  background: #171a27;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.selected-preview {
  width: 100%;
  height: 690rpx;
}

.preview-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 18, 37, 0.04), rgba(15, 18, 37, 0.34));
  pointer-events: none;
}

.preview-duration-chip {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 96rpx;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 650;
  background: rgba(17, 22, 41, 0.4);
  backdrop-filter: blur(12rpx);
}

.video-meta {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.video-meta-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f9f8ff, #f4f4fb);
}

.meta-label,
.meta-value {
  display: block;
}

.meta-label {
  color: #8a90a5;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #171d34;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.18;
}

.selected-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.secondary-pill {
  flex: 1;
  min-height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6552f5;
  font-size: 26rpx;
  font-weight: 680;
  background: rgba(244, 241, 255, 0.96);
  border: 1rpx solid rgba(150, 127, 247, 0.28);
}

.secondary-pill-danger {
  color: #7a6aa3;
  background: rgba(247, 245, 255, 0.92);
}

.inline-error {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 24rpx;
  line-height: 1.55;
}

.upload-state {
  min-height: 72vh;
  padding: 80rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.upload-orb {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 32% 28%, #ffffff, #e6e1ff 58%, #c8dcff);
  box-shadow: 0 28rpx 76rpx rgba(101, 82, 245, 0.22);
}

.upload-orb-checking {
  overflow: hidden;
  background: radial-gradient(circle at 34% 28%, #ffffff, #ece8ff 52%, #d9d2ff 78%, #cfdcff);
}

.upload-orb-halo {
  position: absolute;
  inset: 24rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.52);
}

.upload-orb-halo-a {
  animation: upload-halo-pulse 1.8s ease-in-out infinite;
}

.upload-orb-halo-b {
  inset: 42rpx;
  border-color: rgba(128, 105, 244, 0.18);
  animation: upload-halo-pulse 1.8s ease-in-out infinite 0.28s;
}

.upload-checking-dot {
  width: 18rpx;
  height: 18rpx;
  position: absolute;
  right: 54rpx;
  top: 60rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow:
    0 0 0 10rpx rgba(255, 255, 255, 0.14),
    0 0 24rpx rgba(255, 255, 255, 0.92);
  animation: upload-dot-blink 1.1s ease-in-out infinite;
}

.upload-percent {
  position: absolute;
  bottom: -76rpx;
  color: #6552f5;
  font-size: 42rpx;
  font-weight: 700;
}

.upload-title {
  margin-top: 120rpx;
  color: #11172d;
  font-size: 36rpx;
  font-weight: 700;
}

.upload-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #737b94;
  font-size: 25rpx;
  line-height: 1.65;
}

.progress-track {
  width: 520rpx;
  height: 12rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8e7f3;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #6552f5, #9d79f7);
  transition: width 180ms ease;
}

.selection-footer {
  position: fixed;
  z-index: 45;
  left: 0;
  right: 0;
  bottom: 0;
  width: 750rpx;
  max-width: 100vw;
  min-height: 154rpx;
  padding: 16rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: rgba(250, 250, 255, 0.97);
  border-top: 1rpx solid rgba(226, 226, 237, 0.92);
  box-shadow: 0 -16rpx 38rpx rgba(58, 61, 94, 0.08);
  backdrop-filter: blur(20rpx);
}

.selected-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-title {
  display: block;
  overflow: hidden;
  color: #171d34;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-meta {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8c92a5;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selection-footer-action {
  flex: 0 0 190rpx;
  width: 190rpx;
  margin-left: 18rpx;
}

.selection-action-button {
  width: 190rpx;
  min-width: 190rpx;
  min-height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 27rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 680;
}

@keyframes upload-halo-pulse {
  0%,
  100% {
    transform: scale(0.96);
    opacity: 0.52;
  }

  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

@keyframes upload-dot-blink {
  0%,
  100% {
    opacity: 0.38;
    transform: scale(0.82);
  }

  50% {
    opacity: 1;
    transform: scale(1.08);
  }
}

@media (max-height: 740px) {
  .select-video-screen {
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  }

  .speaker-failure-dialog {
    max-width: 560rpx;
    padding: 30rpx 28rpx 28rpx;
    border-radius: 30rpx;
  }

  .speaker-failure-dialog-badge {
    width: 80rpx;
    height: 80rpx;
    font-size: 34rpx;
  }

  .speaker-failure-dialog-title {
    margin-top: 18rpx;
    font-size: 31rpx;
  }

  .speaker-failure-dialog-message {
    max-width: 426rpx;
    font-size: 23rpx;
  }

  .speaker-failure-dialog-action {
    margin-top: 24rpx;
  }

  .page-body {
    padding-top: 14rpx;
  }

  .hero-panel,
  .preview-card {
    margin-top: 14rpx;
  }

  .hero-memory-image {
    border-radius: 34rpx;
  }

  .hero-title,
  .preview-title {
    font-size: 36rpx;
  }

  .hero-copy,
  .preview-copy,
  .upload-copy {
    font-size: 23rpx;
  }

  .hero-select-button {
    min-height: 88rpx;
  }

  .upload-orb-halo {
    inset: 18rpx;
  }

  .upload-orb-halo-b {
    inset: 34rpx;
  }

  .upload-checking-dot {
    right: 48rpx;
    top: 50rpx;
  }

  .selected-preview {
    height: 560rpx;
  }

  .selection-footer {
    padding-top: 11rpx;
    padding-bottom: calc(11rpx + env(safe-area-inset-bottom));
  }
}
