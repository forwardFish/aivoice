.select-video-screen{min-height:100vh;padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}.page-body{padding:28rpx 38rpx 0}.page-heading{text-align:center;margin:18rpx 0 38rpx}.page-title{display:block;color:#11172d;font-size:40rpx;line-height:1.35;font-weight:760;letter-spacing:.6rpx}.page-subtitle{display:block;margin-top:15rpx;color:#7b8299;font-size:25rpx}.gallery-card{height:660rpx;border-radius:42rpx;position:relative;overflow:hidden}.gallery-grid{height:100%;padding:19rpx;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);gap:12rpx;filter:saturate(.82)}.thumb{position:relative;overflow:hidden;border-radius:22rpx;background:linear-gradient(145deg,#e9ecff,#d7d3f8);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.thumb:nth-child(2n){background:linear-gradient(145deg,#f0e3e0,#ddd7f8)}.thumb:nth-child(3n){background:linear-gradient(145deg,#dce8ef,#ded7f7)}.thumb::before{content:'';position:absolute;left:-20%;right:-20%;bottom:-30%;height:70%;border-radius:50% 50% 0 0;background:linear-gradient(160deg,rgba(101,82,245,.25),rgba(248,193,177,.30))}.thumb-person{position:absolute;left:50%;top:31%;width:36%;height:47%;transform:translateX(-50%);border-radius:50% 50% 42% 42%;background:linear-gradient(180deg,#7a70c3,#4d5792);opacity:.68}.thumb-person::before{content:'';position:absolute;left:23%;top:-29%;width:55%;height:42%;border-radius:50%;background:#625b9d}.thumb-person.child{width:31%;height:39%;top:39%}.thumb-person.elder{background:linear-gradient(180deg,#8a7a8d,#5a5b79)}.thumb-play{position:absolute;right:10rpx;bottom:10rpx;width:34rpx;height:34rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(25,27,54,.50);font-size:12rpx}.thumb.feature{background:linear-gradient(145deg,#efeaff,#e1dcff)}.gallery-memory{width:100%;height:100%;opacity:.88}.gallery-overlay{position:absolute;left:50%;top:50%;width:330rpx;min-height:238rpx;transform:translate(-50%,-50%);padding:30rpx 24rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:34rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(255,255,255,.89);box-shadow:0 28rpx 70rpx rgba(48,43,92,.20),inset 0 1rpx 0 #fff;backdrop-filter:blur(18rpx)}.album-icon{width:76rpx;height:64rpx;border:5rpx solid #6958ef;border-radius:14rpx;position:relative;background:linear-gradient(145deg,#fff,#efedff)}.album-mountain{position:absolute;left:12rpx;bottom:10rpx;width:39rpx;height:26rpx;clip-path:polygon(0 100%,45% 30%,67% 62%,83% 43%,100% 100%);background:#7c6bf1}.album-sun{position:absolute;right:10rpx;top:10rpx;width:12rpx;height:12rpx;border-radius:50%;background:#f8b78e}.album-title{margin-top:18rpx;color:#171d34;font-size:29rpx;font-weight:700}.album-copy{margin-top:9rpx;color:#8b91a6;font-size:20rpx}.select-button{margin-top:25rpx}.quality-card{margin-top:24rpx;padding:27rpx 29rpx;border-radius:30rpx}.quality-title-row{display:flex;align-items:center;gap:11rpx;color:#242a40;font-size:25rpx;font-weight:680}.quality-spark{color:#7665f2}.quality-grid{margin-top:21rpx;display:grid;grid-template-columns:1fr 1fr;gap:17rpx 24rpx}.quality-grid>view{display:flex;align-items:center;gap:10rpx;color:#737a91;font-size:22rpx}.quality-check{width:31rpx;height:31rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(135deg,#6a57f1,#9a73f5);font-size:18rpx}.privacy-note{margin:24rpx 2rpx 0;display:flex;align-items:center;justify-content:center;gap:11rpx;color:#9297aa;font-size:20rpx}.privacy-lock{width:21rpx;height:18rpx;border:3rpx solid #7d84a0;border-radius:4rpx;position:relative}.privacy-lock::before{content:'';position:absolute;left:4rpx;top:-13rpx;width:8rpx;height:10rpx;border:3rpx solid #7d84a0;border-bottom:0;border-radius:7rpx 7rpx 0 0}.selected-card{padding:20rpx;border-radius:39rpx}.video-preview{width:100%;height:610rpx;border-radius:29rpx;background:#111}.selected-meta{padding:22rpx 7rpx 9rpx;display:flex;align-items:center;justify-content:space-between}.selected-name{display:block;color:#1c2238;font-size:26rpx;font-weight:680}.selected-detail{display:block;margin-top:7rpx;color:#8a90a5;font-size:21rpx}.replace-link{height:58rpx;padding:0 19rpx;border-radius:20rpx;color:#6959ec;background:#efedff;font-size:21rpx}.next-button{margin-top:15rpx}.inline-error{display:block;margin:17rpx 8rpx 0;color:#d85c66;font-size:22rpx;line-height:1.5}.error-card{padding:18rpx 22rpx;border-radius:22rpx;background:rgba(255,238,239,.8)}.upload-state{min-height:calc(100vh - 160rpx);padding:86rpx 54rpx;display:flex;flex-direction:column;align-items:center;text-align:center}.upload-orb{width:260rpx;height:260rpx;border-radius:50%;position:relative;display:flex;align-items:center;justify-content:center;animation:pulse-soft 2.2s ease-in-out infinite}.upload-wave-image{width:170rpx;height:100rpx;opacity:.82}.upload-percent{position:absolute;left:0;right:0;bottom:40rpx;color:#6552f5;font-size:27rpx;font-weight:730}.upload-title{margin-top:47rpx;color:#161c33;font-size:34rpx;font-weight:730}.upload-copy{max-width:500rpx;margin-top:17rpx;color:#858ca2;font-size:23rpx;line-height:1.65}.progress-track{width:520rpx;height:13rpx;margin-top:43rpx;overflow:hidden;border-radius:999rpx;background:#e7e5f5}.progress-value{height:100%;border-radius:inherit;background:linear-gradient(90deg,#6552f5,#a376f7);box-shadow:0 0 18rpx rgba(101,82,245,.45)}
