.preview-screen {
  padding-left: 34rpx;
  padding-right: 34rpx;
}

.preview-content {
  padding-top: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.success-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #63c884, #45aa68);
  box-shadow: 0 16rpx 34rpx rgba(75, 176, 107, 0.22);
  font-size: 38rpx;
  font-weight: 700;
}

.preview-title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 750;
  color: #11172d;
}

.preview-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #737b94;
}

.avatar-orb {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-core {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 74rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #8d7cf7, #5f73dc);
  border: 10rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 28rpx 68rpx rgba(101, 82, 245, 0.22);
}

.avatar-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  opacity: 0.55;
}

.avatar-wave text {
  width: 6rpx;
  border-radius: 999rpx;
  background: #8b7cf6;
}

.avatar-wave text:nth-child(1) { height: 32rpx; }
.avatar-wave text:nth-child(2) { height: 58rpx; }
.avatar-wave text:nth-child(3) { height: 40rpx; }
.avatar-wave.right { transform: scaleX(-1); }

.voice-name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #11172d;
}

.preview-audio {
  width: 100%;
  margin-top: 34rpx;
  padding: 22rpx;
}

.play-tip {
  width: 100%;
  margin: 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  text-align: left;
  background: #fff7e9;
  color: #8b6a3d;
  font-size: 23rpx;
  line-height: 1.55;
}

.play-tip.completed {
  background: #eefaf2;
  color: #3d8758;
}

.tip-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 9rpx;
  border-radius: 50%;
  background: currentColor;
}

.inline-error {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: #c9515b;
  background: #fff0f1;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: left;
}

.retry-button {
  margin-top: 18rpx;
}

.price-note {
  max-width: 620rpx;
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #858ca2;
}

.state-card {
  margin-top: 50rpx;
  overflow: hidden;
}
