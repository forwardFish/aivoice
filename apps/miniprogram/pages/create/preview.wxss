.preview-screen {
  min-height: 100vh;
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
}

.state-wrap {
  margin: 32rpx;
  overflow: hidden;
  border-radius: 34rpx;
}

.preview-content {
  min-height: calc(100vh - 96rpx);
  padding: 20rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-subtitle {
  margin-top: 10rpx;
  color: #a4aac1;
  font-size: 29rpx;
  line-height: 1.56;
  text-align: center;
}

.voice-visual {
  width: 100%;
  height: 330rpx;
  margin-top: 34rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.visual-aura {
  position: absolute;
  top: 60rpx;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(181, 161, 255, 0.20) 0%, rgba(181, 161, 255, 0) 72%);
  filter: blur(4rpx);
  opacity: 0.8;
}

.visual-aura-left {
  left: 58rpx;
}

.visual-aura-right {
  right: 58rpx;
}

.side-wave {
  width: 116rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  opacity: 0.96;
}

.left-wave {
  margin-right: 38rpx;
}

.right-wave {
  margin-left: 38rpx;
}

.wave-bar {
  width: 7rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #cbbaff, #8367f7);
  box-shadow: 0 0 16rpx rgba(123, 102, 235, 0.15);
}

.wave-tall {
  height: 54rpx;
}

.wave-mid {
  height: 34rpx;
}

.wave-short {
  height: 18rpx;
}

.avatar-shell {
  width: 282rpx;
  height: 282rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-core {
  width: 260rpx;
  height: 260rpx;
  position: relative;
  z-index: 3;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 44rpx rgba(101, 82, 245, 0.16);
  background: #ece8ff;
}

.neutral-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 30%),
    radial-gradient(circle at 52% 46%, #ede9ff 0%, #d7d0ff 60%, #b6a6ff 100%);
}

.neutral-wave-image {
  width: 82rpx;
  height: 44rpx;
}

.avatar-glow {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  z-index: 2;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.48);
}

.visual-spark {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 0 16rpx rgba(255, 224, 154, 0.95);
}

.spark-a {
  width: 7rpx;
  height: 7rpx;
  top: 30rpx;
  right: 136rpx;
}

.spark-b {
  width: 5rpx;
  height: 5rpx;
  top: 168rpx;
  left: 118rpx;
}

.voice-name {
  display: block;
  margin-top: 10rpx;
  color: #20263d;
  font-size: 58rpx;
  line-height: 1.12;
  font-weight: 720;
}

.preview-card {
  width: 100%;
  margin-top: 38rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 32rpx rgba(51, 58, 94, 0.06);
  transition: box-shadow 180ms ease, transform 180ms ease, border-color 180ms ease;
}

.preview-card.is-prompted {
  border-color: rgba(126, 102, 247, 0.38);
  box-shadow: 0 0 0 6rpx rgba(126, 102, 247, 0.10), 0 18rpx 36rpx rgba(83, 72, 168, 0.14);
  transform: translateY(-2rpx);
}

.preview-player {
  display: block;
}

.preview-copy {
  display: block;
  width: 100%;
  margin-top: 22rpx;
  padding: 0 24rpx;
  color: #8e93a9;
  font-size: 30rpx;
  line-height: 1.76;
  text-align: center;
}

.preview-status {
  display: block;
  margin-top: 14rpx;
  color: #8f95a7;
  font-size: 27rpx;
  line-height: 1.58;
  text-align: center;
}

.preview-status.is-complete {
  color: #56a471;
}

.preview-status.is-prompted {
  color: #7560dc;
}

.inline-error {
  width: 100%;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  color: #d85b63;
  background: #fff0f1;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.action-stack {
  width: 100%;
  margin-top: 0;
  padding-top: 80rpx;
}

.preview-action {
  width: 100%;
  position: relative;
  overflow: hidden;
}

.use-button {
  min-height: 98rpx;
  border-radius: 24rpx;
}

.use-button-prompted {
  box-shadow: 0 0 0 6rpx rgba(126, 102, 247, 0.12), 0 18rpx 38rpx rgba(106, 84, 240, 0.22);
}

.use-button-listen-first {
  box-shadow: 0 18rpx 38rpx rgba(106, 84, 240, 0.2);
}

.retry-button {
  margin-top: 22rpx;
  min-height: 96rpx;
  padding: 18rpx 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(236, 235, 244, 0.96);
  color: #202438;
  box-shadow: 0 12rpx 30rpx rgba(51, 58, 94, 0.07);
}

.retry-button-disabled {
  opacity: 0.72;
}

.retry-button-label,
.retry-button-count {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 650;
  text-align: center;
}

.retry-remaining { display: block; margin-top: 10rpx; color: #8c93a8; font-size: 22rpx; line-height: 1.4; text-align: center; }

.retry-button-count {
  font-size: 28rpx;
}

@media (max-height: 740px) {
  .preview-content {
    padding-top: 8rpx;
  }

  .voice-visual {
    height: 300rpx;
    margin-top: 24rpx;
  }

  .avatar-shell {
    width: 260rpx;
    height: 260rpx;
  }

  .avatar-core {
    width: 240rpx;
    height: 240rpx;
  }

  .side-wave {
    width: 96rpx;
  }

  .left-wave {
    margin-right: 24rpx;
  }

  .right-wave {
    margin-left: 24rpx;
  }

  .preview-card {
    margin-top: 26rpx;
  }

  .action-stack {
    padding-top: 70rpx;
  }

  .use-button,
  .retry-button {
    min-height: 92rpx;
  }
}
