.preview-screen { min-height: 100vh; padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 32rpx; overflow: hidden; border-radius: 34rpx; }
.preview-content { padding: 11rpx 36rpx 0; display: flex; flex-direction: column; align-items: center; }
.success-label { min-height: 42rpx; padding: 0 14rpx; border-radius: 999rpx; display: flex; align-items: center; gap: 8rpx; color: #4aa86c; background: rgba(231,248,237,.88); border: 1rpx solid rgba(174,225,192,.73); font-size: 18rpx; font-weight: 680; }
.success-check { width: 24rpx; height: 24rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #55b979; font-size: 15rpx; }
.preview-title { display: block; margin-top: 15rpx; color: #11172d; font-size: 36rpx; line-height: 1.3; font-weight: 760; text-align: center; }
.preview-subtitle { margin-top: 8rpx; color: #7d849a; font-size: 20rpx; line-height: 1.5; text-align: center; }

.voice-visual { width: 300rpx; height: 210rpx; margin-top: 6rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.visual-ring { position: absolute; border-radius: 50%; border: 1rpx solid rgba(137,116,241,.18); }
.ring-a { width: 205rpx; height: 205rpx; }
.ring-b { width: 166rpx; height: 166rpx; border-color: rgba(137,116,241,.26); box-shadow: 0 0 44rpx rgba(137,116,241,.12); }
.avatar-core { width: 132rpx; height: 132rpx; position: relative; z-index: 3; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.82); box-shadow: 0 22rpx 48rpx rgba(101,82,245,.25); background: #e8e4ff; }
.neutral-avatar { display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 22%,#f9f7ff,#ded8ff 58%,#9a86ee); }
.neutral-wave-image { width:88rpx; height:48rpx; }
.visual-spark { position: absolute; border-radius: 50%; background: #fff; box-shadow: 0 0 16rpx rgba(255,224,154,.95); }
.spark-a { width: 8rpx; height: 8rpx; top: 30rpx; right: 47rpx; }
.spark-b { width: 6rpx; height: 6rpx; bottom: 29rpx; left: 43rpx; }
.voice-name-row { margin-top: -4rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.voice-name { color: #20263d; font-size: 26rpx; font-weight: 720; }
.private-tag { padding: 5rpx 10rpx; border-radius: 999rpx; color: #6858e4; background: #efedff; font-size: 15rpx; font-weight: 630; }

.preview-card { width: 100%; margin-top: 18rpx; padding: 21rpx 21rpx 18rpx; border-radius: 33rpx; }
.preview-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 15rpx; }
.preview-kicker,
.preview-copy { display: block; }
.preview-kicker { color: #6a5ae5; font-size: 17rpx; font-weight: 690; }
.preview-copy { max-width: 465rpx; margin-top: 6rpx; color: #292f45; font-size: 20rpx; line-height: 1.5; }
.ai-tag { flex: 0 0 auto; padding: 5rpx 10rpx; border-radius: 999rpx; color: #7e6be6; background: rgba(239,237,255,.88); font-size: 14rpx; }
.preview-player { display: block; margin-top: 14rpx; }
.play-status { margin-top: 12rpx; padding: 11rpx 13rpx; border-radius: 16rpx; display: flex; align-items: center; gap: 9rpx; color: #8c92a5; background: rgba(246,246,251,.88); font-size: 16rpx; line-height: 1.4; }
.play-status.is-complete { color: #4e9d69; background: rgba(234,248,239,.89); }
.status-icon { flex: 0 0 auto; width: 25rpx; height: 25rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #58b779; font-size: 15rpx; }
.status-pulse { width: 8rpx; height: 8rpx; border-radius: 50%; background: #8f7af0; box-shadow: 0 0 0 6rpx rgba(101,82,245,.10); animation: pulse-soft 1.3s ease-in-out infinite; }
.play-status:not(.is-complete) .status-icon { background: #fff; border: 2rpx solid #d8d4ee; }

.inline-error { width: 100%; margin-top: 14rpx; padding: 13rpx 16rpx; border-radius: 17rpx; color: #d85b63; background: #fff0f1; font-size: 18rpx; line-height: 1.5; }
.use-button { margin-top: 18rpx; min-height: 84rpx; }
.retry-button { margin-top: 10rpx; min-height: 74rpx; }
.points-note { max-width: 580rpx; margin-top: 15rpx; color: #81879b; font-size: 16rpx; line-height: 1.55; text-align: center; }
.safety-note { max-width: 570rpx; margin-top: 8rpx; color: #a0a4b3; font-size: 14rpx; line-height: 1.45; text-align: center; }

@media (max-height: 740px) {
  .preview-content { padding-top: 4rpx; }
  .preview-title { margin-top: 10rpx; }
  .voice-visual { height: 170rpx; margin-top: 1rpx; }
  .ring-a { width: 175rpx; height: 175rpx; }
  .ring-b { width: 145rpx; height: 145rpx; }
  .avatar-core { width: 115rpx; height: 115rpx; }
  .preview-card { margin-top: 12rpx; padding-top: 17rpx; }
  .preview-player { margin-top: 10rpx; }
  .use-button { margin-top: 12rpx; min-height: 76rpx; }
  .retry-button { min-height: 66rpx; }
  .points-note { margin-top: 10rpx; }
}
