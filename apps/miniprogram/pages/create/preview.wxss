.preview-screen { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 34rpx; overflow: hidden; border-radius: 36rpx; }
.preview-content { padding: 21rpx 38rpx 0; display: flex; flex-direction: column; align-items: center; }
.success-label { min-height: 48rpx; padding: 0 17rpx; border-radius: 999rpx; display: flex; align-items: center; gap: 9rpx; color: #4aa86c; background: rgba(231, 248, 237, .88); border: 1rpx solid rgba(174, 225, 192, .73); font-size: 20rpx; font-weight: 680; }
.success-check { width: 27rpx; height: 27rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #55b979; font-size: 17rpx; }
.preview-title { display: block; margin-top: 22rpx; color: #11172d; font-size: 39rpx; line-height: 1.35; font-weight: 760; text-align: center; }
.preview-subtitle { max-width: 520rpx; margin-top: 13rpx; color: #7d849a; font-size: 23rpx; line-height: 1.6; text-align: center; }
.voice-visual { width: 430rpx; height: 310rpx; margin-top: 11rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.visual-ring { position: absolute; border-radius: 50%; border: 1rpx solid rgba(137, 116, 241, .18); }
.ring-a { width: 268rpx; height: 268rpx; }
.ring-b { width: 214rpx; height: 214rpx; border-color: rgba(137, 116, 241, .26); box-shadow: 0 0 56rpx rgba(137, 116, 241, .12); }
.avatar-core { width: 168rpx; height: 168rpx; position: relative; z-index: 3; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: radial-gradient(circle at 30% 22%, #c8bcff, #8d75ee 48%, #5f58ce); border: 4rpx solid rgba(255,255,255,.78); box-shadow: 0 26rpx 60rpx rgba(101,82,245,.29), inset 0 3rpx 0 rgba(255,255,255,.46); font-family: Georgia, "Songti SC", serif; font-size: 58rpx; font-weight: 720; }
.wave-side { width: 94rpx; height: 78rpx; position: absolute; z-index: 4; display: flex; align-items: center; justify-content: center; gap: 6rpx; }
.wave-left { left: 0; }
.wave-right { right: 0; }
.wave-side text { width: 6rpx; border-radius: 999rpx; background: linear-gradient(180deg, #9f8ff4, #6b5be3); opacity: .75; }
.wave-side text:nth-child(1), .wave-side text:nth-child(4) { height: 24rpx; }
.wave-side text:nth-child(2) { height: 51rpx; }
.wave-side text:nth-child(3) { height: 68rpx; }
.visual-spark { position: absolute; border-radius: 50%; background: #fff; box-shadow: 0 0 18rpx rgba(255,224,154,.95); }
.spark-a { width: 9rpx; height: 9rpx; top: 49rpx; right: 81rpx; }
.spark-b { width: 7rpx; height: 7rpx; bottom: 48rpx; left: 73rpx; }
.voice-name-row { margin-top: -7rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.voice-name { color: #20263d; font-size: 29rpx; font-weight: 720; }
.private-tag { padding: 6rpx 12rpx; border-radius: 999rpx; color: #6858e4; background: #efedff; font-size: 17rpx; font-weight: 630; }
.preview-card { width: 100%; margin-top: 24rpx; padding: 25rpx 24rpx 22rpx; border-radius: 38rpx; }
.preview-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.preview-kicker,
.preview-copy { display: block; }
.preview-kicker { color: #6a5ae5; font-size: 19rpx; font-weight: 690; }
.preview-copy { max-width: 470rpx; margin-top: 8rpx; color: #292f45; font-size: 23rpx; line-height: 1.55; }
.ai-tag { flex: 0 0 auto; padding: 6rpx 12rpx; border-radius: 999rpx; color: #7e6be6; background: rgba(239,237,255,.88); font-size: 16rpx; }
.preview-player { display: block; margin-top: 19rpx; }
.play-status { margin-top: 17rpx; padding: 13rpx 15rpx; border-radius: 18rpx; display: flex; align-items: center; gap: 10rpx; color: #8c92a5; background: rgba(246,246,251,.88); font-size: 18rpx; line-height: 1.45; }
.play-status.is-complete { color: #4e9d69; background: rgba(234,248,239,.89); }
.status-icon { flex: 0 0 auto; width: 28rpx; height: 28rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #58b779; font-size: 17rpx; }
.status-pulse { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8f7af0; box-shadow: 0 0 0 7rpx rgba(101,82,245,.10); animation: pulse-soft 1.3s ease-in-out infinite; }
.play-status:not(.is-complete) .status-icon { background: #fff; border: 2rpx solid #d8d4ee; }
.inline-error { width: 100%; margin-top: 18rpx; padding: 15rpx 18rpx; border-radius: 18rpx; color: #d85b63; background: #fff0f1; font-size: 20rpx; line-height: 1.5; }
.use-button { margin-top: 25rpx; }
.retry-button { margin-top: 14rpx; }
.points-note { width: 100%; margin-top: 21rpx; padding: 19rpx 21rpx; border-radius: 28rpx; display: flex; align-items: flex-start; gap: 14rpx; }
.points-gift { flex: 0 0 auto; width: 42rpx; height: 42rpx; border-radius: 15rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#6a58f2,#9b72f4); box-shadow: 0 9rpx 18rpx rgba(101,82,245,.18); font-size: 20rpx; }
.points-note text:first-child { display: block; color: #444b62; font-size: 20rpx; font-weight: 670; }
.points-note text:last-child { display: block; margin-top: 6rpx; color: #8d92a4; font-size: 17rpx; line-height: 1.5; }
.safety-note { max-width: 570rpx; margin-top: 19rpx; color: #999dae; font-size: 17rpx; line-height: 1.55; text-align: center; }
