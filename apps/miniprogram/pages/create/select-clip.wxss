.clip-screen { min-height: 100vh; padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.page-state-wrap { margin: 30rpx 32rpx; overflow: hidden; border-radius: 32rpx; }
.clip-content { padding: 9rpx 30rpx 0; }
.compact-heading { margin: 0 2rpx 16rpx; text-align: center; }
.compact-heading .page-title { font-size: 35rpx; }
.compact-heading .page-subtitle { margin-top: 7rpx; font-size: 20rpx; }

.video-stage { padding: 10rpx; position: relative; border-radius: 32rpx; overflow: hidden; }
.clip-video { width: 100%; height: 310rpx; overflow: hidden; border-radius: 24rpx; background: #17182a; box-shadow: 0 14rpx 30rpx rgba(24, 24, 43, .16); }
.video-meta-overlay { position: absolute; left: 23rpx; right: 23rpx; bottom: 22rpx; padding: 9rpx 13rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: space-between; color: #fff; background: rgba(19, 21, 43, .52); backdrop-filter: blur(12rpx); font-size: 16rpx; }

.trim-card { margin-top: 15rpx; padding: 19rpx 20rpx 18rpx; border-radius: 31rpx; }
.trim-heading { display: flex; align-items: center; justify-content: space-between; gap: 17rpx; }
.trim-title,
.trim-copy { display: block; }
.trim-title { color: #171d34; font-size: 24rpx; font-weight: 710; }
.trim-copy { margin-top: 4rpx; color: #7c8398; font-size: 18rpx; }
.duration-pill { flex: 0 0 auto; min-width: 93rpx; min-height: 55rpx; padding: 6rpx 12rpx; border-radius: 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(145deg, #eeebff, #fff); border: 1rpx solid rgba(212, 205, 250, .94); }
.duration-pill text:first-child { color: #6552f5; font-size: 21rpx; font-weight: 760; }
.duration-pill text:last-child { margin-top: 2rpx; color: #9196a8; font-size: 13rpx; }

.wave-shell { height: 88rpx; margin-top: 13rpx; position: relative; display: flex; align-items: center; overflow: hidden; border-radius: 19rpx; background: linear-gradient(180deg, #f6f5fc, #f0eff9); }
.wave-bars { width: 100%; height: 67rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 6rpx; }
.wave-bars text { flex: 1; min-width: 3rpx; max-width: 6rpx; border-radius: 999rpx; background: linear-gradient(180deg, #a294f8, #6654ef); opacity: .72; }
.wave-selection { position: absolute; z-index: 1; top: 6rpx; bottom: 6rpx; border-radius: 15rpx; background: linear-gradient(90deg, rgba(101, 82, 245, .13), rgba(157, 112, 245, .20)); border: 1rpx solid rgba(112, 90, 239, .24); pointer-events: none; }
.marker { width: 4rpx; position: absolute; z-index: 3; top: 4rpx; bottom: 4rpx; transform: translateX(-50%); background: #6552f5; box-shadow: 0 0 12rpx rgba(101, 82, 245, .37); pointer-events: none; }
.marker-start { background: #6552f5; }
.marker-end { background: #9872f3; }
.marker-handle { width: 23rpx; height: 23rpx; position: absolute; left: 50%; top: -1rpx; transform: translateX(-50%); border-radius: 7rpx 7rpx 10rpx 10rpx; background: inherit; }
.time-labels { margin-top: 5rpx; display: flex; justify-content: space-between; color: #70778e; font-size: 17rpx; font-weight: 650; }

.position-actions { margin-top: 12rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.position-actions button { min-height: 57rpx; padding: 0 8rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #626a82; background: rgba(246, 246, 252, .92); border: 1rpx solid #e9e8f2; font-size: 17rpx; }
.action-dot { width: 9rpx; height: 9rpx; border-radius: 50%; }
.start-dot { background: #6552f5; }
.end-dot { background: #9872f3; }

.fine-tune { margin-top: 11rpx; padding-top: 8rpx; border-top: 1rpx solid #ecebf4; }
.slider-line { min-height: 45rpx; display: flex; align-items: center; gap: 9rpx; }
.slider-name { flex: 0 0 auto; width: 44rpx; color: #7c8296; font-size: 16rpx; }
.range-slider { flex: 1; margin: 0 -2rpx; }
.preview-button { width: 100%; height: 62rpx; margin-top: 8rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: #6655e8; background: linear-gradient(145deg, #efedff, #fff); border: 1rpx solid rgba(211, 204, 249, .92); font-size: 20rpx; font-weight: 650; }
.preview-button.is-disabled { opacity: .44; }
.preview-play { width: 0; height: 0; margin-left: 3rpx; border-top: 8rpx solid transparent; border-bottom: 8rpx solid transparent; border-left: 13rpx solid #6655e8; }

.inline-error { display: block; margin: 13rpx 4rpx 0; padding: 13rpx 16rpx; border-radius: 17rpx; color: #d75c66; background: rgba(255, 238, 239, .90); font-size: 18rpx; line-height: 1.5; }
.clip-content-spacer { height: 38rpx; }

.clip-footer { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; padding: 12rpx 30rpx calc(13rpx + env(safe-area-inset-bottom)); background: rgba(250, 250, 255, .97); border-top: 1rpx solid rgba(226, 226, 237, .92); box-shadow: 0 -16rpx 38rpx rgba(58, 61, 94, .08); backdrop-filter: blur(20rpx); }
.footer-consent { min-height: 48rpx; margin-bottom: 9rpx; display: flex; align-items: center; gap: 11rpx; }
.check-box { flex: 0 0 auto; width: 32rpx; height: 32rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; color: #fff; border: 3rpx solid #c6c4d4; font-size: 17rpx; }
.footer-consent.is-confirmed .check-box { border-color: #6552f5; background: linear-gradient(135deg, #6552f5, #9570f5); }
.footer-consent-copy { flex: 1; min-width: 0; }
.footer-consent-copy text:first-child { display: block; color: #3b4157; font-size: 18rpx; font-weight: 650; }
.footer-consent-copy text:last-child { display: block; margin-top: 3rpx; color: #999dae; font-size: 14rpx; }
.footer-next { min-height: 86rpx; }

@media (max-height: 740px) {
  .clip-screen { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
  .compact-heading { margin-bottom: 10rpx; }
  .compact-heading .page-subtitle { display: none; }
  .clip-video { height: 270rpx; }
  .trim-card { margin-top: 10rpx; padding-top: 15rpx; padding-bottom: 14rpx; }
  .wave-shell { height: 77rpx; margin-top: 9rpx; }
  .position-actions { margin-top: 8rpx; }
  .fine-tune { margin-top: 7rpx; }
  .slider-line { min-height: 39rpx; }
  .preview-button { height: 55rpx; }
  .footer-consent-copy text:last-child { display: none; }
  .footer-next { min-height: 80rpx; }
}
