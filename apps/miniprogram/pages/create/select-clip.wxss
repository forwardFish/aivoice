.clip-screen { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.page-state-wrap { margin: 30rpx 32rpx; overflow: hidden; border-radius: 32rpx; }
.clip-content { padding: 98rpx 30rpx 0; }

.video-stage { position: relative; overflow: hidden; border-radius: 28rpx; }
.clip-video { width: 100%; height: 458rpx; overflow: hidden; border-radius: 28rpx; background: #17182a; box-shadow: 0 14rpx 30rpx rgba(24,24,43,.16); }
.video-time { position: absolute; right: 18rpx; bottom: 17rpx; color: #fff; text-shadow: 0 2rpx 6rpx rgba(0,0,0,.42); font-size: 16rpx; }

.compact-heading { margin: 18rpx 2rpx 12rpx; text-align: center; }
.compact-heading .page-title { font-size: 39rpx; }
.compact-heading .page-subtitle { margin-top: 9rpx; font-size: 22rpx; }

.trim-card { margin-top: 106rpx; padding: 0 6rpx 22rpx; }
.wave-shell { height: 96rpx; position: relative; display: flex; align-items: center; overflow: hidden; border-radius: 19rpx; background: transparent; }
.wave-bars { width: 100%; height: 72rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 6rpx; }
.wave-bars text { flex: 1; min-width: 3rpx; max-width: 6rpx; border-radius: 999rpx; background: linear-gradient(180deg,#d9dcec,#b9bed8); opacity: .78; }
.wave-selection { position: absolute; z-index: 1; top: 17rpx; bottom: 17rpx; border-radius: 15rpx; background: linear-gradient(90deg,rgba(101,82,245,.18),rgba(157,112,245,.25)); border: 1rpx solid rgba(112,90,239,.20); pointer-events: none; }
.marker { width: 44rpx; position: absolute; z-index: 4; top: 4rpx; bottom: 4rpx; transform: translateX(-50%); background: transparent; pointer-events: auto; touch-action: none; }
.marker::before { content: ''; width: 6rpx; position: absolute; left: 50%; top: 6rpx; bottom: 6rpx; transform: translateX(-50%); border-radius: 999rpx; background: #6552f5; box-shadow: 0 0 12rpx rgba(101,82,245,.37); }
.marker-end::before { background: #9872f3; }
.marker-handle { width: 32rpx; height: 62rpx; position: absolute; left: 50%; top: 13rpx; transform: translateX(-50%); border-radius: 16rpx; background: linear-gradient(180deg,#7664f7,#5848e7); box-shadow: 0 7rpx 18rpx rgba(93,75,224,.25); }
.marker-end .marker-handle { background: linear-gradient(180deg,#a27cf5,#815ae9); }
.time-labels { margin-top: 8rpx; display: flex; justify-content: space-between; color: #70778e; font-size: 26rpx; font-weight: 520; }
.drag-hint { display:block; margin-top:8rpx; color:#8a90a4; text-align:center; font-size:18rpx; }

.selected-duration { margin-top: 22rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.selected-duration-value { color: #11172d; font-size: 58rpx; line-height: 1.1; font-weight: 700; }
.selected-duration-label { margin-top: 8rpx; color: #888fa5; font-size: 22rpx; }

.advanced-toggle { min-width: 168rpx; height: 54rpx; margin: 28rpx auto 0; padding: 0 18rpx; border-radius: 18rpx; color: #6758df; background: #efedff; font-size: 17rpx; }
.advanced-toggle::after { border: none; }
.advanced-tools { margin-top: 28rpx; padding: 18rpx 18rpx 14rpx; border-radius: 26rpx; background: rgba(247,247,252,.72); border: 1rpx solid rgba(233,232,243,.88); }
.advanced-title { display: block; color: #7c8296; font-size: 17rpx; font-weight: 650; }
.position-actions { margin-top: 10rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.position-actions button { min-height: 60rpx; padding: 0 8rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #626a82; background: rgba(255,255,255,.84); border: 1rpx solid #e9e8f2; font-size: 18rpx; }
.action-dot { width: 9rpx; height: 9rpx; border-radius: 50%; }
.start-dot { background: #6552f5; }
.end-dot { background: #9872f3; }
.fine-tune { margin-top: 9rpx; padding-top: 7rpx; border-top: 1rpx solid #ecebf4; }
.slider-line { min-height: 45rpx; display: flex; align-items: center; gap: 9rpx; }
.slider-name { flex: 0 0 auto; width: 44rpx; color: #7c8296; font-size: 16rpx; }
.range-slider { flex: 1; margin: 0 -2rpx; }
.preview-button { width: 100%; height: 68rpx; margin-top: 10rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: #6655e8; background: linear-gradient(145deg,#efedff,#fff); border: 1rpx solid rgba(211,204,249,.92); font-size: 21rpx; font-weight: 650; }
.preview-button.is-disabled { opacity: .44; }
.preview-play { width: 35rpx; height: 35rpx; }

.footer-consent { min-height: 56rpx; margin-top: 16rpx; display: flex; align-items: center; justify-content: center; gap: 11rpx; color: #6f768b; font-size: 18rpx; }
.check-box { flex: 0 0 auto; width: 32rpx; height: 32rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; color: #fff; border: 3rpx solid #c6c4d4; font-size: 17rpx; }
.footer-consent.is-confirmed .check-box { border-color: #6552f5; background: linear-gradient(135deg,#6552f5,#9570f5); }
.inline-error { display: block; margin: 13rpx 4rpx 0; padding: 13rpx 16rpx; border-radius: 17rpx; color: #d75c66; background: rgba(255,238,239,.90); font-size: 18rpx; line-height: 1.5; }
.clip-content-spacer { height: 42rpx; }


@media (max-height: 740px) {
  .clip-screen { padding-bottom: calc(122rpx + env(safe-area-inset-bottom)); }
  .clip-content { padding-top: 8rpx; }
  .compact-heading { margin-top: 18rpx; }
  .compact-heading .page-subtitle { display: none; }
  .clip-video { height: 330rpx; }
  .trim-card { margin-top: 16rpx; }
  .wave-shell { height: 78rpx; }
  .selected-duration { margin-top: 18rpx; }
  .selected-duration-value { font-size: 54rpx; }
  .advanced-tools { margin-top: 22rpx; }
  .slider-line { min-height: 39rpx; }
  .preview-button { height: 55rpx; }
  .preview-play { width: 31rpx; height: 31rpx; }
  .footer-consent { margin-top: 12rpx; }
}
