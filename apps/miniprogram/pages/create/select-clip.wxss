.clip-screen { min-height: 100vh; padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.page-state-wrap { margin: 30rpx 32rpx; overflow: hidden; border-radius: 32rpx; }
.clip-content { padding: 98rpx 28rpx 0; }

.video-stage { position: relative; overflow: hidden; border-radius: 28rpx; background: #0d0f1a; box-shadow: 0 14rpx 30rpx rgba(24,24,43,.16); }
.clip-video { display: block; width: 100%; height: 458rpx; overflow: hidden; border-radius: 28rpx; background: #0d0f1a; }
.video-time { position: absolute; right: 22rpx; bottom: 19rpx; color: #fff; font-size: 25rpx; line-height: 1; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.52); }

.clip-intro { margin: 30rpx 4rpx 0; text-align: left; }
.clip-title,
.clip-subtitle { display: block; }
.clip-title { color: #101830; font-size: 41rpx; line-height: 1.32; font-weight: 700; letter-spacing: -.5rpx; }
.clip-subtitle { margin-top: 12rpx; color: #7f879e; font-size: 29rpx; line-height: 1.6; }

.trim-card { margin-top: 54rpx; padding: 0 6rpx 24rpx; }
.wave-shell { position: relative; height: 118rpx; display: flex; align-items: center; overflow: visible; }
.wave-bars { width: 100%; height: 80rpx; padding: 0 8rpx; display: flex; align-items: center; justify-content: space-between; gap: 6rpx; }
.wave-bar { position: relative; z-index: 0; flex: 1; min-width: 3rpx; max-width: 7rpx; border-radius: 999rpx; background: linear-gradient(180deg,#dce0ef,#b9bfd8); opacity: .82; }
.wave-selection { position: absolute; z-index: 1; top: 26rpx; bottom: 26rpx; border-radius: 16rpx; background: linear-gradient(90deg,rgba(101,82,245,.21),rgba(157,112,245,.29)); border: 1rpx solid rgba(112,90,239,.18); touch-action: none; }
.wave-selection.is-dragging { background: linear-gradient(90deg,rgba(101,82,245,.30),rgba(157,112,245,.38)); box-shadow: 0 5rpx 16rpx rgba(101,82,245,.16); }
.marker { position: absolute; z-index: 3; top: 8rpx; bottom: 8rpx; width: 66rpx; transform: translateX(-50%); border-radius: 999rpx; background: transparent; touch-action: none; }
.marker::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 7rpx; transform: translateX(-50%); border-radius: 999rpx; background: #6552f5; box-shadow: 0 0 18rpx rgba(101,82,245,.34); }
.marker-end::before { background: #8f69f1; }
.marker-handle { position: absolute; left: 50%; top: 8rpx; width: 44rpx; height: 82rpx; transform: translateX(-50%); border-radius: 22rpx; background: #6552f5; box-shadow: 0 8rpx 20rpx rgba(101,82,245,.2); transition: transform 120ms ease, box-shadow 120ms ease; }
.marker-end .marker-handle { background: #8f69f1; }
.marker.is-dragging .marker-handle { transform: translateX(-50%) scale(1.1); box-shadow: 0 10rpx 26rpx rgba(101,82,245,.34); }
.marker-handle::after { content: ''; position: absolute; left: 50%; top: 30rpx; width: 8rpx; height: 20rpx; transform: translateX(-50%); border-left: 2rpx solid rgba(255,255,255,.9); border-right: 2rpx solid rgba(255,255,255,.9); }
.time-labels { margin-top: 14rpx; display: flex; justify-content: space-between; color: #7c849b; font-size: 30rpx; line-height: 1.2; font-weight: 500; }

.trim-hint { display: block; margin-top: 10rpx; color: #8b92a8; font-size: 24rpx; line-height: 1.55; text-align: center; }

.selected-duration { margin-top: 38rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.selected-duration-value { color: #101830; font-size: 66rpx; line-height: 1.05; font-weight: 700; letter-spacing: -1rpx; }
.selected-duration-label { margin-top: 11rpx; color: #8c93a8; font-size: 28rpx; line-height: 1.3; }

.advanced-toggle { min-width: 176rpx; height: 60rpx; margin: 24rpx auto 0; padding: 0 18rpx; color: #6552f5; background: transparent; font-size: 24rpx; }
.advanced-toggle::after { border: none; }
.advanced-tools { margin-top: 20rpx; padding: 20rpx 20rpx 16rpx; border: 1rpx solid rgba(230,229,241,.9); border-radius: 24rpx; background: rgba(247,247,252,.78); }
.advanced-title { display: block; color: #767e96; font-size: 24rpx; font-weight: 650; }
.position-actions { margin-top: 12rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.position-action-button { min-height: 68rpx; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; border: 1rpx solid var(--action-secondary-border); border-radius: 18rpx; color: var(--action-secondary-text); background: var(--action-secondary-bg); font-size: 23rpx; }
.action-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.start-dot { background: #6552f5; }
.end-dot { background: #9872f3; }
.fine-tune { margin-top: 12rpx; padding-top: 10rpx; border-top: 1rpx solid #ecebf4; }
.slider-line { min-height: 50rpx; display: flex; align-items: center; gap: 10rpx; }
.slider-name { flex: 0 0 auto; width: 56rpx; color: #7c8296; font-size: 22rpx; }
.range-slider { flex: 1; margin: 0 -2rpx; }
.preview-button { width: 100%; height: 76rpx; margin-top: 12rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; border: 1rpx solid var(--action-secondary-border); border-radius: 22rpx; color: var(--action-secondary-text); background: var(--action-secondary-bg); font-size: 24rpx; font-weight: 650; }
.preview-button.is-disabled { opacity: .44; }
.preview-play { width: 37rpx; height: 37rpx; }

.footer-consent { min-height: 62rpx; margin-top: 18rpx; display: flex; align-items: center; justify-content: center; gap: 13rpx; color: #6f768b; }
.check-box { flex: 0 0 auto; width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #c6c4d4; border-radius: 10rpx; color: #fff; font-size: 18rpx; }
.consent-text { font-size: 24rpx; line-height: 1.5; }
.footer-consent.is-confirmed .check-box { border-color: #6552f5; background: linear-gradient(135deg,#6552f5,#9570f5); }
.inline-error { display: block; margin: 16rpx 4rpx 0; padding: 16rpx 18rpx; border-radius: 17rpx; color: #d75c66; background: rgba(255,238,239,.92); font-size: 24rpx; line-height: 1.55; }
.clip-content-spacer { height: 110rpx; }

.clip-footer { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; width: 750rpx; max-width: 100vw; padding: 14rpx 34rpx calc(14rpx + env(safe-area-inset-bottom)); background: rgba(250,250,255,.97); border-top: 1rpx solid rgba(226,226,237,.92); box-shadow: 0 -16rpx 38rpx rgba(58,61,94,.08); backdrop-filter: blur(20rpx); }
.clip-next-button { width: 682rpx; min-height: 90rpx; margin: 0 auto; border-radius: 28rpx; }

@media (max-height: 740px) {
  .clip-screen { padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
  .clip-content { padding-top: 20rpx; }
  .clip-video { height: 350rpx; }
  .clip-intro { margin-top: 22rpx; }
  .trim-card { margin-top: 34rpx; }
  .selected-duration { margin-top: 24rpx; }
  .footer-consent { margin-top: 12rpx; }
  .clip-footer { padding-top: 11rpx; padding-bottom: calc(11rpx + env(safe-area-inset-bottom)); }
}
