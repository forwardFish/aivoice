.progress-screen { min-height: 100vh; padding-bottom: calc(35rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 32rpx; padding: 13rpx; overflow: hidden; border-radius: 34rpx; }
.state-secondary { margin-top: 14rpx; }

.processing-content { padding: 100rpx 48rpx 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
.process-visual { width: 500rpx; height: 500rpx; margin-top:40rpx; margin-bottom:90rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.orbit { position: absolute; border-radius: 50%; border: 1rpx solid rgba(132,113,241,.20); }
.orbit-outer { width: 480rpx; height: 480rpx; animation: pulse-soft 2.5s ease-in-out infinite; }
.orbit-middle { width: 400rpx; height: 400rpx; border-color: rgba(132,113,241,.27); box-shadow: 0 0 50rpx rgba(132,113,241,.12); }
.sound-orb { width: 300rpx; height: 300rpx; position: relative; z-index: 3; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 20%,rgba(255,255,255,.94),rgba(221,213,255,.92) 30%,#9178f2 70%,#6453e8); border: 3rpx solid rgba(255,255,255,.72); box-shadow: 0 29rpx 61rpx rgba(101,82,245,.27), inset 0 4rpx 0 rgba(255,255,255,.57); }
.sound-wave-image { width:220rpx; height:118rpx; position:relative; z-index:2; }
.progress-badge { min-width: 150rpx; height: 70rpx; padding: 0 14rpx; position: absolute; z-index: 4; right: 50%; bottom: -74rpx; display: flex; align-items: baseline; justify-content: center; color: #6552f5; transform:translateX(50%); }
.progress-number { font-size: 52rpx; font-weight: 760; }
.progress-unit { margin-left: 3rpx; font-size: 28rpx; font-weight: 680; }
.spark { position: absolute; z-index: 4; border-radius: 50%; background: #fff; box-shadow: 0 0 17rpx rgba(255,224,151,.94); }
.spark-a { width: 9rpx; height: 9rpx; top: 47rpx; left: 43rpx; }
.spark-b { width: 7rpx; height: 7rpx; top: 71rpx; right: 28rpx; }

.processing-title { display: block; margin-top: 2rpx; color: #11172d; font-size: 35rpx; line-height: 1.35; font-weight: 750; }
.processing-subtitle { display: block; margin-top: 10rpx; color: #7c849b; font-size: 25rpx; font-weight: 560; }

.simple-stages { width: 100%; max-width: 565rpx; margin-top: 27rpx; display: flex; flex-direction: column; }
.stage-row { min-height: 82rpx; display: flex; align-items: center; gap: 13rpx; text-align: left; }
.stage-icon { flex: 0 0 auto; width: 32rpx; height: 32rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: #f0eff5; border: 3rpx solid #d9d9e5; font-size: 16rpx; }
.stage-row.is-done .stage-icon { border-color: #6552f5; background: linear-gradient(135deg,#6552f5,#9670f5); }
.stage-row.is-active .stage-icon { border-color: #8b72f2; background: #fff; box-shadow: 0 0 0 6rpx rgba(101,82,245,.07); }
.stage-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #7865ef; box-shadow: 0 0 11rpx rgba(101,82,245,.48); animation: pulse-soft 1.2s ease-in-out infinite; }
.stage-label { flex: 1; min-width: 0; color: #8c91a4; font-size: 21rpx; }
.stage-state { display: none; }
.stage-row.is-done .stage-label,
.stage-row.is-active .stage-label { color: #30364c; font-weight: 650; }
.stage-row.is-done .stage-state,
.stage-row.is-active .stage-state { color: #7163df; }

.time-note { max-width: 560rpx; margin-top: 90rpx; color: #8d92a5; font-size: 24rpx; line-height: 1.6; }
.recover-note { display: block; width: 100%; margin-top: 15rpx; padding: 13rpx 16rpx; border-radius: 17rpx; color: #a06e4c; background: #fff5eb; font-size: 18rpx; line-height: 1.5; }
.leave-button { height: 62rpx; margin-top: 18rpx; padding: 0 19rpx; border-radius: 21rpx; color: #6758df; background: #efedff; font-size: 19rpx; font-weight: 640; }

@media (max-height: 740px) {
  .processing-content { padding-top: 7rpx; }
  .process-visual { width: 330rpx; height: 330rpx; margin-top:20rpx; margin-bottom:65rpx; }
  .orbit-outer { width: 260rpx; height: 260rpx; }
  .orbit-middle { width: 215rpx; height: 215rpx; }
  .sound-orb { width: 158rpx; height: 158rpx; }
  .processing-title { font-size: 31rpx; }
  .simple-stages { margin-top: 17rpx; }
  .stage-row { min-height: 49rpx; }
  .time-note { margin-top: 13rpx; }
  .leave-button { margin-top: 12rpx; }
}
