.progress-screen {
  padding-left: 34rpx;
  padding-right: 34rpx;
}

.processing-content {
  padding-top: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.processing-title {
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #11172d;
}

.processing-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #737b94;
}

.sound-orb {
  width: 300rpx;
  height: 300rpx;
  margin-top: 62rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 25%, #ffffff, #e3e0ff 55%, #c9deff);
  box-shadow: 0 32rpx 82rpx rgba(101, 82, 245, 0.24);
}

.orb-ring {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  left: -16rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.86);
  border-right-color: rgba(101, 82, 245, 0.46);
  animation: orb-spin 2.4s linear infinite;
}

.sound-wave {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.sound-wave text {
  width: 9rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 3rpx 10rpx rgba(101, 82, 245, 0.25);
  animation: wave-pulse 1.4s ease-in-out infinite alternate;
}
.sound-wave text:nth-child(1) { height: 34rpx; animation-delay: -0.6s; }
.sound-wave text:nth-child(2) { height: 58rpx; animation-delay: -0.4s; }
.sound-wave text:nth-child(3) { height: 86rpx; animation-delay: -0.2s; }
.sound-wave text:nth-child(4) { height: 120rpx; }
.sound-wave text:nth-child(5) { height: 86rpx; animation-delay: -0.2s; }
.sound-wave text:nth-child(6) { height: 58rpx; animation-delay: -0.4s; }
.sound-wave text:nth-child(7) { height: 34rpx; animation-delay: -0.6s; }

.progress-number {
  margin-top: 42rpx;
  font-size: 52rpx;
  font-weight: 750;
  color: #6552f5;
}

.stages-card {
  width: 100%;
  margin-top: 44rpx;
  padding: 28rpx 30rpx;
  text-align: left;
}

.stage-row {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stage-icon {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 3rpx solid #cdd1dd;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
}

.stage-icon.done {
  border-color: #55ba76;
  background: #55ba76;
}

.stage-icon.active {
  border-color: rgba(101, 82, 245, 0.24);
  background: #f0eeff;
}

.stage-spinner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(101, 82, 245, 0.20);
  border-top-color: #6552f5;
  animation: orb-spin 0.9s linear infinite;
}

.stage-label {
  color: #979daf;
  font-size: 26rpx;
}

.stage-label.highlight {
  color: #4f566d;
}

.recover-note {
  margin-top: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  color: #9a6a31;
  background: #fff7e8;
  font-size: 22rpx;
}

.time-note {
  max-width: 600rpx;
  margin-top: 28rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #858ca2;
}

.leave-button {
  margin-top: 26rpx;
}

.failure-wrap {
  padding-top: 40rpx;
}

.failure-wrap .secondary-button {
  margin-top: 18rpx;
}

@keyframes orb-spin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}

@keyframes wave-pulse {
  from { transform: scaleY(0.78); opacity: 0.72; }
  to { transform: scaleY(1.12); opacity: 1; }
}
