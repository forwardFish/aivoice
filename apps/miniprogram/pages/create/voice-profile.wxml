<view class="profile-screen screen-shell">
  <app-nav title="填写信息与授权" back="{{true}}" transparent="{{true}}"></app-nav>

  <view class="profile-content fade-in">
    <text class="profile-intro">信息仅用于生成声音，严格保密</text>

    <view class="name-card">
      <view class="field-heading"><text>称呼 TA</text></view>
      <input class="name-input" value="{{name}}" placeholder="如：小雨 · 5岁" maxlength="20" bindinput="onNameInput" />
    </view>

    <view class="permission-section">
      <view class="permission-heading">
        <text class="permission-title-main">声音使用权限</text><text class="permission-info">ⓘ</text>
      </view>

      <view class="permission-list">
        <view wx:for="{{options}}" wx:key="key" class="permission-card {{permissionType === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectPermission">
          <view class="radio-ring"><view wx:if="{{permissionType === item.key}}" class="radio-core"></view></view>
          <view class="permission-copy">
            <text class="permission-name">{{item.title}}</text>
            <text class="permission-description">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{permissionType}}" class="consent-card {{confirmed ? 'is-confirmed' : ''}}" bindtap="toggleConfirmed">
      <view class="consent-check"><text wx:if="{{confirmed}}">✓</text></view>
      <text class="consent-text">{{consentText}}</text>
    </view>

    <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>
    <view class="profile-spacer"></view>
  </view>

  <bottom-action-bar custom-class="profile-footer">
    <app-button
      label="{{submitting ? '正在提交并启动创建…' : '下一步'}}"
      disabled="{{submitting}}"
      loading="{{submitting}}"
      bindaction="submit"
    ></app-button>
  </bottom-action-bar>
</view>
