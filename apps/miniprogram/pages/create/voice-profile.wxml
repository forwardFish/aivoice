<view class="profile-screen screen-shell">
  <app-nav title="填写信息与授权" back="{{true}}" transparent="{{true}}"></app-nav>

  <view class="profile-content fade-in">
    <view class="profile-hero">
      <view class="voice-orb">
        <view class="orb-glow"></view>
        <view class="orb-wave"><text></text><text></text><text></text><text></text><text></text></view>
      </view>
      <text class="page-title">这个声音，怎么称呼？</text>
      <text class="page-subtitle">名称只在你的账号内显示，稍后可以修改。</text>
    </view>

    <view class="form-card luminous-card">
      <view class="field-block">
        <view class="field-heading"><text>称呼 TA</text><text>{{name.length || 0}}/20</text></view>
        <input class="name-input" value="{{name}}" placeholder="例如：妈妈、爷爷、大学时的我" maxlength="20" bindinput="onNameInput" />
      </view>

      <view class="section-divider"></view>

      <view class="permission-heading">
        <view><text class="permission-title-main">声音使用权限</text><text class="permission-subtitle">请选择与你实际情况一致的一项</text></view>
        <button class="rules-link" bindtap="showRules">查看规则</button>
      </view>

      <view class="permission-list">
        <view wx:for="{{options}}" wx:key="key" class="permission-card {{permissionType === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectPermission">
          <view class="permission-icon {{item.key === 'SELF' ? 'self-icon' : item.key === 'MINOR' ? 'minor-icon' : 'other-icon'}}">
            <view class="person-head"></view><view class="person-body"></view>
          </view>
          <view class="permission-copy">
            <text class="permission-name">{{item.title}}</text>
            <text class="permission-description">{{item.description}}</text>
          </view>
          <view class="radio-ring"><view wx:if="{{permissionType === item.key}}" class="radio-core"></view></view>
        </view>
      </view>

      <view wx:if="{{permissionType}}" class="consent-card {{confirmed ? 'is-confirmed' : ''}}" bindtap="toggleConfirmed">
        <view class="consent-check"><text wx:if="{{confirmed}}">✓</text></view>
        <view class="consent-copy">
          <text class="consent-title">声音使用确认</text>
          <text class="consent-text">{{consentText}}</text>
        </view>
      </view>

      <view class="privacy-card">
        <view class="privacy-lock"></view>
        <view><text>私有保存</text><text>声音样本与生成内容不会公开展示，可在设置中删除。</text></view>
      </view>

      <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

      <button class="primary-button submit-button {{submitting ? 'button-disabled' : ''}}" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? '正在提交并启动创建…' : '开始创建免费试听'}}
      </button>
      <text class="ai-note">生成内容会明确显示“AI生成”或“AI回复”标识。</text>
    </view>
  </view>
</view>
