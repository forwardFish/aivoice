<view class="screen profile-screen">
  <app-nav title="声音信息与授权" back="{{true}}"></app-nav>

  <view class="profile-content fade-in">
    <view class="intro-block">
      <text class="page-title">给这个声音起个名字</text>
      <text class="page-subtitle">仅用于创建私有 AI 声音和调整对话关系，不会公开展示。</text>
    </view>

    <view class="form-card glass-card">
      <view class="field-block">
        <text class="field-label">称呼这个声音</text>
        <input class="field-input" value="{{name}}" placeholder="如：小雨 · 5岁" maxlength="20" bindinput="onNameInput" />
      </view>

      <view class="field-block permission-block">
        <view class="permission-heading">
          <text class="field-label">声音使用权限</text>
          <text class="permission-help" bindtap="showRules">为什么需要授权？</text>
        </view>
        <view class="permission-list">
          <view wx:for="{{options}}" wx:key="key" class="permission-card {{permissionType === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="selectPermission">
            <view class="radio-dot"><view wx:if="{{permissionType === item.key}}" class="radio-inner"></view></view>
            <view class="permission-copy">
              <text class="permission-title">{{item.title}}</text>
              <text class="permission-description">{{item.description}}</text>
            </view>
            <view wx:if="{{permissionType === item.key}}" class="selected-check">✓</view>
          </view>
        </view>
      </view>

      <view wx:if="{{permissionType}}" class="field-block relationship-block">
        <view class="relationship-heading">
          <text class="field-label">TA 是你的谁</text>
          <text class="relationship-note">仅用于调整 AI 对话</text>
        </view>
        <radio-group class="relationship-grid" bindchange="onRelationshipRadioChange">
          <label
            wx:for="{{relationshipOptions}}"
            wx:key="key"
            class="relationship-option {{relationshipType === item.key ? 'selected' : ''}}"
          >
            <radio class="relationship-radio" value="{{item.key}}" checked="{{relationshipType === item.key}}" color="#6552f5" />
            <text>{{item.title}}</text>
          </label>
        </radio-group>
        <view wx:if="{{relationshipType === 'OTHER'}}" class="relationship-other-wrap">
          <input
            class="relationship-other-input"
            value="{{relationshipOther}}"
            placeholder="请输入关系，如：同学、老师、表姐"
            maxlength="10"
            bindinput="onRelationshipOtherInput"
          />
          <text class="relationship-other-count">{{relationshipOther.length}}/10</text>
        </view>
        <view wx:if="{{relationshipType && relationshipType !== 'SELF'}}" class="user-address-block">
          <view class="user-address-heading">
            <text class="user-address-label">TA 平时怎么称呼你？</text>
            <text class="user-address-optional">可选</text>
          </view>
          <text class="user-address-help">填写后，AI 回复时会自然地使用这个称呼。</text>
          <view class="relationship-other-wrap">
            <input
              class="relationship-other-input"
              value="{{userAddress}}"
              placeholder="例如：小林、妈妈、宝贝"
              maxlength="10"
              bindinput="onUserAddressInput"
            />
            <text class="relationship-other-count">{{userAddress.length}}/10</text>
          </view>
        </view>
      </view>

      <view wx:if="{{permissionType}}" class="consent-box" bindtap="toggleConfirmed">
        <view class="check-box {{confirmed ? 'checked' : ''}}"><text wx:if="{{confirmed}}">✓</text></view>
        <view class="consent-copy">
          <text class="consent-label">声音使用确认</text>
          <text class="consent-text">{{consentText}}</text>
        </view>
      </view>

      <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

      <button class="primary-button {{submitting ? 'button-disabled' : ''}}" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? '正在提交…' : '开始创建免费试听'}}
      </button>
      <text class="ai-note">AI 生成内容会显示“AI生成”或“AI回复”标识。</text>
    </view>
  </view>
</view>
