<view class="preview-screen screen-shell">
  <app-nav title="试听完成" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="state-wrap">
    <page-state mode="loading" title="正在准备试听" description="马上就能听见创建结果…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-wrap glass-card">
    <page-state mode="error" title="试听暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadPreview"></page-state>
  </view>

  <view wx:else class="preview-content fade-in">
    <text class="preview-subtitle">TA 的声音已为你生成</text>

    <view class="voice-visual">
      <view class="side-wave left-wave">
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-short"></view>
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-tall"></view>
      </view>
      <image wx:if="{{avatarUrl}}" class="avatar-core" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-core neutral-avatar"><image class="neutral-wave-image" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image></view>
      <view class="side-wave right-wave">
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-short"></view>
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-tall"></view>
      </view>
      <view class="visual-spark spark-a"></view>
      <view class="visual-spark spark-b"></view>
    </view>

    <text class="voice-name">{{voiceName}}</text>

    <view class="preview-card">
      <audio-player class="preview-player" src="{{audioUrl}}" durationMs="{{durationMs}}" label="点击播放试听" bindended="onPreviewEnded" bindunavailable="onPreviewUnavailable"></audio-player>
    </view>
    <text class="preview-copy">{{previewText}}</text>
    <text class="preview-status {{playCompleted ? 'is-complete' : ''}}">{{playCompleted ? '试听已完整播放，可以继续使用这个声音' : '请完整播放一次后再继续'}}</text>

    <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

    <button class="primary-button use-button {{!playCompleted || accepting ? 'button-disabled' : ''}}" bindtap="acceptPreview" disabled="{{!playCompleted || accepting}}">
      {{accepting ? '正在启用这个声音…' : '使用这个声音'}}
    </button>
    <button class="secondary-button retry-button" bindtap="retryPreview" disabled="{{retrying}}">
      {{retrying ? '正在重新创建…' : freeRetryRemaining > 0 ? '换一段重新创建（剩余 ' + freeRetryRemaining + ' 次）' : '换一段重新创建'}}
    </button>

    <text class="points-note">新账号赠送 5 个账号积分；后续 ¥9.9 购买 50 个账号积分。对话与“说一句”共享使用，不自动续费。</text>
  </view>
</view>
