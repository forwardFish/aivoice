<view class="preview-screen screen-shell">
  <app-nav title="试听完成" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="state-wrap">
    <page-state mode="loading" title="正在准备试听" description="马上就能听见创建结果…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-wrap glass-card">
    <page-state mode="error" title="试听暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="loadPreview"></page-state>
  </view>

  <view wx:else class="preview-content fade-in">
    <text class="preview-subtitle">TA 的声音已为你生成</text>

    <view class="voice-visual">
      <view class="visual-aura visual-aura-left"></view>
      <view class="visual-aura visual-aura-right"></view>
      <view class="side-wave left-wave">
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-short"></view>
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-mid"></view>
      </view>
      <view class="avatar-shell">
        <image wx:if="{{avatarUrl}}" class="avatar-core" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-core neutral-avatar">
          <image class="neutral-wave-image" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
        </view>
        <view class="avatar-glow"></view>
      </view>
      <view class="side-wave right-wave">
        <view class="wave-bar wave-mid"></view>
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-short"></view>
        <view class="wave-bar wave-tall"></view>
        <view class="wave-bar wave-mid"></view>
      </view>
      <view class="visual-spark spark-a"></view>
      <view class="visual-spark spark-b"></view>
    </view>

    <text class="voice-name">{{voiceName}}</text>

    <view class="preview-card glass-card {{playbackPrompted ? 'is-prompted' : ''}}">
      <audio-player id="previewPlayer" class="preview-player" src="{{audioUrl}}" durationMs="{{durationMs}}" label="点击播放试听" tag="AI生成" bindplay="onPreviewPlay" bindpause="onPreviewPause" bindended="onPreviewEnded" binderror="onPreviewError" bindunavailable="onPreviewUnavailable"></audio-player>
    </view>
    <text class="preview-copy">{{previewText}}</text>
    <text wx:if="{{!playCompleted}}" class="preview-status {{playbackPrompted ? 'is-prompted' : ''}}">{{previewPlaying ? '试听播放中，完整听完后即可使用' : '点击下方按钮会自动播放试听'}}</text>

    <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

    <view class="action-stack">
      <view
        role="button"
        aria-disabled="{{accepting}}"
        class="preview-action primary-button use-button {{accepting ? 'button-disabled' : ''}} {{playbackPrompted ? 'use-button-prompted' : ''}} {{!playCompleted ? 'use-button-listen-first' : ''}}"
        bindtap="acceptPreview"
      >
        <text>{{accepting ? '正在启用这个声音…' : playCompleted ? (trialEligible ? '使用这个声音，免费体验 1 次' : '使用这个声音') : '先听完，再使用这个声音'}}</text>
      </view>
      <view
        role="button"
        aria-disabled="{{retrying}}"
        class="preview-action retry-button {{retrying ? 'retry-button-disabled' : ''}}"
        bindtap="retryPreview"
      >
        <text class="retry-button-label">{{retrying ? '正在重新创建…' : '换一段重新创建'}}</text>
      </view>
      <text wx:if="{{!retrying && freeRetryRemaining > 0}}" class="retry-remaining">免费重新创建剩余 {{freeRetryRemaining}} 次</text>
    </view>
  </view>
</view>
