<view class="select-video-screen">
  <app-nav title="选择视频" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'uploading'}}" class="upload-state fade-in">
    <view class="upload-orb glass-card">
      <image class="upload-wave-image" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
      <text class="upload-percent">{{uploadProgress}}%</text>
    </view>
    <text class="upload-title">正在安全上传视频</text>
    <text class="upload-copy">只处理你主动选择的这一段视频，请暂时保持小程序在前台。</text>
    <view class="progress-track"><view class="progress-value" style="width: {{uploadProgress}}%;"></view></view>
  </view>

  <block wx:else>
    <view class="page-body fade-in">
      <view class="media-tabs">
        <button class="media-tab is-active" bindtap="openAlbumTab">相册</button>
        <view class="media-tab">视频</view>
      </view>

      <view class="media-browser">
        <view class="media-grid">
          <view wx:for="{{mediaTiles}}" wx:key="id" class="media-tile {{selected && selectedIndex === index ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="chooseVideo">
            <block wx:if="{{selected && selectedIndex === index}}">
              <image wx:if="{{selected.thumbTempFilePath}}" class="selected-media" src="{{selected.thumbTempFilePath}}" mode="aspectFill"></image>
              <video wx:else class="selected-media" src="{{selected.tempFilePath}}" controls="{{false}}" muted="{{true}}" show-center-play-btn="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover"></video>
              <view class="media-shade"></view>
              <view class="duration-chip">{{selected.durationText}}</view>
              <view class="selection-circle is-selected">✓</view>
            </block>
            <block wx:else>
              <view class="neutral-scene scene-{{item.scene}}"><view class="scene-orb"></view><view class="scene-line line-a"></view><view class="scene-line line-b"></view></view>
              <view class="selection-circle"></view>
            </block>
          </view>
        </view>
      </view>

      <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>
    </view>

    <bottom-action-bar layout="row" minHeight="{{148}}" actionWidth="{{204}}" custom-class="selection-footer">
      <view slot="leading" wx:if="{{selected}}" class="selected-summary">
        <view class="summary-copy"><text class="summary-title">已选择 1 个视频</text></view>
        <app-icon-button label="清除选择" size="52" bindaction="resetSelection" custom-class="summary-clear">×</app-icon-button>
      </view>
      <view slot="leading" wx:else class="selected-summary">
        <view class="summary-copy"><text class="summary-title">请选择 1 个视频</text><text class="summary-meta">支持 8–60 秒，最大 100MB</text></view>
      </view>
      <app-button slot="action" wx:if="{{selected}}" label="下一步" bindaction="uploadAndContinue"></app-button>
      <app-button slot="action" wx:else label="选择视频" bindaction="chooseVideo"></app-button>
    </bottom-action-bar>
  </block>
</view>
