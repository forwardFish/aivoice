<view class="login-screen">
  <app-nav title="登录" back="{{true}}" transparent="{{true}}"></app-nav>

  <view class="login-aurora aurora-left"></view>
  <view class="login-aurora aurora-right"></view>

  <view wx:if="{{success}}" class="login-success">
    <page-state mode="success" title="登录成功" description="正在进入那年的TA…"></page-state>
  </view>

  <view wx:else class="login-content fade-in">
    <view class="login-main">
      <image class="login-memory" src="/assets/ui/hero-memory.png" mode="aspectFit"></image>
      <view class="login-copy">
        <text class="login-brand">那年的TA</text>
        <text class="login-tagline">把记忆里的声音，轻轻留住</text>
      </view>
    </view>

    <view class="login-footer">
      <text wx:if="{{errorMessage}}" class="login-error">{{errorMessage}}</text>
      <button
        class="wechat-login-button {{loading ? 'button-disabled' : ''}}"
        bindtap="submitLogin"
        disabled="{{loading}}"
      >
        <image class="wechat-mark" src="/assets/ui/wechat-mark.png" mode="aspectFit"></image>
        <text>{{loading ? '登录中…' : '微信一键登录'}}</text>
      </button>

      <view class="agreement-row">
        <text>登录即代表你已阅读并同意</text>
        <text class="agreement-link" data-type="terms" catchtap="showAgreement">《用户协议》</text>
        <text>和</text>
        <text class="agreement-link" data-type="privacy" catchtap="showAgreement">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
