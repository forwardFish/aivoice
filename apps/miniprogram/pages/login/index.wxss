.login-screen {
  height: 100vh;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 88% 18%, rgba(184, 164, 255, 0.20), transparent 30%),
    radial-gradient(circle at 8% 78%, rgba(221, 211, 255, 0.22), transparent 34%),
    linear-gradient(180deg, #fafbff 0%, #f8f7ff 52%, #fdfcff 100%);
}

.login-aurora {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(16rpx);
}

.aurora-left {
  left: -170rpx;
  top: 300rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(255, 225, 178, 0.18), transparent 72%);
}

.aurora-right {
  right: -180rpx;
  top: 420rpx;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(152, 121, 255, 0.18), transparent 72%);
}

.login-content {
  flex: 1;
  min-height: 0;
  position: relative;
  z-index: 2;
  padding: 0 70rpx calc(92rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.login-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 18rpx;
}

.login-memory {
  width: 680rpx;
  height: 680rpx;
  max-width: none;
  flex: 0 0 auto;
  transform: translateY(-36rpx);
}

.login-copy {
  margin-top: -96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-brand {
  color: #554ab0;
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.login-tagline {
  margin-top: 22rpx;
  color: #727a9c;
  font-size: 27rpx;
  line-height: 1.55;
  letter-spacing: 0.8rpx;
}

.login-footer {
  flex: 0 0 auto;
  padding-top: 42rpx;
}

.login-error {
  display: block;
  margin: 0 auto 22rpx;
  padding: 17rpx 22rpx;
  border: 1rpx solid rgba(232, 142, 151, 0.34);
  border-radius: 22rpx;
  color: #bc5563;
  background: rgba(255, 243, 245, 0.92);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.wechat-login-button {
  width: 100% !important;
  min-width: 100%;
  min-height: 112rpx;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 32rpx;
  border: 0;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #31d34d 0%, #20c243 100%);
  box-shadow: 0 20rpx 42rpx rgba(42, 183, 74, 0.20), inset 0 2rpx 0 rgba(255, 255, 255, 0.24);
  font-size: 34rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.wechat-login-button::after { border: 0; }

.wechat-mark {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
}

.button-disabled {
  opacity: 0.68;
  box-shadow: none;
}

.agreement-row {
  margin-top: 52rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  color: #7b83a0;
  font-size: 20rpx;
  line-height: 1.65;
  text-align: center;
}

.agreement-link {
  color: #6552f5;
  font-weight: 600;
}

.login-success {
  position: relative;
  z-index: 3;
  padding-top: 180rpx;
}

@media (max-height: 740px) {
  .login-content { padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); }
  .login-main { padding-top: 0; }
  .login-memory { width: 520rpx; height: 520rpx; transform: translateY(-20rpx); }
  .login-copy { margin-top: -72rpx; }
  .login-brand { font-size: 58rpx; }
  .login-tagline { margin-top: 16rpx; font-size: 24rpx; }
  .login-footer { padding-top: 24rpx; }
  .wechat-login-button { min-height: 98rpx; font-size: 31rpx; }
  .agreement-row { margin-top: 30rpx; font-size: 19rpx; }
}
