.login-screen {
  min-height: 100vh;
  padding: 0 42rpx calc(50rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 18% 18%, rgba(117, 155, 255, 0.18), transparent 28%),
    radial-gradient(circle at 82% 20%, rgba(172, 126, 255, 0.18), transparent 30%),
    #f8f8ff;
}

.login-content {
  padding-top: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  width: 144rpx;
  height: 144rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 30% 24%, #ffffff, #e4e0ff 58%, #cddcff);
  box-shadow: 0 26rpx 70rpx rgba(94, 78, 226, 0.22);
}

.brand-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.brand-wave text {
  width: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #9c8eff, #5f52f5);
}

.brand-wave text:nth-child(1) { height: 34rpx; }
.brand-wave text:nth-child(2) { height: 54rpx; }
.brand-wave text:nth-child(3) { height: 78rpx; }
.brand-wave text:nth-child(4) { height: 54rpx; }
.brand-wave text:nth-child(5) { height: 34rpx; }

.login-title {
  margin-top: 34rpx;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 750;
  color: #11172d;
}

.login-subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #737b94;
}

.login-card {
  width: 100%;
  margin-top: 68rpx;
  padding: 42rpx 34rpx 36rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #11172d;
}

.card-caption {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7e859c;
}

.profile-row {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-picker {
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #efedff;
}

.avatar-image,
.avatar-placeholder {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #6552f5;
}

.nickname-wrap {
  flex: 1;
  min-width: 0;
}

.mini-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: #737b94;
}

.nickname-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e7e8f2;
  background: #fafaff;
  color: #11172d;
  font-size: 28rpx;
}

.agreement-row {
  margin-top: 34rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.check-box {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  border: 2rpx solid #c6cad9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
}

.check-box.checked {
  border-color: #6552f5;
  background: #6552f5;
}

.agreement-copy {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.65;
  color: #737b94;
}

.agreement-link {
  color: #6552f5;
}

.login-error {
  display: block;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fff0f1;
  color: #c9515b;
  font-size: 23rpx;
  line-height: 1.5;
}

.login-button {
  margin-top: 32rpx;
}

.trust-line {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #858ca2;
  font-size: 23rpx;
}

.trust-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #55bb76;
  box-shadow: 0 0 0 8rpx rgba(85, 187, 118, 0.12);
}

.login-success {
  padding-top: 120rpx;
}
