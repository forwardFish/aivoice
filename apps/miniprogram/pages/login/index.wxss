.login-screen {
  min-height: 100vh;
  overflow: hidden;
  padding: 0 42rpx calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 18% 14%, rgba(230, 223, 255, 0.72), transparent 28%),
    radial-gradient(circle at 86% 8%, rgba(210, 217, 255, 0.72), transparent 28%),
    radial-gradient(circle at 12% 96%, rgba(229, 214, 255, 0.52), transparent 20%),
    linear-gradient(180deg, #fbfbff 0%, #f7f7ff 50%, #f9f8ff 100%);
}

.login-content {
  position: relative;
  min-height: calc(100vh - 120rpx);
  padding-top: 84rpx;
  display: flex;
  flex-direction: column;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 420rpx;
  padding-top: 80rpx;
}

.login-title {
  display: block;
  color: #132047;
  font-family: "Songti SC", "STSong", serif;
  font-size: 72rpx;
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -1.6rpx;
}

.login-subtitle {
  display: block;
  margin-top: 22rpx;
  color: #6b7393;
  font-size: 30rpx;
  line-height: 1.6;
}

.hero-visual {
  position: absolute;
  top: 86rpx;
  right: -16rpx;
  width: 386rpx;
}

.hero-card {
  width: 386rpx;
}

.welcome-copy {
  margin-top: 372rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-title {
  color: #132047;
  font-family: "Songti SC", "STSong", serif;
  font-size: 62rpx;
  line-height: 1.14;
  font-weight: 700;
}

.welcome-subtitle {
  margin-top: 26rpx;
  color: #7b82a0;
  font-size: 28rpx;
}

.login-button {
  width: 100%;
  height: 102rpx;
  margin-top: 74rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #a98cff 0%, #7f7dff 55%, #647cff 100%);
  box-shadow: 0 24rpx 50rpx rgba(111, 101, 245, 0.24);
  font-size: 34rpx;
  font-weight: 600;
}

.login-button::after {
  border: none;
}

.wechat-mark {
  position: relative;
  width: 58rpx;
  height: 42rpx;
}

.wechat-bubble {
  position: absolute;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
}

.wechat-bubble::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  width: 10rpx;
  height: 10rpx;
  background: inherit;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.wechat-bubble.large {
  left: 0;
  bottom: 0;
  width: 34rpx;
  height: 28rpx;
}

.wechat-bubble.large::after {
  left: 8rpx;
}

.wechat-bubble.small {
  right: 0;
  top: 2rpx;
  width: 28rpx;
  height: 24rpx;
  opacity: 0.92;
}

.wechat-bubble.small::after {
  right: 6rpx;
}

.login-error {
  display: block;
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 240, 241, 0.9);
  color: #c9515b;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.agreement-row {
  margin-top: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 0 14rpx;
}

.agreement-circle {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #c6cad9;
  background: rgba(255, 255, 255, 0.86);
}

.agreement-circle.checked {
  border-color: #6552f5;
  background:
    radial-gradient(circle at center, #6552f5 0 42%, transparent 43%);
}

.agreement-copy {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.7;
  color: #737b94;
}

.agreement-link {
  color: #6552f5;
}

.login-clouds {
  position: absolute;
  left: -30rpx;
  right: -30rpx;
  bottom: -28rpx;
  height: 250rpx;
  pointer-events: none;
}

.cloud {
  position: absolute;
  bottom: 0;
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.74) 68%, rgba(236, 232, 255, 0.42) 100%);
  filter: blur(2rpx);
}

.cloud-left {
  left: -40rpx;
  width: 300rpx;
  height: 120rpx;
}

.cloud-center {
  left: 190rpx;
  width: 340rpx;
  height: 138rpx;
}

.cloud-right {
  right: -34rpx;
  width: 260rpx;
  height: 110rpx;
}

.login-success {
  padding-top: 120rpx;
}
