.login-screen {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 7%, rgba(204,197,255,.38), transparent 25%),
    radial-gradient(circle at 4% 92%, rgba(225,200,255,.34), transparent 29%),
    linear-gradient(158deg,#fafbff 0%,#f7f6ff 42%,#fbf9ff 72%,#f6edff 100%);
}

.login-aurora { position:absolute; border-radius:50%; pointer-events:none; filter:blur(3rpx); }
.aurora-a { width:420rpx; height:360rpx; right:-176rpx; top:100rpx; background:radial-gradient(circle,rgba(179,160,255,.23),transparent 68%); }
.aurora-b { width:520rpx; height:400rpx; left:-220rpx; bottom:-110rpx; background:radial-gradient(circle,rgba(203,169,255,.26),transparent 68%); }
.login-clouds { height:230rpx; position:absolute; left:-40rpx; right:-40rpx; bottom:-35rpx; opacity:.63; background:
  radial-gradient(ellipse at 6% 90%,rgba(255,255,255,.95) 0 18%,transparent 19%),
  radial-gradient(ellipse at 22% 86%,rgba(255,255,255,.9) 0 24%,transparent 25%),
  radial-gradient(ellipse at 43% 94%,rgba(255,255,255,.94) 0 23%,transparent 24%),
  radial-gradient(ellipse at 68% 86%,rgba(255,255,255,.9) 0 23%,transparent 24%),
  radial-gradient(ellipse at 91% 93%,rgba(255,255,255,.96) 0 25%,transparent 26%);
}

.login-spark { width:7rpx; height:7rpx; position:absolute; border-radius:50%; background:#fff; box-shadow:0 0 18rpx rgba(255,229,172,.95); transform:rotate(45deg); }
.login-spark::before,
.login-spark::after { content:''; position:absolute; left:50%; top:50%; border-radius:999rpx; background:rgba(255,255,255,.94); transform:translate(-50%,-50%); }
.login-spark::before { width:3rpx; height:27rpx; }
.login-spark::after { width:27rpx; height:3rpx; }
.spark-a { left:76rpx; top:134rpx; }
.spark-b { right:66rpx; top:75rpx; transform:scale(.7) rotate(45deg); }
.spark-c { left:54rpx; top:850rpx; transform:scale(.55) rotate(45deg); }
.spark-d { right:88rpx; bottom:118rpx; transform:scale(.75) rotate(45deg); }

.login-content { position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; }
.login-hero { width:100%; height:500rpx; position:relative; }
.login-brand-copy { position:absolute; z-index:3; left:24rpx; top:150rpx; }
.login-title { display:block; color:#0d1e4a; font-family:Georgia,"Songti SC","STSong",serif; font-size:72rpx; line-height:1.08; font-weight:720; letter-spacing:1rpx; }
.login-subtitle { display:block; margin-top:30rpx; color:#52658d; font-size:28rpx; letter-spacing:1rpx; }
.login-memory { width:430rpx; height:430rpx; position:absolute; z-index:2; right:-108rpx; top:0; opacity:.82; }

.welcome-block { margin-top:72rpx; display:flex; flex-direction:column; align-items:center; text-align:center; }
.welcome-title { color:#102756; font-size:43rpx; line-height:1.25; font-weight:720; letter-spacing:1rpx; }
.welcome-subtitle { margin-top:26rpx; color:#607098; font-size:29rpx; letter-spacing:1rpx; }

.wechat-login-button { width:590rpx; height:112rpx; margin-top:68rpx; padding:0 42rpx; border:2rpx solid rgba(255,255,255,.78); border-radius:58rpx; display:flex; align-items:center; justify-content:center; gap:23rpx; color:#fff; background:linear-gradient(100deg,#ac7cf7 0%,#765cf5 48%,#6b64ef 100%); box-shadow:0 24rpx 54rpx rgba(111,83,235,.26),inset 0 2rpx 4rpx rgba(255,255,255,.34); font-size:38rpx; font-weight:560; }
.wechat-login-button::after { border:0; }
.wechat-mark { width:66rpx; height:54rpx; flex:0 0 auto; }

.agreement-row { width:610rpx; margin-top:42rpx; display:flex; align-items:center; justify-content:center; gap:15rpx; }
.check-box { flex:0 0 auto; width:38rpx; height:38rpx; border:3rpx solid #8b95aa; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:24rpx; }
.check-box.checked { border-color:#6552f5; background:#6552f5; }
.agreement-copy { color:#30384d; font-size:22rpx; line-height:1.6; white-space:nowrap; }
.agreement-link { color:#4e36ef; }

.login-error { width:590rpx; margin-top:30rpx; padding:17rpx 22rpx; border-radius:18rpx; background:rgba(255,238,241,.9); color:#c9515b; font-size:22rpx; line-height:1.45; text-align:center; }
.login-success { position:relative; z-index:3; padding-top:170rpx; }

@media (max-height:740px) {
  .login-hero { height:410rpx; }
  .login-brand-copy { top:105rpx; }
  .login-title { font-size:62rpx; }
  .login-subtitle { margin-top:20rpx; font-size:24rpx; }
  .login-memory { width:360rpx; height:360rpx; right:-80rpx; }
  .welcome-block { margin-top:35rpx; }
  .welcome-title { font-size:37rpx; }
  .welcome-subtitle { margin-top:16rpx; font-size:25rpx; }
  .wechat-login-button { height:98rpx; margin-top:42rpx; }
  .agreement-row { margin-top:28rpx; }
}
