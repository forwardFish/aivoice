.home-screen {
  min-height: 100vh;
  padding: 0 34rpx calc(180rpx + env(safe-area-inset-bottom));
}

.hero-section {
  position: relative;
  min-height: 416rpx;
  padding-top: 24rpx;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 392rpx;
  padding-top: 92rpx;
}

.brand-title {
  display: block;
  color: #132047;
  font-family: "Songti SC", "STSong", serif;
  font-size: 72rpx;
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -1.6rpx;
}

.brand-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #6b7393;
  font-size: 30rpx;
  line-height: 1.6;
}

.hero-visual {
  position: absolute;
  top: 6rpx;
  right: -4rpx;
  width: 350rpx;
}

.hero-menu {
  position: absolute;
  top: 2rpx;
  right: 0;
  width: 74rpx;
  height: 74rpx;
  z-index: 2;
}

.hero-card {
  width: 340rpx;
  margin-top: 64rpx;
  margin-left: 8rpx;
}

.create-card {
  min-height: 236rpx;
  padding: 34rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.create-icon {
  position: relative;
  flex: 0 0 auto;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 28%, rgba(255, 255, 255, 0.96), rgba(164, 138, 255, 0.74) 58%, rgba(107, 91, 243, 1) 100%);
  box-shadow:
    0 12rpx 32rpx rgba(121, 104, 247, 0.22),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.84);
}

.create-plus {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  transform: translate(-50%, -50%);
}

.create-plus.horizontal {
  width: 48rpx;
  height: 6rpx;
}

.create-plus.vertical {
  width: 6rpx;
  height: 48rpx;
}

.create-copy {
  flex: 1;
  min-width: 0;
}

.create-title {
  display: block;
  color: #12204a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
}

.create-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #747b99;
  font-size: 28rpx;
  line-height: 1.52;
}

.create-arrow {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
}

.home-state {
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.empty-section,
.recent-section {
  margin-top: 52rpx;
}

.empty-card {
  padding: 46rpx 42rpx 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-illustration {
  width: 196rpx;
  height: 196rpx;
}

.empty-title {
  margin-top: 10rpx;
  color: #12204a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 16rpx;
  color: #7b829f;
  font-size: 26rpx;
  line-height: 1.64;
}

.empty-action {
  margin-top: 28rpx;
}

.section-row {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #12204a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 62rpx;
  line-height: 1.08;
  font-weight: 700;
}

.section-link-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 0 12rpx 20rpx;
}

.section-link,
.section-link-arrow {
  color: #8b90ab;
  font-size: 28rpx;
  line-height: 1;
}

.voice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.voice-card {
  min-height: 160rpx;
  padding: 24rpx 22rpx 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.voice-avatar {
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f0f1fb;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.84);
}

.voice-copy {
  flex: 0 0 172rpx;
  min-width: 0;
}

.voice-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #17224a;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 700;
}

.voice-date {
  display: block;
  margin-top: 10rpx;
  color: #8187a2;
  font-size: 24rpx;
  line-height: 1.3;
}

.voice-audio {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-right: 4rpx;
}

.voice-waveform {
  flex: 1;
  min-width: 0;
  height: 34rpx;
}

.voice-duration {
  flex: 0 0 auto;
  color: #747c98;
  font-size: 24rpx;
  line-height: 1;
}

.voice-play {
  flex: 0 0 auto;
  width: 70rpx;
  height: 70rpx;
}

.voice-more {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
}

.privacy-note {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #8f94aa;
  font-size: 23rpx;
  line-height: 1.5;
}

.privacy-lock {
  position: relative;
  width: 20rpx;
  height: 16rpx;
  border: 3rpx solid #7f71ff;
  border-radius: 4rpx;
}

.privacy-lock::before {
  content: '';
  position: absolute;
  left: 3rpx;
  bottom: 14rpx;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid #7f71ff;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
}
