.home-screen {
  min-height: 100vh;
  padding: 0 34rpx 44rpx;
}

.home-header {
  padding: 26rpx 4rpx 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 750;
  color: #11172d;
}

.brand-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #737b94;
}

.header-orb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 32% 25%, #ffffff, #e6e2ff 62%, #cedcff);
  box-shadow: 0 18rpx 42rpx rgba(101, 82, 245, 0.18);
}

.mini-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.mini-wave text {
  width: 5rpx;
  border-radius: 999rpx;
  background: #6552f5;
}
.mini-wave text:nth-child(1) { height: 18rpx; }
.mini-wave text:nth-child(2) { height: 30rpx; }
.mini-wave text:nth-child(3) { height: 42rpx; }
.mini-wave text:nth-child(4) { height: 30rpx; }
.mini-wave text:nth-child(5) { height: 18rpx; }

.create-card {
  min-height: 188rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(243, 240, 255, 0.96));
}

.create-icon {
  flex: 0 0 auto;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6552f5;
  font-size: 58rpx;
  font-weight: 300;
  background: rgba(101, 82, 245, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(101, 82, 245, 0.08);
}

.create-copy {
  flex: 1;
  min-width: 0;
}

.create-title {
  display: block;
  font-size: 35rpx;
  font-weight: 700;
  color: #6552f5;
}

.create-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #737b94;
}

.create-arrow {
  flex: 0 0 auto;
  font-size: 54rpx;
  color: #9a91e8;
}

.home-state {
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.new-user,
.recent-section {
  margin-top: 46rpx;
}

.section-row {
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-link {
  color: #6552f5;
  font-size: 25rpx;
  padding: 12rpx;
}

.steps-card {
  padding: 34rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-index {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #6552f5, #9a72f6);
  font-size: 23rpx;
  font-weight: 650;
}

.step-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: #11172d;
}

.step-copy {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8b91a6;
}

.step-line {
  width: 44rpx;
  height: 2rpx;
  margin-top: -30rpx;
  background: linear-gradient(90deg, #dcd8ff, #efedff);
}

.empty-tip,
.trust-note {
  margin-top: 30rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #858ca2;
  font-size: 23rpx;
  line-height: 1.6;
}

.lock-mark {
  flex: 0 0 auto;
  width: 26rpx;
  height: 22rpx;
  margin-top: 5rpx;
  border: 3rpx solid #55b979;
  border-radius: 5rpx;
  position: relative;
}

.lock-mark::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: -18rpx;
  width: 12rpx;
  height: 15rpx;
  border: 3rpx solid #55b979;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
}

.voice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.voice-card {
  min-height: 134rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.voice-avatar {
  flex: 0 0 auto;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #efedff;
}

.voice-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 650;
  background: linear-gradient(135deg, #8b7af6, #627edb);
}

.voice-info {
  flex: 1;
  min-width: 0;
}

.voice-name {
  display: block;
  font-size: 30rpx;
  font-weight: 650;
  color: #11172d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voice-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #858ca2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.continue-button {
  flex: 0 0 auto;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  color: #6552f5;
  background: #efedff;
  font-size: 24rpx;
  font-weight: 600;
}

.continue-button::after { border: none; }

.trust-check {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #55b979;
  font-size: 20rpx;
}
