.home-screen { min-height:100vh; padding:0 34rpx calc(38rpx + env(safe-area-inset-bottom)); }
.hero { height:318rpx; padding:44rpx 8rpx 0; position:relative; }
.hero-copy { position:relative; z-index:3; padding-top:24rpx; }
.brand-title { display:block; color:#11172d; font-family:Georgia,"Songti SC","STSong",serif; font-size:60rpx; line-height:1.1; font-weight:720; letter-spacing:1rpx; }
.brand-subtitle { display:block; margin-top:20rpx; color:#747b93; font-size:27rpx; letter-spacing:1rpx; }
.hero-memory { width:350rpx; height:300rpx; position:absolute; z-index:2; top:0; right:-36rpx; opacity:.76; filter:saturate(.84); }
.hero::after { content:''; width:300rpx; height:180rpx; position:absolute; top:78rpx; right:-4rpx; z-index:1; border-radius:50%; background:radial-gradient(circle,rgba(166,147,255,.26),rgba(166,147,255,0)); }
.hero-spark { position:absolute; z-index:3; width:9rpx; height:9rpx; border-radius:50%; background:#fff; box-shadow:0 0 18rpx rgba(255,225,160,.96); }
.hero-spark-a{right:292rpx;top:56rpx}.hero-spark-b{right:22rpx;top:224rpx;width:6rpx;height:6rpx}
.create-card { min-height:206rpx; padding:30rpx 28rpx 30rpx 24rpx; border-radius:42rpx; display:flex; align-items:center; gap:18rpx; position:relative; overflow:hidden; }
.create-card::before { content:''; width:250rpx; height:250rpx; position:absolute; right:-60rpx; top:-100rpx; border-radius:50%; background:radial-gradient(circle,rgba(188,173,255,.22),rgba(188,173,255,0)); }
.create-icon { flex:0 0 auto; width:116rpx; height:116rpx; position:relative; z-index:1; }
.create-copy { flex:1; min-width:0; position:relative; z-index:1; }
.create-title { display:block; color:#141a32; font-size:36rpx; font-weight:740; }
.create-subtitle { display:block; margin-top:16rpx; color:#737b94; font-size:25rpx; }
.create-arrow { flex:0 0 auto; width:88rpx; height:88rpx; position:relative; z-index:1; }
.home-state { margin-top:40rpx; border-radius:34rpx; overflow:hidden; }
.empty-section,.recent-section { margin-top:52rpx; }
.section-row { min-height:56rpx; margin:0 6rpx 22rpx; display:flex; align-items:center; justify-content:space-between; }
.section-title { font-family:Georgia,"Songti SC","STSong",serif; font-size:40rpx; font-weight:720; }
.section-link { padding:12rpx 0 12rpx 20rpx; color:#777e98; font-size:24rpx; }
.empty-card { padding:42rpx 42rpx 40rpx; border-radius:36rpx; display:flex; flex-direction:column; align-items:center; text-align:center; }
.empty-wave-image { width:190rpx; height:82rpx; opacity:.63; }
.empty-title { margin-top:16rpx; color:#171d34; font-size:31rpx; font-weight:700; }
.empty-copy { max-width:520rpx; margin-top:14rpx; color:#7d849c; font-size:24rpx; line-height:1.7; }
.empty-action { min-width:280rpx; height:78rpx; margin-top:30rpx; padding:0 30rpx; border-radius:24rpx; color:#fff; background:linear-gradient(135deg,#6253f5,#8b69f5); box-shadow:0 16rpx 32rpx rgba(101,82,245,.20); font-size:25rpx; font-weight:660; }
.voice-list { display:flex; flex-direction:column; gap:18rpx; }
.voice-card { min-height:126rpx; padding:18rpx 14rpx 18rpx 18rpx; border-radius:32rpx; display:flex; align-items:center; gap:16rpx; overflow:hidden; }
.voice-avatar { flex:0 0 auto; width:88rpx; height:88rpx; border-radius:50%; border:3rpx solid rgba(255,255,255,.92); box-shadow:0 9rpx 24rpx rgba(58,62,94,.13); background:#ecebff; }
.voice-avatar.fallback { display:flex; align-items:center; justify-content:center; color:#fff; background:linear-gradient(145deg,#8e7af5,#5979d5); font-size:32rpx; font-weight:700; }
.voice-info { flex:1; min-width:112rpx; }
.voice-name { display:block; overflow:hidden; color:#141a31; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.voice-meta { display:block; max-width:210rpx; margin-top:9rpx; overflow:hidden; color:#838aa1; font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }
.voice-wave { flex:0 0 auto; width:116rpx; height:56rpx; opacity:.48; }
.voice-points { flex:0 0 auto; max-width:88rpx; color:#77809a; font-size:19rpx; line-height:1.3; text-align:center; }
.voice-play { flex:0 0 auto; width:70rpx; height:70rpx; }
.voice-more { flex:0 0 auto; width:16rpx; height:44rpx; margin-left:-4rpx; opacity:.56; }
.privacy-note { margin:28rpx 8rpx 0; display:flex; align-items:center; justify-content:center; gap:13rpx; color:#8a90a5; font-size:21rpx; line-height:1.5; text-align:center; }
.privacy-lock { width:21rpx; height:17rpx; position:relative; border:3rpx solid #7f72eb; border-radius:4rpx; }
.privacy-lock::before { content:''; width:10rpx; height:10rpx; position:absolute; left:3rpx; top:-12rpx; border:3rpx solid #7f72eb; border-bottom:0; border-radius:10rpx 10rpx 0 0; }
@media (max-width:350px){.hero-memory{width:310rpx;right:-54rpx}.voice-wave{width:88rpx}.voice-points{display:none}}
