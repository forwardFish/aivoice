<view class="home-screen">
  <app-nav transparent="{{true}}"></app-nav>

  <view class="home-header fade-in">
    <view>
      <text class="brand-title">那时的 TA</text>
      <text class="brand-subtitle">用声音，找回记忆里的 TA</text>
    </view>
    <view class="header-orb">
      <view class="mini-wave"><text></text><text></text><text></text><text></text><text></text></view>
    </view>
  </view>

  <view class="create-card glass-card fade-in" bindtap="createVoice">
    <view class="create-icon">+</view>
    <view class="create-copy">
      <text class="create-title">创建新声音</text>
      <text class="create-subtitle">从相册视频中提取 TA 的声音</text>
    </view>
    <view class="create-arrow">›</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-state">
    <page-state mode="loading" compact="{{true}}" title="正在加载声音" description="正在获取最近可用的私有声音…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-state soft-card">
    <page-state mode="error" compact="{{true}}" title="首页暂时无法加载" description="{{errorMessage}}" actionText="重新加载" bindaction="loadHome"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="new-user fade-in">
    <view class="section-row">
      <text class="section-title">只需三步</text>
    </view>
    <view class="steps-card soft-card">
      <view class="step-item">
        <text class="step-index">1</text>
        <text class="step-title">选视频</text>
        <text class="step-copy">12–60 秒</text>
      </view>
      <view class="step-line"></view>
      <view class="step-item">
        <text class="step-index">2</text>
        <text class="step-title">截声音</text>
        <text class="step-copy">10–30 秒</text>
      </view>
      <view class="step-line"></view>
      <view class="step-item">
        <text class="step-index">3</text>
        <text class="step-title">开始体验</text>
        <text class="step-copy">试听后使用</text>
      </view>
    </view>
    <view class="empty-tip">
      <view class="lock-mark"></view>
      <text>私有声音，仅自己可用，可随时删除</text>
    </view>
  </view>

  <view wx:else class="recent-section fade-in">
    <view class="section-row">
      <text class="section-title">最近的声音</text>
      <text class="section-link" bindtap="createVoice">新建声音</text>
    </view>
    <view class="voice-list">
      <view wx:for="{{voices}}" wx:key="id" class="voice-card soft-card" data-id="{{item.id}}" bindtap="openVoice">
        <image wx:if="{{item.avatarUrl}}" class="voice-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="voice-avatar fallback">{{item.initial}}</view>
        <view class="voice-info">
          <text class="voice-name">{{item.name}}</text>
          <text class="voice-meta">{{item.lastUsedText}} · {{item.quotaText}}</text>
        </view>
        <button class="continue-button" data-id="{{item.id}}" catchtap="openVoice">继续对话</button>
      </view>
    </view>
    <view class="trust-note">
      <view class="trust-check">✓</view>
      <text>首页只展示已可用的声音；处理任务请在“我的声音”查看。</text>
    </view>
  </view>
</view>
