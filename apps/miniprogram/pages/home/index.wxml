<view class="home-screen">
  <app-nav transparent="{{true}}"></app-nav>

  <view class="hero-section fade-in">
    <view class="hero-copy">
      <text class="brand-title">那时的TA</text>
      <text class="brand-subtitle">把记忆里的声音，轻轻留住</text>
    </view>
    <view class="hero-visual">
      <image class="hero-menu" src="/assets/ui/more-circle.png" mode="aspectFit"></image>
      <image class="hero-card" src="/assets/ui/home-hero-card.png" mode="widthFix"></image>
    </view>
  </view>

  <view class="create-card glass-card fade-in" bindtap="createVoice">
    <view class="create-icon">
      <view class="create-plus horizontal"></view>
      <view class="create-plus vertical"></view>
    </view>
    <view class="create-copy">
      <text class="create-title">创建新声音</text>
      <text class="create-subtitle">从旧视频中提取 TA 的声音</text>
    </view>
    <image class="create-arrow" src="/assets/ui/arrow-circle.png" mode="aspectFit"></image>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-state">
    <page-state mode="loading" compact="{{true}}" title="正在加载声音" description="正在获取最近可用的私有声音…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-state soft-card">
    <page-state mode="error" compact="{{true}}" title="首页暂时无法加载" description="{{errorMessage}}" actionText="重新加载" bindaction="loadHome"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="empty-section fade-in">
    <view class="empty-card glass-card">
      <image class="empty-illustration" src="/assets/ui/shopping-bag.png" mode="aspectFit"></image>
      <text class="empty-title">还没有创建好的声音</text>
      <text class="empty-copy">先从相册里选择一段视频，我们会帮你把记忆里的声音轻轻留住。</text>
      <button class="primary-button empty-action" bindtap="createVoice">开始创建</button>
    </view>
  </view>

  <view wx:else class="recent-section fade-in">
    <view class="section-row">
      <text class="section-title">最近的声音</text>
      <view class="section-link-wrap" bindtap="openAllVoices">
        <text class="section-link">全部</text>
        <text class="section-link-arrow">›</text>
      </view>
    </view>

    <view class="voice-list">
      <view wx:for="{{voices}}" wx:key="id" class="voice-card glass-card" data-id="{{item.id}}" bindtap="openVoice">
        <image class="voice-avatar" src="{{item.displayAvatar}}" mode="aspectFill"></image>
        <view class="voice-copy">
          <text class="voice-name">{{item.name}}</text>
          <text class="voice-date">{{item.lastUsedText}}</text>
        </view>
        <view class="voice-audio">
          <image class="voice-waveform" src="/assets/ui/waveform.png" mode="aspectFit"></image>
          <text wx:if="{{item.durationText}}" class="voice-duration">{{item.durationText}}</text>
        </view>
        <image class="voice-play" src="/assets/ui/play-circle.png" mode="aspectFit" data-id="{{item.id}}" catchtap="openVoice"></image>
        <image class="voice-more" src="/assets/ui/more-plain.png" mode="aspectFit" data-id="{{item.id}}" catchtap="openVoiceMenu"></image>
      </view>
    </view>

    <view class="privacy-note">
      <view class="privacy-lock"></view>
      <text>声音仅本人可见；处理任务请到“我的声音”查看</text>
    </view>
  </view>
</view>
