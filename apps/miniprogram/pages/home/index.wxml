<view class="home-screen screen-shell">
  <app-nav transparent="{{true}}"></app-nav>

  <view class="hero fade-in">
    <view class="hero-copy">
      <text class="brand-title">那时的TA</text>
      <text class="brand-subtitle">把记忆里的声音，轻轻留住</text>
    </view>
    <view class="hero-memory ui-sprite sprite-memory"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
    <view class="hero-spark hero-spark-a"></view>
    <view class="hero-spark hero-spark-b"></view>
  </view>

  <view class="create-card luminous-card float-in" bindtap="createVoice">
    <view class="create-icon ui-sprite sprite-add"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
    <view class="create-copy">
      <text class="create-title">创建新声音</text>
      <text class="create-subtitle">从旧视频中提取 TA 的声音</text>
    </view>
    <view class="create-arrow ui-sprite sprite-arrow"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-state glass-card fade-in">
    <page-state mode="loading" compact="{{true}}" title="正在加载声音" description="正在获取最近可用的私有声音…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-state glass-card fade-in">
    <page-state mode="error" compact="{{true}}" title="首页暂时无法加载" description="{{errorMessage}}" actionText="重新加载" bindaction="loadHome"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="empty-section fade-in">
    <view class="section-row"><text class="section-title">最近的声音</text></view>
    <view class="empty-card soft-card">
      <view class="empty-wave-image ui-sprite sprite-waveform"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
      <text class="empty-title">还没有留下声音</text>
      <text class="empty-copy">选择一段 12–60 秒的旧视频，完成试听后，它会出现在这里。</text>
      <button class="empty-action" bindtap="createVoice">创建第一个声音</button>
    </view>
    <view class="privacy-note"><view class="privacy-lock"></view><text>私有声音仅自己可用，可随时删除</text></view>
  </view>

  <view wx:else class="recent-section fade-in">
    <view class="section-row">
      <text class="section-title">最近的声音</text>
      <navigator class="section-link" url="/pages/voices/index" open-type="switchTab">全部 ›</navigator>
    </view>
    <view class="voice-list">
      <view wx:for="{{voices}}" wx:key="id" class="voice-card soft-card" data-id="{{item.id}}" bindtap="openVoice">
        <image wx:if="{{item.avatarUrl}}" class="voice-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="voice-avatar fallback">{{item.initial}}</view>
        <view class="voice-info">
          <text class="voice-name">{{item.name}}</text>
          <text class="voice-meta">{{item.lastUsedText}}</text>
        </view>
        <view class="voice-wave ui-sprite sprite-waveform"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
        <text class="voice-points">{{item.pointsText}}</text>
        <view class="voice-play ui-sprite sprite-play-glass"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
        <view class="voice-more ui-sprite sprite-more"><image class="ui-sprite-sheet" src="/assets/ui/icon-sheet.png" mode="widthFix"></image></view>
      </view>
    </view>
    <view class="privacy-note"><view class="privacy-lock"></view><text>声音仅本人可见；处理中的任务请到“我的声音”查看</text></view>
  </view>
</view>
