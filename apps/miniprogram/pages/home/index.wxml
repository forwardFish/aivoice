<view class="home-screen screen-shell">
  <app-nav transparent="{{true}}"></app-nav>

  <view class="hero fade-in">
    <view class="hero-copy">
      <text class="brand-title">那年的TA</text>
      <text class="brand-subtitle">把记忆里的声音，轻轻留住</text>
    </view>
    <image class="hero-memory" src="/assets/ui/hero-memory.png" mode="aspectFit"></image>
    <view class="hero-glow"></view>
    <view class="hero-spark hero-spark-a"></view>
    <view class="hero-spark hero-spark-b"></view>
  </view>

  <view class="create-card luminous-card float-in" bindtap="createVoice">
    <image class="create-icon" src="/assets/ui/icon-add.png" mode="aspectFit"></image>
    <view class="create-copy">
      <text class="create-title">创建新声音</text>
      <text class="create-subtitle">从旧视频中提取 TA 的声音</text>
    </view>
    <view class="create-arrow"><app-chevron direction="right" tone="brand" size="28"></app-chevron></view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="home-state glass-card fade-in">
    <page-state mode="loading" compact="{{true}}" title="正在加载声音" description="正在获取最近可用的私有声音…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="home-state glass-card fade-in">
    <page-state mode="error" compact="{{true}}" title="首页暂时无法加载" description="{{errorMessage}}" actionText="重新加载" bindaction="loadHome"></page-state>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="empty-section fade-in">
    <view class="section-row"><text class="section-title">最近的声音</text></view>
    <view class="empty-card soft-card">
      <image class="empty-wave-image" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
      <text class="empty-title">还没有留下声音</text>
      <text class="empty-copy">选一段 8–60 秒的旧视频，完成试听后，声音会出现在这里。</text>
      <view class="empty-steps">
        <view><text>1</text><text>选视频</text></view>
        <view class="step-line"></view>
        <view><text>2</text><text>截声音</text></view>
        <view class="step-line"></view>
        <view><text>3</text><text>开始体验</text></view>
      </view>
    </view>
  </view>

  <view wx:else class="recent-section fade-in">
    <view class="section-row">
      <text class="section-title">最近的声音</text>
      <navigator class="section-link" url="/pages/voices/index" open-type="switchTab"><text>全部</text><app-chevron direction="right" size="13"></app-chevron></navigator>
    </view>

    <view class="voice-list">
      <view wx:for="{{voices}}" wx:key="id" class="voice-card soft-card" data-id="{{item.id}}" bindtap="openVoice">
        <app-avatar size="104" src="{{item.displayAvatarUrl}}" custom-class="voice-avatar"></app-avatar>

        <view class="voice-info">
          <text class="voice-name">{{item.name}}</text>
          <view class="voice-meta-row">
            <text class="voice-meta">{{item.metaText}}</text>
          </view>
        </view>

        <image class="voice-wave" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
        <text wx:if="{{item.durationText}}" class="voice-duration">{{item.durationText}}</text>
        <image class="voice-play" src="/assets/ui/icon-play-glass.png" mode="aspectFit"></image>
        <image class="voice-more" src="/assets/ui/icon-more-vertical.png" mode="aspectFit"></image>
      </view>
    </view>

  </view>

  <view class="tabbar-safe-space"></view>
</view>
