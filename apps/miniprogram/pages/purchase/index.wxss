.purchase-screen {
  min-height: 100vh;
  background: #f7f8ff;
}

.purchase-state {
  margin: 30rpx;
  overflow: hidden;
  border-radius: 30rpx;
}

.purchase-content {
  padding: 24rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
}

.hero-card {
  padding: 34rpx 30rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(255, 255, 255, 0.86), transparent 26%),
    linear-gradient(145deg, #f4f1ff 0%, #fff7f1 100%);
}

.hero-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-avatar {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 740;
  background: linear-gradient(135deg, #7f70f6, #5a88ea);
  box-shadow: 0 18rpx 38rpx rgba(101, 82, 245, 0.20);
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #6552f5;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.36;
  font-weight: 760;
  color: #11172d;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6f7690;
}

.hero-quota {
  margin-top: 24rpx;
  display: inline-flex;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(101, 82, 245, 0.10);
}

.quota-label {
  color: #6552f5;
  font-size: 23rpx;
  font-weight: 650;
}

.product-card {
  margin-top: 22rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 28rpx;
}

.product-main,
.product-side {
  display: flex;
  flex-direction: column;
}

.product-main {
  flex: 1;
  min-width: 0;
}

.product-quota {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 740;
  color: #11172d;
}

.product-copy,
.product-price-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7a8198;
}

.product-side {
  align-items: flex-end;
}

.product-price {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 760;
  color: #6552f5;
}

.benefit-card {
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
}

.benefit-row {
  padding: 12rpx 0;
  font-size: 25rpx;
  line-height: 1.6;
  color: #5f667f;
}

.legal-card {
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
}

.legal-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #11172d;
}

.legal-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6f7690;
}

.legal-links {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legal-link,
.legal-separator {
  font-size: 23rpx;
}

.legal-link {
  color: #6552f5;
}

.legal-separator {
  color: #a0a6b6;
}

.pending-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #f4f2ff;
  color: #6552f5;
  font-size: 23rpx;
}

.mini-spinner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(101, 82, 245, 0.18);
  border-top-color: #6552f5;
  animation: purchase-spin 0.9s linear infinite;
}

.error-message {
  display: block;
  margin-top: 22rpx;
  color: #d85b63;
  font-size: 24rpx;
  line-height: 1.55;
}

.footer-actions {
  margin-top: 34rpx;
}

.footer-cancel {
  margin-top: 14rpx;
}

@keyframes purchase-spin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}
