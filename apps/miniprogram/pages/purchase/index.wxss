.purchase-screen { min-height: 100vh; padding-bottom: calc(210rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 34rpx; overflow: hidden; border-radius: 36rpx; }
.purchase-content { padding: 18rpx 36rpx 0; }
.purchase-heading { padding: 5rpx 4rpx 28rpx; text-align: center; }
.purchase-heading .page-title { font-size: 40rpx; }
.purchase-heading .page-subtitle { margin-top: 12rpx; }
.package-hero { min-height: 370rpx; padding: 24rpx 25rpx 28rpx; border-radius: 42rpx; display: flex; align-items: center; gap: 19rpx; overflow: hidden; }
.bag-visual { flex: 0 0 auto; width: 226rpx; height: 222rpx; position: relative; }
.bag-shadow { width: 170rpx; height: 34rpx; position: absolute; left: 28rpx; bottom: 6rpx; border-radius: 50%; background: rgba(97,80,220,.18); filter: blur(12rpx); }
.bag-handle { width: 80rpx; height: 61rpx; position: absolute; z-index: 1; left: 73rpx; top: 24rpx; border: 15rpx solid #8d72ef; border-bottom: 0; border-radius: 46rpx 46rpx 0 0; box-shadow: inset 0 3rpx 0 rgba(255,255,255,.40); }
.bag-body { width: 168rpx; height: 137rpx; position: absolute; z-index: 2; left: 29rpx; top: 60rpx; border-radius: 27rpx 27rpx 42rpx 42rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 15%,rgba(255,255,255,.56),transparent 30%),linear-gradient(145deg,#705bf1,#b174eb); border: 3rpx solid rgba(255,255,255,.50); box-shadow: 0 21rpx 40rpx rgba(101,82,245,.27),inset 0 2rpx 0 rgba(255,255,255,.42); }
.bag-star { color: #fff7d3; font-size: 35rpx; text-shadow: 0 0 16rpx rgba(255,231,160,.72); }
.bag-wave { height: 35rpx; margin-top: 7rpx; display: flex; align-items: center; gap: 5rpx; }
.bag-wave text { width: 5rpx; border-radius: 999rpx; background: rgba(255,255,255,.88); }
.bag-wave text:nth-child(1), .bag-wave text:nth-child(5) { height: 12rpx; }
.bag-wave text:nth-child(2), .bag-wave text:nth-child(4) { height: 24rpx; }
.bag-wave text:nth-child(3) { height: 34rpx; }
.coin { position: absolute; z-index: 3; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#f4a36b,#ef7485); box-shadow: 0 10rpx 24rpx rgba(232,111,118,.25); font-size: 20rpx; font-weight: 700; }
.coin-left { width: 44rpx; height: 44rpx; left: 2rpx; top: 105rpx; }
.coin-right { width: 50rpx; height: 50rpx; right: 0; top: 46rpx; }
.package-copy { flex: 1; min-width: 0; position: relative; z-index: 3; }
.package-label-row { display: flex; align-items: center; gap: 10rpx; }
.package-label { color: #6552f5; font-size: 20rpx; font-weight: 710; }
.once-tag { padding: 5rpx 9rpx; border-radius: 999rpx; color: #8b6c5b; background: #fff2e9; font-size: 14rpx; }
.package-points { margin-top: 13rpx; display: flex; align-items: baseline; gap: 8rpx; }
.points-number { color: #151b32; font-size: 61rpx; line-height: 1; font-weight: 800; letter-spacing: -1rpx; }
.points-unit { color: #4f566d; font-size: 23rpx; font-weight: 680; }
.package-description { display: block; margin-top: 12rpx; color: #858ba0; font-size: 19rpx; line-height: 1.5; }
.price-row { margin-top: 17rpx; display: flex; align-items: baseline; gap: 12rpx; }
.price-text { color: #ef684d; font-size: 38rpx; font-weight: 780; }
.price-note { color: #9297a9; font-size: 17rpx; }
.balance-card { min-height: 91rpx; margin-top: 20rpx; padding: 16rpx 19rpx; border-radius: 29rpx; display: flex; align-items: center; gap: 14rpx; }
.balance-icon { flex: 0 0 auto; width: 52rpx; height: 52rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#6552f5,#9b72f4); box-shadow: 0 10rpx 21rpx rgba(101,82,245,.20); font-size: 20rpx; }
.balance-card > view:nth-child(2) { flex: 1; min-width: 0; }
.balance-card text:first-child { display: block; color: #8d92a5; font-size: 17rpx; }
.balance-card text:last-child { display: block; margin-top: 5rpx; color: #343a50; font-size: 22rpx; font-weight: 680; }
.balance-avatar { flex: 0 0 auto; width: 54rpx; height: 54rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#8d7af4,#5d7ad7); border: 2rpx solid #fff; font-size: 20rpx; font-weight: 700; }
.benefits-card { margin-top: 20rpx; padding: 26rpx 25rpx 20rpx; border-radius: 37rpx; }
.benefits-title { display: block; margin-bottom: 18rpx; color: #22283f; font-size: 25rpx; font-weight: 720; }
.benefit-row { padding: 13rpx 0; display: flex; align-items: flex-start; gap: 14rpx; }
.benefit-row + .benefit-row { border-top: 1rpx solid rgba(232,232,241,.80); }
.benefit-check { flex: 0 0 auto; width: 32rpx; height: 32rpx; margin-top: 2rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#61bd80,#49a96c); font-size: 18rpx; }
.benefit-row > view:last-child { flex: 1; min-width: 0; }
.benefit-row text:first-child { display: block; color: #3c4359; font-size: 21rpx; font-weight: 660; }
.benefit-row text:last-child { display: block; margin-top: 5rpx; color: #9297a9; font-size: 17rpx; line-height: 1.45; }
.legal-card { margin-top: 20rpx; padding: 22rpx 23rpx; border-radius: 30rpx; }
.legal-title,
.legal-copy { display: block; }
.legal-title { color: #444b62; font-size: 21rpx; font-weight: 680; }
.legal-copy { margin-top: 8rpx; color: #8e93a6; font-size: 17rpx; line-height: 1.6; }
.legal-links { margin-top: 12rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #6959e8; font-size: 18rpx; }
.pending-box { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 22rpx; display: flex; align-items: center; gap: 12rpx; color: #6f63d9; background: #f0edff; font-size: 20rpx; }
.pending-spinner { width: 25rpx; height: 25rpx; border-radius: 50%; border: 3rpx solid rgba(101,82,245,.20); border-top-color: #6552f5; animation: spin .85s linear infinite; }
.error-message { display: block; margin-top: 18rpx; padding: 15rpx 18rpx; border-radius: 20rpx; color: #d85b63; background: #fff0f1; font-size: 20rpx; line-height: 1.5; }
.footer-actions { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; padding: 17rpx 36rpx calc(17rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg,rgba(249,250,255,0),rgba(249,250,255,.94) 17%,#f9faff 37%); }
.buy-button { min-height: 94rpx; }
.back-button { min-height: 52rpx; margin-top: 5rpx; }
.footer-note { display: block; margin-top: 1rpx; color: #9a9eae; font-size: 16rpx; text-align: center; }
@media (max-width: 350px) { .package-hero { gap: 8rpx; } .bag-visual { width: 190rpx; transform: scale(.88); transform-origin: center; } .points-number { font-size: 52rpx; } }
