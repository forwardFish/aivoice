.purchase-screen { min-height: 100vh; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 32rpx; overflow: hidden; border-radius: 34rpx; }
.purchase-content { padding: 18rpx 34rpx 0; }
.purchase-heading { padding: 3rpx 3rpx 22rpx; text-align: center; }
.purchase-heading .page-title { font-size: 42rpx; }
.purchase-heading .page-subtitle { margin-top: 10rpx; font-size: 22rpx; }

.product-card { padding: 36rpx 30rpx 30rpx; border-radius: 42rpx; overflow: hidden; text-align: center; }
.compact-bag { width: 224rpx; height: 224rpx; display:block; margin: 0 auto; }

.product-tags { margin-top: 10rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.product-tags text:first-child { color: #6552f5; font-size: 18rpx; font-weight: 710; }
.product-tags text:last-child { padding: 4rpx 8rpx; border-radius: 999rpx; color: #8b6c5b; background: #fff2e9; font-size: 12rpx; }
.point-line { margin-top: 18rpx; display: flex; align-items: baseline; justify-content: center; gap: 8rpx; }
.point-number { color: #151b32; font-size: 60rpx; line-height: 1; font-weight: 800; letter-spacing: -1rpx; }
.point-unit { color: #4f566d; font-size: 22rpx; font-weight: 680; }
.product-price { display: block; margin-top: 14rpx; color: #ef684d; font-size: 52rpx; font-weight: 790; line-height: 1; }
.product-description { display: block; margin-top: 12rpx; color: #858ba0; font-size: 18rpx; line-height: 1.6; }

.account-strip { min-height: 94rpx; margin-top: 28rpx; padding: 0 20rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; background: rgba(247,247,252,.84); border: 1rpx solid #ebebf3; text-align: left; }
.account-label { color: #9297a9; font-size: 17rpx; }
.account-value { color: #343a50; font-size: 22rpx; font-weight: 690; }

.product-benefits { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(229,229,239,.90); display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx 10rpx; }
.product-benefits > view { min-width: 0; display: flex; align-items: center; justify-content: flex-start; gap: 8rpx; color: #6f768d; font-size: 16rpx; line-height: 1.45; text-align: left; }
.benefit-check { width: 29rpx; height: 29rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#61bd80,#49a96c); font-size: 15rpx; }

.notice-copy { display: block; margin-top: 20rpx; color: #8e93a6; font-size: 17rpx; line-height: 1.6; text-align: left; }
.legal-links { margin-top: 14rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #6959e8; font-size: 17rpx; }

.pending-box { margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 20rpx; display: flex; align-items: center; gap: 10rpx; color: #6f63d9; background: #f0edff; font-size: 18rpx; }
.pending-spinner { width: 22rpx; height: 22rpx; border-radius: 50%; border: 3rpx solid rgba(101,82,245,.20); border-top-color: #6552f5; animation: spin .85s linear infinite; }
.error-message { display: block; margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 18rpx; color: #d85b63; background: #fff0f1; font-size: 18rpx; line-height: 1.5; }
.purchase-spacer { height: 30rpx; }

.purchase-footer { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; padding: 14rpx 34rpx calc(13rpx + env(safe-area-inset-bottom)); background: rgba(250,250,255,.97); border-top: 1rpx solid rgba(226,226,237,.92); box-shadow: 0 -16rpx 38rpx rgba(58,61,94,.08); backdrop-filter: blur(20rpx); }
.buy-button { min-height: 92rpx; }
.footer-note { display: block; color: #9a9eae; font-size: 15rpx; line-height: 1.4; text-align: center; }

@media (max-height: 740px) {
  .purchase-heading { padding-bottom: 14rpx; }
  .product-card { padding-top: 18rpx; padding-bottom: 18rpx; }
  .compact-bag { width: 152rpx; height: 152rpx; }
  .point-number { font-size: 48rpx; }
  .account-strip { margin-top: 13rpx; }
  .product-benefits { margin-top: 13rpx; padding-top: 13rpx; }
  .notice-copy { line-height: 1.45; }
}
