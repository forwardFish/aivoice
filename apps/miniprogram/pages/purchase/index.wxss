.purchase-screen {
  min-height: 100vh;
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 12% 4%, rgba(160, 182, 255, 0.14), transparent 26%),
    radial-gradient(circle at 88% 7%, rgba(202, 180, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #f8f9ff 0%, #f5f6ff 100%);
}

.state-wrap {
  margin: 32rpx;
  overflow: hidden;
  border-radius: 34rpx;
}

.purchase-content {
  padding: 34rpx 34rpx 0;
}

.purchase-heading {
  padding: 34rpx 18rpx 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.purchase-heading .page-subtitle {
  display: block;
  max-width: 620rpx;
  color: #7f87a2;
  font-size: 29rpx;
  line-height: 1.7;
}

.product-card {
  padding: 28rpx 26rpx 30rpx;
  border-radius: 46rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.78);
  box-shadow:
    0 22rpx 54rpx rgba(127, 137, 190, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
}

.product-stage-card {
  padding: 46rpx 28rpx 38rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, rgba(252, 252, 255, 0.96), rgba(247, 244, 255, 0.94));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.98);
}

.point-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.point-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.point-number {
  color: #725df3;
  font-size: 176rpx;
  line-height: 0.92;
  font-weight: 800;
  letter-spacing: -8rpx;
}

.point-unit {
  margin-left: 14rpx;
  color: #725df3;
  font-size: 46rpx;
  font-weight: 760;
}

.product-lead {
  display: block;
  margin-top: 34rpx;
  color: #737c95;
  font-size: 30rpx;
  line-height: 1.56;
}

.purchase-divider {
  height: 1rpx;
  margin: 42rpx 12rpx 30rpx;
  background: rgba(221, 219, 242, 0.94);
}

.purchase-price-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 14rpx;
}

.product-price {
  color: #725df3;
  font-size: 90rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -3rpx;
}

.price-unit {
  color: #616983;
  font-size: 30rpx;
  line-height: 1.3;
}

.benefit-strip {
  min-height: 94rpx;
  margin-top: 28rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(229, 228, 242, 0.96);
}

.benefit-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.benefit-icon {
  color: #8f7cf6;
  font-size: 26rpx;
  line-height: 1;
}

.benefit-item {
  color: #65708b;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.4;
}

.benefit-divider {
  width: 1rpx;
  height: 42rpx;
  background: #e5e2f0;
}

.account-strip {
  min-height: 86rpx;
  margin: 24rpx 10rpx 0;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(231, 232, 243, 0.94);
}

.account-label {
  color: #7d85a1;
  font-size: 23rpx;
}

.account-value {
  color: #28314d;
  font-size: 27rpx;
  font-weight: 700;
}

.rule-summary {
  margin: 34rpx 22rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.rule-summary-line {
  color: #8088a1;
  font-size: 22rpx;
  line-height: 1.58;
}

.legal-block {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.legal-prefix {
  color: #8e93a8;
  font-size: 20rpx;
}

.legal-links {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6959e8;
  font-size: 20rpx;
  font-weight: 650;
}

.pending-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #5e54c9;
  background: #f0edff;
  font-size: 21rpx;
}

.pending-spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(101, 82, 245, 0.2);
  border-top-color: #6552f5;
  animation: spin 0.85s linear infinite;
}

.error-message {
  display: block;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  color: #d85b63;
  background: #fff0f1;
  font-size: 20rpx;
  line-height: 1.58;
}

.purchase-spacer {
  height: 52rpx;
}

.purchase-footer {
  position: fixed;
  z-index: 45;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 34rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: rgba(250, 250, 255, 0.97);
  border-top: 1rpx solid rgba(226, 226, 237, 0.92);
  box-shadow: 0 -16rpx 38rpx rgba(58, 61, 94, 0.08);
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
}

.purchase-footer-action {
  width: 100%;
  display: flex;
  align-items: stretch;
}

.purchase-button-host {
  width: 100%;
  display: block;
  flex: 1 1 auto;
}

.purchase-button-inner {
  width: 100% !important;
}

.footer-note {
  display: block;
  color: #8f93a6;
  font-size: 18rpx;
  line-height: 1.5;
  text-align: center;
}

/* Contract anchors for tests and future iterations. */
.price-stage { display: block; }
.rule-list { display: flex; flex-direction: column; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (max-height: 740px) {
  .purchase-screen {
    padding-bottom: calc(192rpx + env(safe-area-inset-bottom));
  }

  .purchase-content {
    padding-top: 18rpx;
  }

  .purchase-heading {
    padding-top: 20rpx;
    padding-bottom: 26rpx;
  }

  .purchase-heading .page-subtitle {
    font-size: 25rpx;
    line-height: 1.62;
  }

  .product-stage-card {
    padding-top: 34rpx;
    padding-bottom: 30rpx;
  }

  .point-number {
    font-size: 146rpx;
  }

  .point-unit {
    font-size: 38rpx;
  }

  .product-lead {
    margin-top: 24rpx;
    font-size: 26rpx;
  }

  .product-price {
    font-size: 76rpx;
  }

  .benefit-strip {
    min-height: 82rpx;
  }

  .rule-summary-line {
    font-size: 21rpx;
  }
}
