.purchase-screen { min-height: 100vh; padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); }
.state-wrap { margin: 32rpx; overflow: hidden; border-radius: 34rpx; }
.purchase-content { padding: 13rpx 34rpx 0; }
.purchase-heading { padding: 3rpx 3rpx 22rpx; text-align: center; }
.purchase-heading .page-title { font-size: 38rpx; }
.purchase-heading .page-subtitle { margin-top: 9rpx; font-size: 21rpx; }

.product-card { padding: 25rpx 24rpx 23rpx; border-radius: 39rpx; overflow: hidden; }
.product-top { display: flex; align-items: center; gap: 17rpx; }
.compact-bag { flex: 0 0 auto; width: 128rpx; height: 130rpx; position: relative; }
.bag-handle { width: 49rpx; height: 39rpx; position: absolute; z-index: 1; left: 39rpx; top: 10rpx; border: 10rpx solid #8d72ef; border-bottom: 0; border-radius: 31rpx 31rpx 0 0; }
.bag-body { width: 106rpx; height: 91rpx; position: absolute; z-index: 2; left: 11rpx; top: 37rpx; border-radius: 19rpx 19rpx 29rpx 29rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff8d6; background: radial-gradient(circle at 30% 15%,rgba(255,255,255,.55),transparent 30%),linear-gradient(145deg,#705bf1,#b174eb); border: 2rpx solid rgba(255,255,255,.55); box-shadow: 0 17rpx 31rpx rgba(101,82,245,.24), inset 0 2rpx 0 rgba(255,255,255,.42); font-size: 24rpx; }
.bag-wave { height: 23rpx; margin-top: 3rpx; display: flex; align-items: center; gap: 3rpx; }
.bag-wave text { width: 3rpx; border-radius: 999rpx; background: rgba(255,255,255,.90); }
.bag-wave text:nth-child(1), .bag-wave text:nth-child(5) { height: 8rpx; }
.bag-wave text:nth-child(2), .bag-wave text:nth-child(4) { height: 15rpx; }
.bag-wave text:nth-child(3) { height: 22rpx; }

.product-main { flex: 1; min-width: 0; }
.product-tags { display: flex; align-items: center; gap: 8rpx; }
.product-tags text:first-child { color: #6552f5; font-size: 18rpx; font-weight: 710; }
.product-tags text:last-child { padding: 4rpx 8rpx; border-radius: 999rpx; color: #8b6c5b; background: #fff2e9; font-size: 12rpx; }
.point-line { margin-top: 9rpx; display: flex; align-items: baseline; gap: 6rpx; }
.point-number { color: #151b32; font-size: 50rpx; line-height: 1; font-weight: 800; letter-spacing: -1rpx; }
.point-unit { color: #4f566d; font-size: 20rpx; font-weight: 680; }
.product-description { display: block; margin-top: 8rpx; color: #858ba0; font-size: 16rpx; line-height: 1.45; }
.product-price { flex: 0 0 auto; text-align: right; }
.product-price text:first-child { display: block; color: #ef684d; font-size: 35rpx; font-weight: 790; }
.product-price text:last-child { display: block; margin-top: 6rpx; color: #9297a9; font-size: 14rpx; }

.account-strip { min-height: 76rpx; margin-top: 20rpx; padding: 12rpx 14rpx; border-radius: 24rpx; display: flex; align-items: center; gap: 12rpx; background: rgba(247,247,252,.84); border: 1rpx solid #ebebf3; }
.account-icon { flex: 0 0 auto; width: 43rpx; height: 43rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#6552f5,#9b72f4); font-size: 17rpx; }
.account-copy { flex: 1; min-width: 0; }
.account-copy text:first-child { display: block; color: #9297a9; font-size: 14rpx; }
.account-copy text:last-child { display: block; margin-top: 4rpx; color: #343a50; font-size: 19rpx; font-weight: 680; }
.voice-badge { flex: 0 0 auto; width: 46rpx; height: 46rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#8d7af4,#5d7ad7); border: 2rpx solid #fff; font-size: 17rpx; font-weight: 700; }

.product-benefits { margin-top: 18rpx; padding-top: 17rpx; border-top: 1rpx solid rgba(229,229,239,.90); display: grid; grid-template-columns: repeat(3, 1fr); gap: 9rpx; }
.product-benefits > view { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: #6f768d; font-size: 15rpx; line-height: 1.35; text-align: center; }
.benefit-check { width: 29rpx; height: 29rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#61bd80,#49a96c); font-size: 15rpx; }

.purchase-notice { margin-top: 17rpx; padding: 19rpx 20rpx; border-radius: 27rpx; }
.notice-title,
.notice-copy { display: block; }
.notice-title { color: #444b62; font-size: 19rpx; font-weight: 680; }
.notice-copy { margin-top: 7rpx; color: #8e93a6; font-size: 16rpx; line-height: 1.58; }
.legal-links { margin-top: 10rpx; display: flex; align-items: center; justify-content: center; gap: 7rpx; color: #6959e8; font-size: 16rpx; }

.pending-box { margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 20rpx; display: flex; align-items: center; gap: 10rpx; color: #6f63d9; background: #f0edff; font-size: 18rpx; }
.pending-spinner { width: 22rpx; height: 22rpx; border-radius: 50%; border: 3rpx solid rgba(101,82,245,.20); border-top-color: #6552f5; animation: spin .85s linear infinite; }
.error-message { display: block; margin-top: 15rpx; padding: 14rpx 16rpx; border-radius: 18rpx; color: #d85b63; background: #fff0f1; font-size: 18rpx; line-height: 1.5; }
.purchase-spacer { height: 30rpx; }

.purchase-footer { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; padding: 14rpx 34rpx calc(13rpx + env(safe-area-inset-bottom)); background: rgba(250,250,255,.97); border-top: 1rpx solid rgba(226,226,237,.92); box-shadow: 0 -16rpx 38rpx rgba(58,61,94,.08); backdrop-filter: blur(20rpx); }
.buy-button { min-height: 88rpx; }
.footer-cancel { width: 100%; height: 42rpx; color: #7f8599; background: transparent; font-size: 18rpx; }
.footer-note { display: block; color: #9a9eae; font-size: 14rpx; line-height: 1.35; text-align: center; }

@media (max-height: 740px) {
  .purchase-heading { padding-bottom: 14rpx; }
  .product-card { padding-top: 18rpx; padding-bottom: 18rpx; }
  .compact-bag { width: 105rpx; transform: scale(.84); transform-origin: center; margin-left: -8rpx; margin-right: -8rpx; }
  .point-number { font-size: 44rpx; }
  .account-strip { margin-top: 13rpx; }
  .product-benefits { margin-top: 13rpx; padding-top: 13rpx; }
  .purchase-notice { margin-top: 12rpx; padding: 15rpx 18rpx; }
  .notice-copy { line-height: 1.45; }
}
