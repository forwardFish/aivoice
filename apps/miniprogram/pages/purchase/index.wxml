<view class="purchase-screen screen-shell">
  <app-nav title="购买积分" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="state-wrap">
    <page-state mode="loading" title="正在打开购买页" description="正在同步声音、账号积分与待确认订单…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-wrap glass-card">
    <page-state mode="error" title="购买信息暂时不可用" description="{{errorMessage}}" actionText="返回工作台" bindaction="goBack"></page-state>
  </view>

  <block wx:else>
    <view class="purchase-content fade-in">
      <view class="purchase-heading">
        <text class="page-title">补充账号积分</text>
        <text class="page-subtitle">一次购买，账号内所有私有声音共享使用</text>
      </view>

      <view class="product-card luminous-card">
        <view class="product-top">
          <view class="compact-bag">
            <view class="bag-handle"></view>
            <view class="bag-body"><text>✦</text><view class="bag-wave"><text></text><text></text><text></text><text></text><text></text></view></view>
          </view>

          <view class="product-main">
            <view class="product-tags"><text>账号积分包</text><text>一次性购买</text></view>
            <view class="point-line"><text class="point-number">{{purchaseOption.points}}</text><text class="point-unit">账号积分</text></view>
            <text class="product-description">{{purchaseOption.description || '对话与“说一句”共享使用'}}</text>
          </view>

          <view class="product-price">
            <text>{{priceText}}</text>
            <text>不自动续费</text>
          </view>
        </view>

        <view class="account-strip">
          <view class="account-icon">✦</view>
          <view class="account-copy"><text>当前账号余额</text><text>{{pointsText}}</text></view>
          <view class="voice-badge">{{voiceInitial}}</view>
        </view>

        <view class="product-benefits">
          <view><text class="benefit-check">✓</text><text>所有声音共享</text></view>
          <view><text class="benefit-check">✓</text><text>成功生成才扣</text></view>
          <view><text class="benefit-check">✓</text><text>支付后服务端确认入账</text></view>
        </view>
      </view>

      <view class="purchase-notice soft-card">
        <text class="notice-title">购买前请知悉</text>
        <text class="notice-copy">AI 生成语音不代表声音本人真实表达。失败、被拦截或服务异常不扣积分；支付结果与积分到账均以服务端订单校验为准。</text>
        <view class="legal-links"><text data-type="terms" bindtap="showAgreement">《服务协议》</text><text>·</text><text data-type="privacy" bindtap="showAgreement">《隐私政策》</text></view>
      </view>

      <view wx:if="{{pending}}" class="pending-box"><view class="pending-spinner"></view><text>{{purchaseMessage || '正在确认支付结果和积分入账…'}}</text></view>
      <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
      <view class="purchase-spacer"></view>
    </view>

    <view class="purchase-footer safe-bottom">
      <button class="primary-button buy-button {{paying || pending ? 'button-disabled' : ''}}" bindtap="submitPurchase" disabled="{{paying || pending}}">
        {{paying ? '正在打开微信支付…' : pending ? '正在确认积分到账…' : '立即购买 ' + purchaseOption.points + ' 积分 · ' + priceText}}
      </button>
      <button class="footer-cancel" bindtap="goBack" disabled="{{paying || pending}}">暂不购买</button>
      <text class="footer-note">未完成支付不会扣款；支付成功后自动确认入账并保留原输入。</text>
    </view>
  </block>
</view>
