<view class="purchase-screen screen-shell">
  <app-nav title="购买积分" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="state-wrap">
    <page-state mode="loading" title="正在打开购买页" description="正在同步声音、账户积分与待确认订单…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-wrap glass-card">
    <page-state mode="error" title="购买信息暂时不可用" description="{{errorMessage}}" actionText="返回工作台" bindaction="goBack"></page-state>
  </view>

  <view wx:else class="purchase-content fade-in">
    <view class="purchase-heading">
      <text class="page-title">继续听见“{{voiceName}}”</text>
      <text class="page-subtitle">购买账号积分后，所有已创建声音共享使用。</text>
    </view>

    <view class="package-hero luminous-card">
      <view class="bag-visual">
        <view class="bag-shadow"></view>
        <view class="bag-handle"></view>
        <view class="bag-body"><view class="bag-star">✦</view><view class="bag-wave"><text></text><text></text><text></text><text></text><text></text></view></view>
        <view class="coin coin-left">+</view><view class="coin coin-right">✦</view>
      </view>

      <view class="package-copy">
        <view class="package-label-row"><text class="package-label">账号积分包</text><text class="once-tag">一次性购买</text></view>
        <view class="package-points"><text class="points-number">{{purchaseOption.points}}</text><text class="points-unit">账号积分</text></view>
        <text class="package-description">{{purchaseOption.description || '对话与“说一句”共享使用'}}</text>
        <view class="price-row"><text class="price-text">{{priceText}}</text><text class="price-note">不自动续费</text></view>
      </view>
    </view>

    <view class="balance-card soft-card">
      <view class="balance-icon">✦</view>
      <view><text>当前账户</text><text>{{pointsText}}</text></view>
      <view class="balance-avatar">{{voiceInitial}}</view>
    </view>

    <view class="benefits-card glass-card">
      <text class="benefits-title">积分如何使用</text>
      <view class="benefit-row"><view class="benefit-check">✓</view><view><text>账号内所有声音共享</text><text>不再按单个声音分别购买。</text></view></view>
      <view class="benefit-row"><view class="benefit-check">✓</view><view><text>只在成功生成后扣减</text><text>失败、被拦截或服务异常均不扣积分。</text></view></view>
      <view class="benefit-row"><view class="benefit-check">✓</view><view><text>支付完成后自动确认到账</text><text>订单和积分状态均以服务端校验结果为准。</text></view></view>
      <view class="benefit-row"><view class="benefit-check">✓</view><view><text>不会自动续费</text><text>本商品不是会员订阅，不会周期性扣款。</text></view></view>
    </view>

    <view class="legal-card soft-card">
      <text class="legal-title">购买前请知悉</text>
      <text class="legal-copy">AI 生成语音会明确标注为 AI 生成，不代表声音本人真实表达。请勿用于冒充、诈骗、身份核验或其他违法用途。</text>
      <view class="legal-links"><text data-type="terms" bindtap="showAgreement">《服务协议》</text><text>·</text><text data-type="privacy" bindtap="showAgreement">《隐私政策》</text></view>
    </view>

    <view wx:if="{{pending}}" class="pending-box"><view class="pending-spinner"></view><text>{{purchaseMessage || '正在确认支付结果和积分入账…'}}</text></view>
    <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>

    <view class="footer-actions safe-bottom">
      <button class="primary-button buy-button {{paying || pending ? 'button-disabled' : ''}}" bindtap="submitPurchase" disabled="{{paying || pending}}">
        {{paying ? '正在打开微信支付…' : pending ? '正在确认积分到账…' : '立即购买 ' + purchaseOption.points + ' 积分 · ' + priceText}}
      </button>
      <button class="ghost-button back-button" bindtap="goBack" disabled="{{paying || pending}}">先回工作台</button>
      <text class="footer-note">支付未完成不会扣款；到账后会自动返回并保留原输入。</text>
    </view>
  </view>
</view>
