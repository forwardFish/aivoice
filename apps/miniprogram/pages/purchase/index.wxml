<view class="purchase-screen">
  <app-nav title="购买积分" back="{{true}}" transparent="{{true}}"></app-nav>

  <view wx:if="{{state === 'loading'}}" class="state-wrap">
    <page-state mode="loading" title="正在打开购买页" description="正在同步声音、账号积分与待确认订单…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-wrap glass-card">
    <page-state mode="error" title="购买信息暂时不可用" description="{{errorMessage}}" actionText="返回工作台" bindaction="goBack"></page-state>
  </view>

  <block wx:else>
    <view class="purchase-content fade-in">
      <view class="purchase-heading">
        <text class="page-subtitle">继续使用高品质 AI 声音进行对话或生成语音</text>
      </view>

      <view class="product-card glass-card">
        <view class="product-stage-card">
          <view class="point-stage">
            <view class="point-line">
              <text class="point-number">{{purchaseOption.points}}</text>
              <text class="point-unit">积分</text>
            </view>
            <text class="product-lead">可用于对话或生成语音，所有声音共享</text>
          </view>

          <view class="purchase-divider"></view>

          <view class="purchase-price-line">
            <text class="product-price">{{priceText}}</text>
            <text class="price-unit">/ {{purchaseOption.points}} 积分</text>
          </view>
        </view>

        <view class="benefit-strip">
          <view class="benefit-cell">
            <text class="benefit-icon">○</text>
            <text class="benefit-item">一次性购买</text>
          </view>
          <view class="benefit-divider"></view>
          <view class="benefit-cell">
            <text class="benefit-icon">○</text>
            <text class="benefit-item">不自动续费</text>
          </view>
        </view>
      </view>

      <view class="account-strip">
        <text class="account-label">当前账号余额</text>
        <text class="account-value">{{pointsText}}</text>
      </view>

      <view class="rule-summary">
        <text class="rule-summary-line">支付取消或失败不会增加积分；只有服务端确认订单成功后，积分才会正式入账。</text>
        <text class="rule-summary-line">内容拦截、生成失败或服务异常时不扣积分。</text>
      </view>

      <view class="legal-block">
        <text class="legal-prefix">购买即表示你已阅读并同意</text>
        <view class="legal-links"><text data-type="terms" bindtap="showAgreement">《服务协议》</text><text>·</text><text data-type="privacy" bindtap="showAgreement">《隐私政策》</text></view>
      </view>

      <view wx:if="{{pending}}" class="pending-box"><view class="pending-spinner"></view><text>{{purchaseMessage || '正在确认支付结果和积分入账…'}}</text></view>
      <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
      <view class="purchase-spacer"></view>
    </view>

    <view class="purchase-footer">
      <view class="purchase-footer-action">
        <app-button
          class="purchase-button-host"
          style="width:100%;display:block;flex:1 1 auto;"
          custom-class="purchase-button-inner"
          label="{{paying ? '正在打开微信支付…' : pending ? '正在确认积分到账…' : '购买 ' + purchaseOption.points + ' 积分 · ' + priceText}}"
          disabled="{{paying || pending}}"
          loading="{{paying || pending}}"
          bindaction="submitPurchase"
        ></app-button>
      </view>
      <text class="footer-note">未完成支付不会扣款；支付成功后自动确认入账并保留原输入。</text>
    </view>
  </block>
</view>
