.detail-screen {
  min-height: 100vh;
  padding: 0 34rpx calc(50rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 85% 11%,rgba(204,194,255,.28),transparent 24%),
    radial-gradient(circle at 7% 72%,rgba(226,215,255,.22),transparent 28%),
    linear-gradient(158deg,#fafbff,#f7f6ff 56%,#faf8ff);
}

.detail-content { padding-top: 20rpx; }
.detail-hero { padding: 28rpx 20rpx 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.detail-icon-shell { width: 110rpx; height: 110rpx; overflow: hidden; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg,rgba(255,255,255,.96),rgba(230,223,255,.78)); box-shadow: 0 18rpx 38rpx rgba(93,75,192,.10); }
.detail-icon-shell image { width: 152rpx; height: 152rpx; max-width: none; }
.detail-title { margin-top: 24rpx; color: #101b3d; font-size: 40rpx; font-weight: 760; }
.detail-subtitle { max-width: 570rpx; margin-top: 13rpx; color: #7d86a0; font-size: 23rpx; line-height: 1.55; }
.detail-sections { display: flex; flex-direction: column; gap: 18rpx; }
.detail-card { padding: 27rpx 28rpx; border-radius: 30rpx; }
.section-title { display: block; color: #18213d; font-size: 28rpx; font-weight: 700; }
.detail-lines { margin-top: 17rpx; display: flex; flex-direction: column; gap: 13rpx; }
.detail-line { display: flex; align-items: flex-start; gap: 13rpx; color: #66708d; font-size: 22rpx; line-height: 1.58; }
.line-dot { flex: 0 0 auto; width: 9rpx; height: 9rpx; margin-top: 13rpx; border-radius: 50%; background: linear-gradient(135deg,#8d72f7,#5f55ec); box-shadow: 0 0 12rpx rgba(101,82,245,.28); }
.detail-primary { margin-top:30rpx !important; }
.detail-note { display: block; margin-top: 19rpx; color: #989eb0; font-size: 18rpx; text-align: center; }
.qr-contact-card { margin-top: 8rpx; padding: 32rpx 30rpx 28rpx; border-radius: 32rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.customer-qr { width: 360rpx; height: 377rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 15rpx 34rpx rgba(46,48,76,.10); }
.qr-placeholder { width: 330rpx; height: 330rpx; border-radius: 25rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: #8d93a7; background: linear-gradient(145deg,#fff,#f4f1ff); border: 2rpx dashed #c9c0f7; font-size: 22rpx; }
.qr-grid { width: 132rpx; height: 132rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; }
.qr-grid view { border-radius: 7rpx; background: linear-gradient(145deg,#9980f7,#6257ef); opacity: .80; }
.qr-title { margin-top: 25rpx; color: #18213c; font-size: 29rpx; font-weight: 700; }
.qr-description { max-width: 560rpx; margin-top: 13rpx; color: #747d98; font-size: 21rpx; line-height: 1.55; }
.qr-safety { max-width: 580rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #ecebf4; color: #a0a5b6; font-size: 18rpx; line-height: 1.55; }

@media (max-height: 740px) {
  .detail-hero { padding-top: 12rpx; padding-bottom: 20rpx; }
  .detail-icon-shell { width: 88rpx; height: 88rpx; }
  .detail-title { margin-top: 17rpx; font-size: 35rpx; }
  .detail-card { padding: 22rpx 24rpx; }
  .detail-primary { margin-top:22rpx !important; }
  .customer-qr { width: 286rpx; height: 299rpx; }
  .qr-placeholder { width: 270rpx; height: 270rpx; }
}
