.account-screen {
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  padding: 0 40rpx calc(210rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 83% 14%, rgba(211, 204, 255, 0.31), transparent 24%),
    radial-gradient(circle at 8% 50%, rgba(225, 218, 255, 0.24), transparent 28%),
    linear-gradient(158deg, #fafbff 0%, #f8f7ff 48%, #f5f5ff 100%);
}

.account-aurora { position: absolute; border-radius: 50%; pointer-events: none; }
.aurora-top { width: 390rpx; height: 330rpx; right: -150rpx; top: 30rpx; background: radial-gradient(circle, rgba(189, 174, 255, 0.18), transparent 67%); }
.aurora-middle { width: 430rpx; height: 360rpx; left: -210rpx; top: 650rpx; background: radial-gradient(circle, rgba(212, 205, 255, 0.18), transparent 68%); }
.account-content { position: relative; z-index: 2; }

.account-hero { min-height: 248rpx; padding: 16rpx 6rpx 8rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; position: relative; }
.profile-identity { min-width: 0; flex: 1; display: flex; align-items: center; gap: 26rpx; padding-left: 10rpx; }
.profile-avatar { flex: 0 0 124rpx; width: 124rpx; height: 124rpx; position: relative; z-index: 3; border-radius: 50%; overflow: hidden; border: 4rpx solid rgba(255, 255, 255, 0.96); background: #efedff; box-shadow: 0 14rpx 34rpx rgba(63, 62, 98, 0.14); }
.profile-avatar.fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #f4f2ff, #e7e3fa); }
.profile-avatar.fallback image { width: 112rpx; height: 112rpx; }
.profile-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 16rpx; z-index: 4; }
.profile-name { display: block; max-width: 100%; overflow: hidden; color: #111b3c; font-size: 36rpx; line-height: 1.2; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
.wechat-profile-row { display: flex; align-items: center; gap: 10rpx; color: #7f87a0; font-size: 22rpx; }
.wechat-profile-row image { width: 29rpx; height: 25rpx; opacity: 0.5; filter: grayscale(1) brightness(0.72); }
.identity-visual { flex: 0 0 244rpx; width: 244rpx; height: 220rpx; margin-right: -8rpx; opacity: 0.94; }

.account-notice { margin: 10rpx 0 20rpx; padding: 22rpx 24rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: rgba(255, 245, 235, 0.92); border: 2rpx solid rgba(255, 211, 171, 0.9); box-shadow: 0 14rpx 30rpx rgba(122, 84, 35, 0.08); }
.account-notice-disabled { opacity: 0.72; }
.account-notice-copy { flex: 1; min-width: 0; }
.account-notice-title { display: block; color: #6e3f12; font-size: 25rpx; font-weight: 700; }
.account-notice-desc { display: block; margin-top: 6rpx; color: #9b6a3f; font-size: 21rpx; line-height: 1.45; }
.account-notice-action { flex: 0 0 auto; color: #c46a19; font-size: 22rpx; font-weight: 700; }

.account-summary { min-height: 190rpx; padding: 30rpx 27rpx; border-radius: 34rpx; display: flex; align-items: stretch; background: rgba(255, 255, 255, 0.58); border: 2rpx solid rgba(255, 255, 255, 0.86); box-shadow: 0 19rpx 48rpx rgba(69, 69, 108, 0.07); }
.summary-item { flex: 1; min-width: 0; display: flex; align-items: center; gap: 20rpx; }
.summary-divider { width: 1rpx; margin: 10rpx 28rpx; background: rgba(213, 213, 231, 0.82); }
.summary-icon { flex: 0 0 auto; width: 74rpx; height: 74rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle, rgba(234, 229, 255, 0.95), rgba(225, 218, 255, 0.52)); }
.summary-icon image { width: 112rpx; height: 112rpx; }
.summary-copy { min-width: 0; }
.summary-value { display: block; color: #101a3b; font-size: 43rpx; line-height: 1; font-weight: 760; }
.summary-label { display: block; margin-top: 17rpx; color: #17213e; font-size: 25rpx; font-weight: 680; }
.summary-meta { display: block; margin-top: 12rpx; color: #8a91aa; font-size: 20rpx; white-space: nowrap; }
.summary-link { display: flex; align-items: center; gap: 8rpx; }

.section-heading { margin: 32rpx 0 13rpx; color: #111b38; font-size: 30rpx; font-weight: 750; }
.service-heading { margin-top: 27rpx; }
.account-menu,
.service-menu { overflow: hidden; border-radius: 30rpx; background: rgba(255, 255, 255, 0.72); border: 2rpx solid rgba(255, 255, 255, 0.86); box-shadow: 0 16rpx 42rpx rgba(67, 71, 108, 0.06); }
.menu-divider { height: 1rpx; margin: 0 27rpx; background: rgba(222, 223, 237, 0.9); }

.expanded-list { border-top: 1rpx solid rgba(224, 225, 238, 0.9); background: rgba(249, 249, 253, 0.74); }
.order-row,
.ledger-row { min-height: 96rpx; padding: 18rpx 26rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #ececf4; }
.order-row:last-child,
.ledger-row:last-child { border-bottom: 0; }
.row-title { display: block; color: #20263b; font-size: 22rpx; font-weight: 630; }
.row-meta { display: block; margin-top: 5rpx; color: #9197aa; font-size: 18rpx; }
.order-price,
.ledger-amount { color: #30374d; font-size: 23rpx; font-weight: 700; }
.ledger-amount.positive { color: #3f9b64; }
.sub-empty { padding: 27rpx 24rpx; color: #9298aa; font-size: 20rpx; text-align: center; }

.logout-button { min-height: 86rpx; margin-top: 28rpx; border-radius: 25rpx; }
.version-note { display: block; margin-top: 22rpx; color: #a0a5b5; font-size: 20rpx; text-align: center; }

.nickname-editor-backdrop { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(20, 22, 35, 0.46); }
.nickname-editor { width: 100%; overflow: hidden; border-radius: 28rpx; background: #ffffff; box-shadow: 0 28rpx 80rpx rgba(28, 28, 52, 0.2); }
.nickname-editor-title { display: block; padding: 36rpx 32rpx 24rpx; color: #141a32; font-size: 32rpx; font-weight: 700; text-align: center; }
.nickname-input-shell { margin: 0 32rpx 32rpx; min-height: 82rpx; padding: 0 22rpx; border: 2rpx solid #e3e1ef; border-radius: 18rpx; display: flex; align-items: center; gap: 14rpx; background: #fafaff; box-sizing: border-box; }
.nickname-input { flex: 1; min-width: 0; height: 80rpx; color: #151b35; font-size: 28rpx; }
.nickname-count { flex: 0 0 auto; color: #9298ad; font-size: 22rpx; }
.nickname-editor-actions { min-height: 96rpx; border-top: 1rpx solid #ecebf3; display: flex; }
.nickname-editor-action { width: 50%; min-height: 96rpx; margin: 0; border-radius: 0; display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 650; background: #ffffff; }
.nickname-cancel { color: #20263c; border-right: 1rpx solid #ecebf3; }
.nickname-save { color: var(--action-secondary-text); }
.nickname-editor-action[disabled] { color: #a5a9b7; background: #f7f7fa; }

button::after { border: 0; }

@media (max-height: 740px) {
  .account-screen { padding-bottom: calc(195rpx + env(safe-area-inset-bottom)); }
  .account-hero { min-height: 220rpx; padding-top: 10rpx; }
  .profile-identity { gap: 20rpx; padding-left: 6rpx; }
  .profile-avatar { flex-basis: 108rpx; width: 108rpx; height: 108rpx; }
  .profile-name { font-size: 32rpx; }
  .profile-copy { gap: 12rpx; }
  .identity-visual { flex-basis: 210rpx; width: 210rpx; height: 198rpx; margin-right: -6rpx; }
  .account-summary { min-height: 168rpx; padding: 24rpx; }
  .summary-icon { width: 64rpx; height: 64rpx; }
  .summary-value { font-size: 38rpx; }
  .summary-label { margin-top: 12rpx; font-size: 23rpx; }
  .summary-meta { margin-top: 8rpx; font-size: 18rpx; }
  .section-heading { margin-top: 24rpx; }
}
