<view class="account-screen screen-shell">
  <app-nav transparent="{{true}}"></app-nav>
  <view class="account-aurora aurora-top"></view>
  <view class="account-aurora aurora-middle"></view>

  <view wx:if="{{state === 'loading'}}" class="account-state">
    <page-state mode="loading" title="正在同步账户" description="正在获取声音、积分和订单信息…"></page-state>
  </view>

  <view wx:elif="{{state === 'error'}}" class="account-state soft-card">
    <page-state mode="error" title="账户信息暂时不可用" description="{{errorMessage}}" actionText="重新加载" bindaction="retryLoad"></page-state>
  </view>

  <view wx:else class="account-content fade-in">
    <view class="account-hero luminous-card">
      <image wx:if="{{user.avatarUrl}}" class="profile-avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="profile-avatar fallback"><image src="/assets/ui/user-outline.png" mode="aspectFit"></image></view>

      <view class="profile-copy">
        <text class="profile-name">{{user.nickname || '微信用户'}}</text>
        <view class="wechat-profile-row">
          <image src="/assets/ui/wechat-mark.png" mode="aspectFit"></image>
          <text>微信账号资料</text>
        </view>
        <button class="edit-profile-button" bindtap="editNickname" disabled="{{updatingProfile}}">
          <image src="/assets/ui/account-edit.webp" mode="aspectFit"></image>
          <text>编辑资料</text>
        </button>
      </view>

      <image class="identity-visual" src="/assets/ui/account-identity-hero.png" mode="aspectFit"></image>
    </view>

    <view class="account-summary luminous-card">
      <view class="summary-item" bindtap="goVoices">
        <view class="summary-icon"><image src="/assets/ui/account-stat-voices.webp" mode="aspectFit"></image></view>
        <view class="summary-copy">
          <text class="summary-value">{{voiceCount}}</text>
          <text class="summary-label">我的声音</text>
          <view class="summary-meta summary-link"><text>查看全部</text><app-chevron direction="right" size="12"></app-chevron></view>
        </view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <view class="summary-icon"><image src="/assets/ui/account-stat-points.webp" mode="aspectFit"></image></view>
        <view class="summary-copy">
          <text class="summary-value">{{availablePoints}}</text>
          <text class="summary-label">剩余积分</text>
          <text class="summary-meta">账号共享积分 ⓘ</text>
        </view>
      </view>
    </view>

    <view class="section-heading"><text>账户</text></view>
    <view class="account-menu luminous-card">
      <menu-row icon="/assets/ui/account-orders.webp" title="我的订单" description="查看支付和到账记录" chevron="{{orderExpanded ? '⌃' : '›'}}" bindaction="toggleOrders"></menu-row>
      <view wx:if="{{orderExpanded}}" class="expanded-list">
        <view wx:if="{{orders.length === 0}}" class="sub-empty">还没有订单</view>
        <view wx:for="{{orders}}" wx:key="id" class="order-row">
          <view><text class="row-title">购买 {{item.pointsText}}</text><text class="row-meta">{{item.timeText}} · {{item.statusText}}</text></view>
          <text class="order-price">{{item.priceText}}</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <menu-row icon="/assets/ui/account-points.webp" title="积分记录" description="赠送、购买和成功生成流水" chevron="{{ledgerExpanded ? '⌃' : '›'}}" bindaction="toggleLedgers"></menu-row>
      <view wx:if="{{ledgerExpanded}}" class="expanded-list">
        <view wx:if="{{ledgers.length === 0}}" class="sub-empty">还没有积分记录</view>
        <view wx:for="{{ledgers}}" wx:key="id" class="ledger-row">
          <view><text class="row-title">{{item.title}}</text><text class="row-meta">{{item.voiceName || '私有声音'}} · {{item.timeText}}</text></view>
          <text class="ledger-amount {{item.positive ? 'positive' : ''}}">{{item.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="section-heading service-heading"><text>服务</text></view>
    <view class="service-menu luminous-card">
      <menu-row itemKey="help" icon="/assets/ui/account-help.webp" title="使用帮助" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="contact" icon="/assets/ui/account-service.webp" title="联系客服" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="service" icon="/assets/ui/points-bag.png" title="退款与售后" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="feedback" icon="/assets/ui/chat-mode.png" title="意见反馈" bindaction="showInfo"></menu-row>
    </view>
  </view>

  <bottom-sheet visible="{{profileEditorVisible}}" sheet-class="account-profile-sheet" bindclose="closeProfileEditor">
    <text class="sheet-title">编辑个人资料</text>
    <text class="sheet-description">头像和昵称仅用于你的账号展示</text>
    <form class="profile-editor-form" bindsubmit="saveProfile">
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseProfileAvatar" binderror="onProfileAvatarChooseError">
          <image wx:if="{{profileDraftAvatarUrl}}" class="avatar-preview" src="{{profileDraftAvatarUrl}}" mode="aspectFill"></image>
          <image wx:else class="avatar-placeholder" src="/assets/ui/user-outline.png" mode="aspectFit"></image>
          <text>更换微信头像</text>
        </button>
        <button wx:if="{{profileAvatarFallbackVisible}}" class="profile-album-button" bindtap="chooseProfileAvatarFromAlbum">从相册或相机选择头像</button>
        <input class="nickname-input" name="nickname" type="nickname" value="{{profileDraftNickname}}" maxlength="20" placeholder="选择或填写微信昵称" bindinput="onProfileNicknameInput" />
        <text wx:if="{{profileErrorMessage}}" class="profile-editor-error">{{profileErrorMessage}}</text>
        <view class="ui-form-actions">
          <button class="ui-form-button ui-form-button--secondary {{updatingProfile ? 'is-disabled' : ''}}" type="default" bindtap="closeProfileEditor" disabled="{{updatingProfile}}">取消</button>
          <button class="ui-form-button ui-form-button--primary {{updatingProfile ? 'is-disabled' : ''}}" form-type="submit" disabled="{{updatingProfile}}">{{updatingProfile ? '保存中…' : '保存资料'}}</button>
        </view>
    </form>
    <view class="sheet-settings">
      <text data-type="privacy" bindtap="showInfo">数据与隐私</text><text>·</text><text data-type="terms" bindtap="showInfo">服务协议</text><text>·</text><text data-type="rules" bindtap="showInfo">声音规则</text>
    </view>
    <button class="sheet-delete-account" bindtap="removeAccount" disabled="{{deletingAccount}}">{{deletingAccount ? '正在注销…' : '注销账号'}}</button>
  </bottom-sheet>
</view>
