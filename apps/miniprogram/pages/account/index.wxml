<view class="account-screen">
  <app-nav transparent="{{true}}"></app-nav>
  <view class="account-aurora aurora-top"></view>
  <view class="account-aurora aurora-middle"></view>

  <view class="account-content fade-in">
    <view class="account-hero">
      <image wx:if="{{avatarDisplayUrl}}" class="profile-avatar" src="{{avatarDisplayUrl}}" mode="aspectFill" binderror="onAvatarLoadError" bindtap="editAvatar" aria-label="更换头像"></image>
      <view wx:else class="profile-avatar fallback" bindtap="editAvatar" role="button" aria-label="更换头像"><image src="/assets/ui/user-outline.png" mode="aspectFit"></image></view>

      <view class="profile-copy">
        <text class="profile-name">{{(user && user.nickname) || '微信用户'}}</text>
        <view class="wechat-profile-row">
          <image src="/assets/ui/wechat-mark.png" mode="aspectFit"></image>
          <text>微信账号资料</text>
        </view>
        <button class="secondary-button edit-profile-button" bindtap="editProfile" disabled="{{updatingProfile || updatingAvatar}}">
          <image src="/assets/ui/account-edit.webp" mode="aspectFit"></image>
          <text class="edit-profile-label">{{updatingAvatar ? '头像同步中…' : updatingProfile ? '保存中…' : '编辑资料'}}</text>
        </button>
      </view>

      <image class="identity-visual" src="/assets/ui/account-identity-hero.png" mode="aspectFit"></image>
    </view>

    <view wx:if="{{errorMessage}}" class="account-notice {{refreshing ? 'account-notice-disabled' : ''}}" bindtap="retryLoad" role="button">
      <view class="account-notice-copy">
        <text class="account-notice-title">账户信息同步不完整</text>
        <text class="account-notice-desc">{{errorMessage}}</text>
      </view>
      <text class="account-notice-action">{{refreshing ? '重试中…' : '点击重试'}}</text>
    </view>

    <view class="account-summary glass-card">
      <view class="summary-item" bindtap="goVoices">
        <view class="summary-icon"><image src="/assets/ui/account-stat-voices.webp" mode="aspectFit"></image></view>
        <view class="summary-copy">
          <text class="summary-value">{{voiceCount}}</text>
          <text class="summary-label">我的声音</text>
          <view class="summary-meta summary-link"><text>查看全部</text><app-chevron direction="right" size="12"></app-chevron></view>
        </view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item" bindtap="openPurchase">
        <view class="summary-icon"><image src="/assets/ui/account-stat-points.webp" mode="aspectFit"></image></view>
        <view class="summary-copy">
          <text class="summary-value">{{availablePoints}}</text>
          <text class="summary-label">剩余积分</text>
          <text class="summary-meta">账号共享积分 ⓘ</text>
        </view>
      </view>
    </view>

    <view class="section-heading"><text>账户</text></view>
    <view class="account-menu soft-card">
      <menu-row icon="/assets/ui/account-orders.webp" title="我的订单" description="查看支付和到账记录" chevron="{{orderExpanded ? '⌃' : '›'}}" bindaction="toggleOrders"></menu-row>
      <view wx:if="{{orderExpanded}}" class="expanded-list">
        <view wx:if="{{orders.length === 0}}" class="sub-empty">还没有订单</view>
        <view wx:for="{{orders}}" wx:key="id" class="order-row">
          <view><text class="row-title">购买 {{item.pointsText}}</text><text class="row-meta">{{item.timeText}} · {{item.statusText}}</text></view>
          <text class="order-price">{{item.priceText}}</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <menu-row icon="/assets/ui/account-points.webp" title="积分记录" description="赠送、购买和成功生成流水" chevron="{{ledgerExpanded ? '⌃' : '›'}}" bindaction="toggleLedgers"></menu-row>
      <view wx:if="{{ledgerExpanded}}" class="expanded-list">
        <view wx:if="{{ledgers.length === 0}}" class="sub-empty">还没有积分记录</view>
        <view wx:for="{{ledgers}}" wx:key="id" class="ledger-row">
          <view><text class="row-title">{{item.title}}</text><text class="row-meta">{{item.voiceName || '私有声音'}} · {{item.timeText}}</text></view>
          <text class="ledger-amount {{item.positive ? 'positive' : ''}}">{{item.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="section-heading service-heading"><text>服务</text></view>
    <view class="service-menu soft-card">
      <menu-row itemKey="help" icon="/assets/ui/account-help.webp" title="使用帮助" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="service" icon="/assets/ui/account-service.webp" title="退款与售后" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="feedback" icon="/assets/ui/account-points.webp" title="意见反馈" bindaction="showInfo"></menu-row>
    </view>

    <view class="section-heading service-heading"><text>隐私与规则</text></view>
    <view class="service-menu soft-card">
      <menu-row itemKey="privacy" icon="/assets/ui/account-help.webp" title="数据与隐私" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="rules" icon="/assets/ui/account-service.webp" title="声音使用规则" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="policy" icon="/assets/ui/account-orders.webp" title="隐私政策" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="terms" icon="/assets/ui/account-orders.webp" title="服务协议" bindaction="showInfo"></menu-row>
      <view class="menu-divider"></view>
      <menu-row itemKey="ai" icon="/assets/ui/account-points.webp" title="AI生成标识说明" bindaction="showInfo"></menu-row>
    </view>

    <button class="danger-button logout-button {{deletingAccount ? 'button-disabled' : ''}}" bindtap="removeAccount" disabled="{{deletingAccount}}">{{deletingAccount ? '正在注销…' : '注销账号'}}</button>
    <text class="version-note">那年的TA · 微信原生小程序前端 v0.4</text>
  </view>

  <view wx:if="{{showNicknameEditor}}" class="nickname-editor-backdrop" bindtap="closeNicknameEditor" catchtouchmove="noop">
    <view class="nickname-editor" catchtap="noop">
      <text class="nickname-editor-title">修改昵称</text>
      <view class="nickname-input-shell">
        <input
          class="nickname-input"
          type="nickname"
          value="{{nicknameDraft}}"
          maxlength="10"
          focus="{{showNicknameEditor}}"
          placeholder="请输入昵称"
          bindinput="onNicknameInput"
        />
        <text class="nickname-count">{{nicknameCount}}/10</text>
      </view>
      <view class="nickname-editor-actions">
        <button class="nickname-editor-action nickname-cancel" bindtap="closeNicknameEditor" disabled="{{updatingProfile}}">取消</button>
        <button class="nickname-editor-action nickname-save" bindtap="saveNickname" disabled="{{updatingProfile}}">{{updatingProfile ? '保存中…' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
