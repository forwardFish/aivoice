.bottom-action-bar { position:fixed; z-index:45; left:0; right:0; bottom:0; padding:14rpx 34rpx calc(14rpx + env(safe-area-inset-bottom)); background:rgba(250,250,255,.97); border-top:1rpx solid rgba(226,226,237,.92); box-shadow:0 -16rpx 38rpx rgba(58,61,94,.08); backdrop-filter:blur(20rpx); box-sizing:border-box; }
.bottom-action-content { width:100%; min-width:0; }
.is-row { display:flex; align-items:center; gap:18rpx; }
.is-stack { display:flex; flex-direction:column; gap:10rpx; }
.is-compact { padding-top:10rpx; padding-bottom:calc(10rpx + env(safe-area-inset-bottom)); }

@media (max-height:740px) {
  .bottom-action-bar { padding-top:11rpx; padding-bottom:calc(11rpx + env(safe-area-inset-bottom)); }
}
