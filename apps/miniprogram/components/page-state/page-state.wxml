<view class="state-shell {{compact ? 'state-compact' : ''}}">
  <view wx:if="{{mode === 'loading'}}" class="state-visual loading-visual">
    <view class="loading-ring"></view>
    <view class="loading-wave"><text class="state-wave-bar"></text><text class="state-wave-bar"></text><text class="state-wave-bar"></text><text class="state-wave-bar"></text><text class="state-wave-bar"></text></view>
  </view>
  <view wx:elif="{{mode === 'error'}}" class="state-visual error-visual">!</view>
  <view wx:elif="{{mode === 'empty'}}" class="state-visual empty-visual">
    <image class="empty-wave-image" src="/assets/ui/icon-waveform.png" mode="aspectFit"></image>
  </view>
  <view wx:else class="state-visual success-visual">✓</view>
  <text class="state-title">{{title}}</text>
  <text wx:if="{{displayDescription}}" class="state-description">{{displayDescription}}</text>
  <view wx:if="{{actionText}}" class="state-action-shell"><app-button size="medium" label="{{actionText}}" bindaction="onAction"></app-button></view>
</view>
