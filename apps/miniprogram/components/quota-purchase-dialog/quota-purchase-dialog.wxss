.dialog-mask { position:fixed; z-index:999; inset:0; padding:34rpx; display:flex; align-items:center; justify-content:center; background:rgba(19,22,39,.54); }
.dialog-card { width:100%; max-width:650rpx; padding:30rpx 34rpx 31rpx; position:relative; overflow:hidden; border-radius:46rpx; text-align:center; background:radial-gradient(circle at 80% 2%,rgba(207,194,255,.38),transparent 33%),radial-gradient(circle at 5% 60%,rgba(255,224,207,.26),transparent 30%),linear-gradient(160deg,#fff 0%,#f8f6ff 100%); border:1rpx solid rgba(255,255,255,.95); box-shadow:0 42rpx 110rpx rgba(16,19,42,.30),inset 0 1rpx 0 rgba(255,255,255,.99); }
.dialog-close { width:58rpx; height:58rpx; position:absolute; z-index:5; top:20rpx; right:20rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#757b90; background:rgba(255,255,255,.80); border:1rpx solid rgba(229,229,239,.88); box-shadow:0 8rpx 20rpx rgba(60,64,93,.07); font-size:35rpx; font-weight:300; }
.dialog-visual { width:236rpx; height:200rpx; margin:0 auto 4rpx; display:flex; align-items:center; justify-content:center; }
.points-bag-image { width:220rpx; height:220rpx; }
.dialog-title,.dialog-description,.package-eyebrow,.package-code,.package-price,.package-renew,.dialog-note,.dialog-message{display:block}
.dialog-title { color:#12182f; font-size:38rpx; font-weight:760; }
.dialog-description { max-width:520rpx; margin:14rpx auto 0; color:#7c8399; font-size:23rpx; line-height:1.62; }
.package-card { margin-top:26rpx; padding:22rpx 24rpx; border-radius:30rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; text-align:left; background:radial-gradient(circle at 82% 12%,rgba(255,228,209,.32),transparent 42%),linear-gradient(145deg,#f1edff,#fff); border:2rpx solid rgba(190,178,249,.76); box-shadow:0 14rpx 30rpx rgba(101,82,245,.10); }
.package-left{flex:1;min-width:0}.package-eyebrow{color:#6755dd;font-size:18rpx;font-weight:680}.package-points{margin-top:5rpx;display:flex;align-items:baseline;gap:7rpx}.points-number{color:#151b32;font-size:44rpx;line-height:1;font-weight:780}.points-unit{color:#5f667d;font-size:22rpx;font-weight:650}.package-code{margin-top:7rpx;color:#9297aa;font-size:17rpx}.package-right{flex:0 0 auto;text-align:right}.package-price{color:#ee684c;font-size:35rpx;font-weight:780}.package-renew{margin-top:7rpx;color:#898ea2;font-size:18rpx}
.benefit-row { margin-top:18rpx; display:flex; justify-content:center; gap:28rpx; color:#747b91; font-size:19rpx; }.benefit-row view{display:flex;align-items:center;gap:7rpx}.benefit-check{color:#58b679;font-weight:780}
.dialog-message { margin-top:16rpx; color:#d95d66; font-size:20rpx; line-height:1.45; }
.dialog-primary { width:100%; height:92rpx; margin-top:24rpx; border-radius:28rpx; color:#fff; background:linear-gradient(135deg,#6252f4,#8d68f2); box-shadow:0 18rpx 38rpx rgba(101,82,245,.24); font-size:28rpx; font-weight:690; }.dialog-primary[disabled]{opacity:.56;box-shadow:none}
.dialog-secondary { width:100%; height:66rpx; margin-top:8rpx; color:#7c8398; background:transparent; font-size:23rpx; }.dialog-note{color:#989cad;font-size:17rpx;line-height:1.45}
