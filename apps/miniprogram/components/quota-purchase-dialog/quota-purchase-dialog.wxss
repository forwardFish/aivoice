.dialog-mask { position:fixed; z-index:999; inset:0; padding:34rpx; display:flex; align-items:center; justify-content:center; background:rgba(19,22,39,.54); }
.dialog-card { width:100%; max-width:504rpx; padding:24rpx 28rpx 24rpx; position:relative; overflow:hidden; border-radius:42rpx; text-align:center; background:radial-gradient(circle at 80% 2%,rgba(207,194,255,.38),transparent 33%),radial-gradient(circle at 5% 60%,rgba(255,224,207,.26),transparent 30%),linear-gradient(160deg,#fff 0%,#f8f6ff 100%); border:1rpx solid rgba(255,255,255,.95); box-shadow:0 42rpx 110rpx rgba(16,19,42,.30),inset 0 1rpx 0 rgba(255,255,255,.99); }
.dialog-close { width:58rpx; height:58rpx; position:absolute; z-index:5; top:20rpx; right:20rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#757b90; background:rgba(255,255,255,.80); border:1rpx solid rgba(229,229,239,.88); box-shadow:0 8rpx 20rpx rgba(60,64,93,.07); font-size:35rpx; font-weight:300; }
.dialog-visual { width:170rpx; height:148rpx; margin:0 auto 2rpx; display:flex; align-items:center; justify-content:center; }
.points-bag-image { width:164rpx; height:164rpx; }
.dialog-title,.dialog-description,.package-eyebrow,.package-code,.package-price,.package-renew,.dialog-note,.dialog-message{display:block}
.dialog-title { color:#12182f; font-size:38rpx; font-weight:760; }
.dialog-description { max-width:500rpx; margin:6rpx auto 0; color:#7c8399; font-size:21rpx; line-height:1.55; }
.dialog-message { margin-top:16rpx; color:#d95d66; font-size:20rpx; line-height:1.45; }
.dialog-primary { width:100%; height:82rpx; margin-top:24rpx; border-radius:26rpx; color:#fff; background:linear-gradient(135deg,#6252f4,#8d68f2); box-shadow:0 18rpx 38rpx rgba(101,82,245,.24); font-size:25rpx; font-weight:690; }.dialog-primary[disabled]{opacity:.56;box-shadow:none}
.cta-split { width:100%; padding:0 28rpx; display:flex; align-items:center; justify-content:space-between; font-size:25rpx; font-weight:690; }
.dialog-secondary { width:100%; height:56rpx; margin-top:6rpx; color:#7c8398; background:transparent; font-size:21rpx; }.dialog-note{color:#989cad;font-size:15rpx;line-height:1.4}
