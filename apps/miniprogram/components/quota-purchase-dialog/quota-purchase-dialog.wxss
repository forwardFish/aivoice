.dialog-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 22, 37, 0.58);
}

.dialog-card {
  width: 100%;
  max-width: 620rpx;
  padding: 44rpx 40rpx 30rpx;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 38rpx 100rpx rgba(21, 22, 42, 0.28);
  text-align: center;
}

.dialog-visual {
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto 20rpx;
  position: relative;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #ffffff, #eae7ff 60%, #d4dcff);
  box-shadow: 0 20rpx 42rpx rgba(101, 82, 245, 0.18);
}

.bag-handle {
  position: absolute;
  left: 39rpx;
  top: 25rpx;
  width: 46rpx;
  height: 34rpx;
  border: 6rpx solid #7563ef;
  border-bottom: none;
  border-radius: 24rpx 24rpx 0 0;
}

.bag-body {
  position: absolute;
  left: 27rpx;
  top: 50rpx;
  width: 70rpx;
  height: 58rpx;
  border-radius: 12rpx 12rpx 18rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 34rpx;
  background: linear-gradient(135deg, #8f7dff, #6552f5);
}

.dialog-title {
  display: block;
  font-size: 35rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #11172d;
}

.dialog-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #737b94;
}

.product-card {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  background: linear-gradient(135deg, #f5f3ff, #fbfbff);
  border: 1rpx solid #e5e1ff;
}

.product-quota {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #6552f5;
}

.product-copy {
  display: block;
  margin-top: 5rpx;
  font-size: 23rpx;
  color: #737b94;
}

.product-price {
  font-size: 38rpx;
  font-weight: 700;
  color: #6552f5;
}

.benefits {
  margin: 24rpx 8rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: left;
  font-size: 23rpx;
  line-height: 1.55;
  color: #737b94;
}

.pending-box {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #f4f2ff;
  color: #6552f5;
  font-size: 23rpx;
}

.mini-spinner {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(101, 82, 245, 0.18);
  border-top-color: #6552f5;
  animation: dialog-spin 0.9s linear infinite;
}

.buy-button {
  width: 100%;
  min-height: 94rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--action-primary-start, #6552f5), var(--action-primary-end, #8d68f6));
  box-shadow: 0 18rpx 36rpx var(--action-primary-shadow, rgba(101, 82, 245, 0.24));
  font-size: 29rpx;
  font-weight: 650;
}

.buy-button.is-disabled {
  opacity: 0.62;
  box-shadow: none;
}

.cancel-button {
  width: 100%;
  height: 76rpx;
  margin-top: 10rpx;
  color: var(--action-secondary-text, #6552f5);
  font-size: 26rpx;
}

.buy-button::after,
.cancel-button::after { border: none; }

@keyframes dialog-spin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}
