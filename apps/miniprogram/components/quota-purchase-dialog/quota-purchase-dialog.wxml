<view wx:if="{{visible}}" class="dialog-overlay" catchtouchmove="noop" bindtap="cancel">
  <view class="dialog-card fade-in" catchtap="noop">
    <view
      role="button"
      aria-label="关闭"
      class="dialog-close"
      bindtap="cancel"
    >
      ×
    </view>

    <view class="dialog-visual-shell">
      <view class="dialog-visual">
        <view class="bag-handle"></view>
        <view class="bag-body"><text>♡</text></view>
      </view>
    </view>

    <text class="dialog-title">积分不足</text>
    <text class="dialog-subtitle">继续使用「{{voiceName || '这个声音'}}」</text>

    <view class="product-card">
      <view class="product-copy-block">
        <text class="product-quota">{{pointsText}}积分</text>
        <text class="product-copy">成功生成后扣除</text>
      </view>
      <text class="product-price">{{priceText}}</text>
    </view>

    <view class="benefits">
      <view class="benefit-item">
        <text class="benefit-dot">✓</text>
        <text class="benefit-text">对话和“说一句”通用</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-dot">✓</text>
        <text class="benefit-text">成功生成才扣积分</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-dot">✓</text>
        <text class="benefit-text">失败不扣积分</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-dot">✓</text>
        <text class="benefit-text">不自动续费</text>
      </view>
    </view>

    <view wx:if="{{pending}}" class="pending-box">
      <view class="mini-spinner"></view>
      <text>{{message || '正在确认支付结果和积分入账…'}}</text>
    </view>

    <view class="buy-button-row">
      <app-button
        class="dialog-app-button"
        custom-class="buy-button"
        label="{{paying ? '正在打开微信支付…' : pending ? '正在确认入账…' : '购买' + pointsText + '积分'}}"
        disabled="{{paying || pending}}"
        loading="{{paying || pending}}"
        bindaction="buy"
      ></app-button>
    </view>
    <view class="cancel-button-row">
      <app-button
        class="dialog-app-button"
        variant="ghost"
        size="compact"
        custom-class="cancel-button"
        label="暂不购买"
        disabled="{{paying || pending}}"
        bindaction="cancel"
      ></app-button>
    </view>
  </view>
</view>
