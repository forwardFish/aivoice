<view wx:if="{{visible}}" class="dialog-mask fade-in" catchtouchmove="noop" bindtap="cancel">
  <view class="dialog-card float-in" catchtap="noop">
    <button class="dialog-close" bindtap="cancel" aria-label="关闭">×</button>
    <view class="dialog-visual">
      <view class="bag-shadow"></view>
      <view class="bag-handle"></view>
      <view class="bag-body"><view class="bag-star">✦</view><view class="bag-wave"><text></text><text></text><text></text><text></text><text></text></view></view>
      <view class="coin coin-a">+</view><view class="coin coin-b">✦</view>
      <view class="spark spark-a"></view><view class="spark spark-b"></view>
    </view>
    <text class="dialog-title">积分已用完</text>
    <text class="dialog-description">继续使用“{{voiceName}}”生成新的声音内容，需要补充账户积分。</text>
    <view class="package-card">
      <view class="package-left">
        <text class="package-eyebrow">一次性积分包</text>
        <view class="package-points"><text class="points-number">{{pointsText}}</text><text class="points-unit">账户积分</text></view>
        <text class="package-code">每次成功生成消耗 1 积分</text>
      </view>
      <view class="package-right"><text class="package-price">{{priceText}}</text><text class="package-renew">不自动续费</text></view>
    </view>
    <view class="benefit-row"><view><text class="benefit-check">✓</text><text>支付成功后自动确认入账</text></view><view><text class="benefit-check">✓</text><text>所有声音共享</text></view></view>
    <text wx:if="{{message}}" class="dialog-message">{{message}}</text>
    <button class="dialog-primary" disabled="{{paying || pending}}" bindtap="buy">{{paying ? '正在调起支付…' : pending ? '正在确认到账…' : '立即购买'}}</button>
    <button class="dialog-secondary" disabled="{{paying || pending}}" bindtap="cancel">稍后再说</button>
    <text class="dialog-note">未完成支付不会扣款；支付成功后积分将自动同步。</text>
  </view>
</view>
