<view wx:if="{{visible}}" class="dialog-mask fade-in" catchtouchmove="noop" bindtap="cancel">
  <view class="dialog-card float-in" catchtap="noop">
    <button class="dialog-close" bindtap="cancel" aria-label="关闭">×</button>
    <view class="dialog-visual">
      <image class="points-bag-image" src="/assets/ui/points-bag.png" mode="aspectFit"></image>
    </view>
    <text class="dialog-title">积分已用完</text>
    <text class="dialog-description">购买后即可继续使用</text>
    <text wx:if="{{message}}" class="dialog-message">{{message}}</text>
    <button class="dialog-primary" disabled="{{paying || pending}}" bindtap="buy">
      <view class="cta-split">
        <text>{{paying ? '正在调起支付…' : pending ? '正在确认到账…' : '购买' + pointsText + '积分'}}</text>
        <text>{{pending ? '' : priceText}}</text>
      </view>
    </button>
    <button class="dialog-secondary" disabled="{{paying || pending}}" bindtap="cancel">稍后再说</button>
    <text class="dialog-note">成功生成后才扣 1 积分 · 不自动续费 · 支付成功后自动确认入账</text>
  </view>
</view>
