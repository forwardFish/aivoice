:host { width: 100%; display: block; }
.app-button { width: 100%; margin: 0 !important; padding: 0 28rpx !important; position: relative; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 29rpx; font-weight: 680; letter-spacing: 0.5rpx; box-sizing: border-box; }
.app-button::after { border: 0; }
.is-large { min-height: 92rpx; }
.is-medium { min-height: 78rpx; border-radius: 25rpx; font-size: 26rpx; }
.is-compact { min-height: 64rpx; border-radius: 21rpx; font-size: 23rpx; }
.is-primary { color:#fff; background:linear-gradient(135deg,var(--action-primary-start,#6552f5) 0%,var(--action-primary-end,#8d68f6) 100%); box-shadow:0 20rpx 42rpx var(--action-primary-shadow,rgba(101,82,245,.24)),inset 0 1rpx 0 rgba(255,255,255,.34); }
.is-secondary { color:var(--action-secondary-text,#6552f5); background:var(--action-secondary-bg,#f1efff); border:1rpx solid var(--action-secondary-border,#d8d2fb); box-shadow:0 12rpx 30rpx rgba(75,80,120,.06); }
.is-ghost { color: #747b92; background: transparent; box-shadow: none; }
.is-danger { color:#fff; background:linear-gradient(135deg,var(--action-danger-start,#dc6870),var(--action-danger-end,#c9515b)); box-shadow:0 18rpx 36rpx rgba(201,81,91,.20); }
.app-button.is-disabled { color:rgba(255,255,255,.78); background:linear-gradient(135deg,var(--action-disabled-start,#bcb7e7),var(--action-disabled-end,#c8c2eb)); opacity:.62; box-shadow:none; }
.is-secondary.is-disabled, .is-ghost.is-disabled { color: #9ca0b0; background: #f1f1f6; }
.button-label { display: block; line-height: 1.2; text-align: center; }
.button-spinner { width: 28rpx; height: 28rpx; position: absolute; left: 28rpx; top: 50%; border: 4rpx solid rgba(255, 255, 255, 0.36); border-top-color: #fff; border-radius: 50%; transform: translateY(-50%); animation: button-spin 0.8s linear infinite; box-sizing: border-box; }
.is-secondary .button-spinner, .is-ghost .button-spinner { border-color: rgba(101, 82, 245, 0.22); border-top-color: #6552f5; }
@keyframes button-spin { from { transform: translateY(-50%) rotate(0deg); } to { transform: translateY(-50%) rotate(360deg); } }
