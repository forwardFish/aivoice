.audio-shell {
  width: 100%;
  min-height: 118rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(230, 231, 243, 0.88);
  box-shadow: 0 12rpx 32rpx rgba(49, 55, 89, 0.06);
}

.audio-compact {
  min-height: 94rpx;
  padding: 12rpx 16rpx;
  border-radius: 22rpx;
}

.play-button {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1efff, #ffffff);
  box-shadow: 0 10rpx 24rpx rgba(101, 82, 245, 0.14);
}

.audio-compact .play-button {
  width: 62rpx;
  height: 62rpx;
}

.play-triangle {
  width: 0;
  height: 0;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #6552f5;
  margin-left: 6rpx;
}

.pause-bars {
  display: flex;
  gap: 8rpx;
}

.pause-bars text {
  width: 7rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #6552f5;
}

.audio-main {
  flex: 1;
  min-width: 0;
}

.audio-meta {
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.audio-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.35;
  color: #11172d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.audio-tag {
  flex: 0 0 auto;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #efedff;
  color: #6552f5;
  font-size: 20rpx;
}

.wave-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wave-bars {
  flex: 1;
  height: 52rpx;
  min-width: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.wave-bar {
  width: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #9d92ff, #6552f5);
  opacity: 0.68;
}

.wave-progress {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3rpx;
  border-radius: 999rpx;
  background: #6552f5;
}

.audio-time {
  flex: 0 0 auto;
  font-size: 23rpx;
  color: #737b94;
}
