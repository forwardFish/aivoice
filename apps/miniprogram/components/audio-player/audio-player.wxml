<view class="audio-player {{compact ? 'is-compact' : ''}} {{disabled ? 'is-disabled' : ''}}" bindtap="toggle">
  <view class="play-button {{playing ? 'is-playing' : ''}}">
    <image wx:if="{{!playing}}" class="play-image" src="/assets/ui/play-line.png" mode="aspectFit"></image>
    <view wx:else class="pause-icon"><text></text><text></text></view>
  </view>
  <view class="audio-main">
    <view wx:if="{{label || tag}}" class="audio-topline">
      <text class="audio-label">{{label || '试听声音'}}</text>
      <text wx:if="{{tag}}" class="audio-tag">{{tag}}</text>
    </view>
    <view class="wave-row">
      <view class="wave-bars">
        <view wx:for="{{bars}}" wx:key="index" class="wave-bar" style="height: {{item}}rpx;"></view>
        <view class="wave-progress" style="width: {{progress}}%;"></view>
      </view>
      <text class="audio-time">{{currentText}}</text>
    </view>
  </view>
</view>
