.nav-placeholder { width:100%; }
.nav-shell { width:100%; position:absolute; left:0; top:0; z-index:50; background:rgba(251,252,255,.90); border-bottom:1rpx solid rgba(232,233,243,.68); backdrop-filter:blur(20rpx); }
.nav-transparent { background:transparent; border-bottom-color:transparent; backdrop-filter:none; }
.nav-fixed { position:fixed; }
.nav-row { position:relative; display:flex; align-items:center; justify-content:center; }
.back-button { width:72rpx; height:72rpx; position:absolute; left:18rpx; top:50%; border-radius:50%; display:flex; align-items:center; justify-content:center; transform:translateY(-50%); }
.back-button:active { background:rgba(101,82,245,.07); }
.back-icon { width:26rpx; height:26rpx; border-left:5rpx solid #11172d; border-bottom:5rpx solid #11172d; border-radius:2rpx; transform:rotate(45deg); }
.nav-title { max-width:100%; padding:0 16rpx; overflow:hidden; color:#11172d; font-size:30rpx; font-weight:680; text-align:center; text-overflow:ellipsis; white-space:nowrap; }
.nav-right-action { min-width:72rpx; height:58rpx; padding:0 10rpx; position:absolute; top:50%; transform:translateY(-50%); color:#6552f5; background:transparent; font-size:24rpx; font-weight:640; }
