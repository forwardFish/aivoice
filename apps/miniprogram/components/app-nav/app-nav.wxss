.nav-placeholder {
  width: 100%;
}

.nav-shell {
  width: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 40;
  background: rgba(247, 248, 255, 0.92);
  border-bottom: 1rpx solid rgba(231, 233, 244, 0.72);
}

.nav-fixed {
  position: fixed;
}

.nav-transparent {
  background: transparent;
  border-bottom-color: transparent;
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 650;
  color: #11172d;
  text-align: center;
}

.nav-back {
  position: absolute;
  left: 28rpx;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-arrow {
  width: 25rpx;
  height: 25rpx;
  border-left: 5rpx solid #11172d;
  border-bottom: 5rpx solid #11172d;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.nav-right {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #6552f5;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 10rpx;
}
