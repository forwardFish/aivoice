.nav-placeholder {
  width: 100%;
}

.nav-shell {
  width: 100%;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 40;
  background: rgba(247, 248, 255, 0.92);
  border-bottom: 1rpx solid rgba(231, 233, 244, 0.72);
}

.nav-fixed {
  position: fixed;
}

.nav-transparent {
  background: transparent;
  border-bottom-color: transparent;
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-center {
  max-width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.nav-center-with-subtitle {
  gap: 4rpx;
  max-width: calc(100% - 72rpx);
  transform: translateX(-48rpx);
}

.nav-title {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 32rpx;
  font-weight: 650;
  color: #11172d;
  text-align: center;
}

.nav-subtitle {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 1.3;
  font-weight: 500;
  color: #7b8197;
  text-align: center;
}

.nav-back {
  position: absolute;
  left: 28rpx;
  top: 50%;
  width: 72rpx;
  height: 72rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-arrow {
  width: 25rpx;
  height: 25rpx;
  border-left: 5rpx solid #11172d;
  border-bottom: 5rpx solid #11172d;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.nav-right {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #11172d;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 400;
  padding: 16rpx 0 16rpx 20rpx;
  background: transparent;
  box-shadow: none;
}
