.bottom-sheet-mask { position:fixed; z-index:300; inset:0; display:flex; align-items:flex-end; background:rgba(20,23,45,.38); backdrop-filter:blur(12rpx); }
.bottom-sheet-panel { width:100%; max-height:88vh; overflow-y:auto; padding:24rpx 42rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:52rpx 52rpx 0 0; background:linear-gradient(155deg,rgba(255,255,255,.99),rgba(248,246,255,.99)); box-shadow:0 -28rpx 76rpx rgba(52,45,103,.16); box-sizing:border-box; }
.bottom-sheet-grabber { width:74rpx; height:8rpx; margin:0 auto 30rpx; border-radius:999rpx; background:#d8d5e9; }

@media (max-height:740px) {
  .bottom-sheet-panel { max-height:94vh; padding:18rpx 40rpx calc(16rpx + env(safe-area-inset-bottom)); }
  .bottom-sheet-grabber { margin-bottom:20rpx; }
}
