page {
  --page-bg: #f7f8ff;
  --card-bg: rgba(255, 255, 255, 0.96);
  --text-primary: #11172d;
  --text-secondary: #737b94;
  --text-tertiary: #a0a6b8;
  --brand: #6552f5;
  --brand-deep: #5040dd;
  --brand-soft: #efedff;
  --brand-glow: rgba(101, 82, 245, 0.18);
  --warm: #ff7a59;
  --warm-soft: #fff0ea;
  --success: #4fba73;
  --danger: #d85b63;
  --line: #e9ebf4;
  --shadow: 0 18rpx 60rpx rgba(51, 58, 94, 0.08);
  min-height: 100%;
  background:
    radial-gradient(circle at 8% 4%, rgba(131, 167, 255, 0.10), transparent 28%),
    radial-gradient(circle at 92% 8%, rgba(168, 132, 255, 0.10), transparent 30%),
    var(--page-bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
image,
scroll-view,
video,
slider {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 0;
  background: transparent;
  font-size: inherit;
}

button::after {
  border: none;
}

.screen {
  min-height: 100vh;
  padding: 0 36rpx calc(48rpx + env(safe-area-inset-bottom));
}

.content-safe {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 48rpx;
  line-height: 1.22;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--text-primary);
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.section-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 650;
  color: var(--text-primary);
}

.section-caption {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.glass-card {
  background: var(--card-bg);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
}

.soft-card {
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: 0 12rpx 38rpx rgba(48, 54, 88, 0.06);
}

.primary-button,
.secondary-button,
.danger-button,
.ghost-button {
  width: 100%;
  min-height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: 0.5rpx;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, #5f52f5 0%, #8d68f6 100%);
  box-shadow: 0 18rpx 36rpx rgba(101, 82, 245, 0.24);
}

.primary-button.button-disabled,
.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: linear-gradient(135deg, #bcb7e7 0%, #c8c2eb 100%);
  box-shadow: none;
}

.secondary-button {
  color: var(--text-primary);
  background: #ffffff;
  border: 1rpx solid var(--line);
}

.ghost-button {
  color: var(--brand);
  background: var(--brand-soft);
}

.danger-button {
  color: #ffffff;
  background: linear-gradient(135deg, #dc6870, #c9515b);
}

.text-button {
  color: var(--brand);
  font-size: 27rpx;
  line-height: 1.4;
  padding: 18rpx 12rpx;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.field-input,
.field-textarea {
  width: 100%;
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.96);
  color: var(--text-primary);
  font-size: 29rpx;
  box-shadow: 0 10rpx 28rpx rgba(48, 54, 88, 0.04);
}

.field-input {
  height: 96rpx;
  padding: 0 28rpx;
}

.field-textarea {
  min-height: 250rpx;
  padding: 26rpx 28rpx;
  line-height: 1.65;
}

.muted {
  color: var(--text-secondary);
}

.success-text {
  color: var(--success);
}

.danger-text {
  color: var(--danger);
}

.divider {
  height: 1rpx;
  background: var(--line);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.fade-in {
  animation: fade-in 240ms ease-out both;
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
